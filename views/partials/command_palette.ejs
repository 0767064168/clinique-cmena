<!-- Palette de Commande Rapide (Recherche Globale Ctrl+K) -->
<div x-data="cmenaCommandPalette()"
     x-init="init()"
     @open-global-search.window="openPalette()"
     @keydown.window="handleGlobalKey($event)"
     x-cloak>

    <!-- Overlay Backdrop -->
    <div x-show="open" 
         x-transition:enter="transition-opacity ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition-opacity ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-[70] bg-slate-900/60 backdrop-blur-sm"
         @click="closePalette()"
         aria-hidden="true">
    </div>

    <!-- Modale Command Palette -->
    <div x-show="open"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0 scale-95 -translate-y-4"
         x-transition:enter-end="opacity-100 scale-100 translate-y-0"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100 scale-100 translate-y-0"
         x-transition:leave-end="opacity-0 scale-95 -translate-y-4"
         class="fixed inset-x-4 top-14 sm:top-20 z-[75] max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl ring-1 ring-slate-900/10 overflow-hidden flex flex-col max-h-[80vh]"
         @keydown.escape.prevent.stop="closePalette()"
         @keydown.arrow-down.prevent.stop="navigate(1)"
         @keydown.arrow-up.prevent.stop="navigate(-1)"
         @keydown.enter.prevent.stop="selectCurrent()">

        <!-- Barre de saisie principale -->
        <div class="relative flex items-center border-b border-gray-100 px-4 py-3.5 bg-slate-50/50">
            <span class="text-gray-400 mr-3 text-base">
                <template x-if="!loading">
                    <i class="fas fa-search"></i>
                </template>
                <template x-if="loading">
                    <i class="fas fa-circle-notch fa-spin text-primary"></i>
                </template>
            </span>

            <input x-ref="searchInput"
                   type="text"
                   x-model="query"
                   @input.debounce.200ms="fetchResults()"
                   placeholder="Rechercher un patient, dossier, médicament, facture, rdv ou taper une action..."
                   class="w-full bg-transparent border-0 text-sm sm:text-base text-gray-900 placeholder:text-gray-400 focus:ring-0 focus:outline-none p-0"
                   autocomplete="off"
                   spellcheck="false">

            <div class="flex items-center gap-1.5 ml-2">
                <template x-if="query">
                    <button type="button" @click="query = ''; fetchResults(); $refs.searchInput.focus();" 
                            class="p-1 text-gray-400 hover:text-gray-600 rounded-md">
                        <i class="fas fa-times text-xs"></i>
                    </button>
                </template>
                <kbd class="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-gray-200/80 text-gray-600">
                    ESC
                </kbd>
            </div>
        </div>

        <!-- Filtres par catégorie -->
        <div class="flex items-center gap-1 px-4 py-2 bg-white border-b border-gray-100 text-[11px] font-semibold text-gray-600 overflow-x-auto shrink-0">
            <button type="button" @click="activeFilter = 'all'; selectedIndex = 0;"
                    :class="activeFilter === 'all' ? 'bg-slate-900 text-white shadow-sm' : 'hover:bg-gray-100 text-gray-700'"
                    class="px-2.5 py-1 rounded-lg transition whitespace-nowrap">
                Tous (<span x-text="totalCount"></span>)
            </button>
            <template x-if="results.patients && results.patients.length > 0">
                <button type="button" @click="activeFilter = 'patients'; selectedIndex = 0;"
                        :class="activeFilter === 'patients' ? 'bg-blue-600 text-white' : 'hover:bg-blue-50 text-blue-700'"
                        class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                    <i class="fas fa-user text-[10px]"></i> Patients (<span x-text="results.patients.length"></span>)
                </button>
            </template>
            <template x-if="results.rendezVous && results.rendezVous.length > 0">
                <button type="button" @click="activeFilter = 'rendezVous'; selectedIndex = 0;"
                        :class="activeFilter === 'rendezVous' ? 'bg-indigo-600 text-white' : 'hover:bg-indigo-50 text-indigo-700'"
                        class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                    <i class="fas fa-calendar-alt text-[10px]"></i> RDV (<span x-text="results.rendezVous.length"></span>)
                </button>
            </template>
            <template x-if="results.pharmacie && results.pharmacie.length > 0">
                <button type="button" @click="activeFilter = 'pharmacie'; selectedIndex = 0;"
                        :class="activeFilter === 'pharmacie' ? 'bg-emerald-600 text-white' : 'hover:bg-emerald-50 text-emerald-700'"
                        class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                    <i class="fas fa-pills text-[10px]"></i> Pharmacie (<span x-text="results.pharmacie.length"></span>)
                </button>
            </template>
            <template x-if="results.factures && results.factures.length > 0">
                <button type="button" @click="activeFilter = 'factures'; selectedIndex = 0;"
                        :class="activeFilter === 'factures' ? 'bg-amber-600 text-white' : 'hover:bg-amber-50 text-amber-700'"
                        class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                    <i class="fas fa-file-invoice text-[10px]"></i> Factures (<span x-text="results.factures.length"></span>)
                </button>
            </template>
            <template x-if="results.actions && results.actions.length > 0">
                <button type="button" @click="activeFilter = 'actions'; selectedIndex = 0;"
                        :class="activeFilter === 'actions' ? 'bg-purple-600 text-white' : 'hover:bg-purple-50 text-purple-700'"
                        class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                    <i class="fas fa-bolt text-[10px]"></i> Actions (<span x-text="results.actions.length"></span>)
                </button>
            </template>
        </div>

        <!-- Liste des Résultats Déroulante -->
        <div class="flex-1 overflow-y-auto p-2 space-y-1 divide-y divide-gray-50 text-xs sm:text-sm">
            
            <!-- État vide -->
            <template x-if="!loading && getFilteredItems().length === 0">
                <div class="py-10 text-center text-gray-400">
                    <i class="fas fa-search text-3xl mb-2 text-gray-300 block"></i>
                    <p class="font-medium text-gray-600">Aucun résultat trouvé pour « <span x-text="query"></span> »</p>
                    <p class="text-xs text-gray-400 mt-1">Essayez un nom de patient, un numéro de dossier, un produit ou un mot-clé d'action.</p>
                </div>
            </template>

            <!-- Éléments affichés -->
            <template x-for="(item, idx) in getFilteredItems()" :key="item.key || (item.url + idx)">
                <a :href="item.url" 
                   @mouseenter="selectedIndex = idx"
                   :class="selectedIndex === idx ? 'bg-primary/10 border-primary text-gray-900 font-semibold' : 'hover:bg-gray-50 text-gray-700 border-transparent'"
                   class="group flex items-center justify-between p-2.5 rounded-xl border transition cursor-pointer">
                    
                    <div class="flex items-center gap-3 min-w-0">
                        <span :class="item.iconBg || 'bg-gray-100 text-gray-600'" 
                              class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 text-sm">
                            <i :class="item.icon || 'fas fa-arrow-right'"></i>
                        </span>

                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-bold truncate" :class="selectedIndex === idx ? 'text-primary' : 'text-gray-900'" x-text="item.title"></span>
                                <template x-if="item.badge">
                                    <span :class="item.badgeColorClass || 'bg-gray-100 text-gray-600'" 
                                          class="text-[10px] font-bold px-1.5 py-0.2 rounded uppercase tracking-wider" 
                                          x-text="item.badge"></span>
                                </template>
                            </div>
                            <p class="text-[11px] text-gray-500 truncate" x-text="item.subtitle || item.desc"></p>
                        </div>
                    </div>

                    <div class="flex items-center gap-1 text-gray-400 shrink-0 ml-2">
                        <span class="text-[10px] uppercase tracking-wider font-semibold opacity-0 group-hover:opacity-100 transition hidden sm:inline"
                              :class="selectedIndex === idx ? 'text-primary opacity-100' : ''">
                            Ouvrir
                        </span>
                        <i class="fas fa-chevron-right text-xs" :class="selectedIndex === idx ? 'text-primary' : ''"></i>
                    </div>
                </a>
            </template>
        </div>

        <!-- Pied de page avec indications clavier -->
        <div class="bg-gray-50 px-4 py-2.5 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-500 font-medium">
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1">
                    <kbd class="px-1.5 py-0.5 rounded bg-white border border-gray-300 font-mono text-[9px] shadow-xs">↑</kbd>
                    <kbd class="px-1.5 py-0.5 rounded bg-white border border-gray-300 font-mono text-[9px] shadow-xs">↓</kbd>
                    Naviguer
                </span>
                <span class="flex items-center gap-1">
                    <kbd class="px-1.5 py-0.5 rounded bg-white border border-gray-300 font-mono text-[9px] shadow-xs">↵ Entrée</kbd>
                    Sélectionner
                </span>
                <span class="flex items-center gap-1">
                    <kbd class="px-1.5 py-0.5 rounded bg-white border border-gray-300 font-mono text-[9px] shadow-xs">Échap</kbd>
                    Fermer
                </span>
            </div>
            <div class="text-[10px] text-gray-400">
                CSA 3e Cie GSPM
            </div>
        </div>
    </div>
</div>

<script>
function cmenaCommandPalette() {
    return {
        open: false,
        query: '',
        loading: false,
        selectedIndex: 0,
        activeFilter: 'all',
        results: {
            actions: [],
            patients: [],
            rendezVous: [],
            pharmacie: [],
            factures: [],
            consultations: [],
            praticiens: []
        },
        totalCount: 0,

        init() {
            // Écouter les raccourcis globaux
            window.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
                    e.preventDefault();
                    if (this.open) {
                        this.closePalette();
                    } else {
                        this.openPalette();
                    }
                }
            });
        },

        handleGlobalKey(e) {
            // Optionnel
        },

        openPalette() {
            this.open = true;
            this.selectedIndex = 0;
            if (!this.query) {
                this.fetchResults();
            }
            this.$nextTick(() => {
                if (this.$refs.searchInput) {
                    this.$refs.searchInput.focus();
                    this.$refs.searchInput.select();
                }
            });
        },

        closePalette() {
            this.open = false;
        },

        async fetchResults() {
            this.loading = true;
            try {
                const res = await fetch('/api/recherche-globale?q=' + encodeURIComponent(this.query));
                if (!res.ok) throw new Error('Erreur HTTP ' + res.status);
                const data = await res.json();
                this.results = data.results || {};
                this.totalCount = data.totalCount || 0;
                this.selectedIndex = 0;
            } catch (err) {
                console.error('Erreur chargement recherche palette:', err);
            } finally {
                this.loading = false;
            }
        },

        getFilteredItems() {
            let items = [];

            const formatActions = (acts) => (acts || []).map(a => ({
                ...a,
                title: a.label,
                subtitle: a.desc,
                iconBg: 'bg-purple-100 text-purple-700',
                badge: 'Action',
                badgeColorClass: 'bg-purple-100 text-purple-800'
            }));

            const formatPatients = (pts) => (pts || []).map(p => ({
                ...p,
                iconBg: 'bg-blue-100 text-blue-700',
                badgeColorClass: p.badgeColor === 'pink' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700'
            }));

            const formatRdv = (rdvs) => (rdvs || []).map(r => ({
                ...r,
                iconBg: 'bg-indigo-100 text-indigo-700',
                badgeColorClass: r.badgeColor === 'green' ? 'bg-emerald-100 text-emerald-800' : (r.badgeColor === 'amber' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800')
            }));

            const formatPharm = (pharms) => (pharms || []).map(p => ({
                ...p,
                iconBg: 'bg-emerald-100 text-emerald-700',
                badgeColorClass: p.badgeColor === 'red' ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-800'
            }));

            const formatFacts = (facts) => (facts || []).map(f => ({
                ...f,
                iconBg: 'bg-amber-100 text-amber-700',
                badgeColorClass: f.badgeColor === 'green' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
            }));

            const formatConsults = (cons) => (cons || []).map(c => ({
                ...c,
                iconBg: 'bg-teal-100 text-teal-700',
                badgeColorClass: 'bg-teal-100 text-teal-800'
            }));

            const formatPrats = (prats) => (prats || []).map(pr => ({
                ...pr,
                iconBg: 'bg-cyan-100 text-cyan-700',
                badgeColorClass: 'bg-cyan-100 text-cyan-800'
            }));

            if (this.activeFilter === 'patients') return formatPatients(this.results.patients);
            if (this.activeFilter === 'rendezVous') return formatRdv(this.results.rendezVous);
            if (this.activeFilter === 'pharmacie') return formatPharm(this.results.pharmacie);
            if (this.activeFilter === 'factures') return formatFacts(this.results.factures);
            if (this.activeFilter === 'actions') return formatActions(this.results.actions);

            // 'all'
            return [
                ...formatActions(this.results.actions),
                ...formatPatients(this.results.patients),
                ...formatRdv(this.results.rendezVous),
                ...formatPharm(this.results.pharmacie),
                ...formatFacts(this.results.factures),
                ...formatConsults(this.results.consultations),
                ...formatPrats(this.results.praticiens)
            ];
        },

        navigate(delta) {
            const items = this.getFilteredItems();
            if (items.length === 0) return;
            this.selectedIndex = (this.selectedIndex + delta + items.length) % items.length;
        },

        selectCurrent() {
            const items = this.getFilteredItems();
            if (items.length > 0 && items[this.selectedIndex]) {
                const targetUrl = items[this.selectedIndex].url;
                if (targetUrl) {
                    window.location.href = targetUrl;
                }
            }
        }
    };
}
</script>
