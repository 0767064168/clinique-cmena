<!-- Mobile sidebar backdrop -->
<div x-show="sidebarOpen" x-cloak 
     class="fixed inset-0 z-40 bg-gray-600 bg-opacity-75 md:hidden"
     @click="sidebarOpen = false"
     aria-hidden="true"
     x-transition:enter="transition-opacity ease-linear duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-transition:leave="transition-opacity ease-linear duration-300"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0">
</div>

<!-- Sidebar -->
<div id="primary-navigation"
     x-show="isDesktop || sidebarOpen"
     :aria-hidden="(!isDesktop && !sidebarOpen).toString()"
     :inert="!isDesktop && !sidebarOpen"
     :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'"
     class="fixed inset-y-0 left-0 z-50 w-64 bg-primary-dark text-white transition-transform duration-300 ease-in-out md:translate-x-0 flex flex-col shadow-2xl md:shadow-none">
    
    <!-- Sidebar Header -->
    <div class="flex h-16 shrink-0 items-center justify-between px-6 bg-primary">
        <div class="flex items-center space-x-3">
            <img src="/images/logo_gspm.jpg" alt="Logo GSPM" class="h-10 w-10 object-contain rounded bg-white p-0.5 shadow-sm">
            <div>
                <h1 class="text-base font-bold tracking-wider leading-tight">CSA GSPM</h1>
                <p class="text-[0.65rem] uppercase text-blue-200 tracking-wide">3e Cie - Bouaké</p>
            </div>
        </div>
        <!-- Close button for mobile -->
        <button type="button" @click="sidebarOpen = false; $nextTick(() => $refs.mobileMenuTrigger.focus())" aria-label="Fermer la navigation" class="md:hidden text-gray-300 hover:text-white">
            <i class="fas fa-times text-xl" aria-hidden="true"></i>
        </button>
    </div>

    <!-- Navigation -->
    <nav aria-label="Navigation principale" class="flex flex-1 flex-col overflow-y-auto px-4 py-4 mt-2">
        <% 
            const userRole = (typeof user !== 'undefined' && user) ? user.role : 'receptionniste'; 
            const navItems = [
                { label: 'Tableau de bord', href: '/', icon: 'fas fa-chart-pie', allowed: ['admin', 'medecin', 'receptionniste', 'comptable', 'pharmacien'], exact: true },
                { label: 'Patients', href: '/patients', icon: 'fas fa-users', allowed: ['admin', 'medecin', 'receptionniste'] },
                { label: 'Praticiens', href: '/praticiens', icon: 'fas fa-user-md', allowed: ['admin', 'medecin', 'receptionniste'] },
                { label: 'Consultations', href: '/consultations', icon: 'fas fa-stethoscope', allowed: ['admin', 'medecin', 'receptionniste'], exact: true },
                { label: 'Salle d\'Attente', href: '/consultations/attente', icon: 'fas fa-hourglass-half', accent: 'amber', allowed: ['admin', 'medecin', 'receptionniste'], exact: true },
                { label: 'Factures', href: '/factures', icon: 'fas fa-file-invoice', allowed: ['admin', 'comptable'] },
                { label: 'Actes Médicaux', href: '/actes', icon: 'fas fa-file-medical-alt', allowed: ['admin', 'medecin', 'comptable'] },
                { label: 'Pharmacie & Stock', href: '/pharmacie', icon: 'fas fa-pills', accent: 'emerald', allowed: ['admin', 'pharmacien', 'medecin'] },
                { label: 'Assurances', href: '/assurances', icon: 'fas fa-building', allowed: ['admin', 'comptable'] },
                { label: 'Paiements', href: '/paiements', icon: 'fas fa-money-bill-wave', allowed: ['admin', 'comptable'] },
                { label: 'Caisse du Jour', href: '/caisse', icon: 'fas fa-cash-register', accent: 'green', allowed: ['admin', 'comptable'] },
                { label: 'Rapports', href: '/rapports', icon: 'fas fa-chart-line', allowed: ['admin', 'medecin', 'comptable'] },
                { label: 'Journal d\'Audit', href: '/audit', icon: 'fas fa-history', accent: 'red', allowed: ['admin'] },
                { label: 'Utilisateurs', href: '/utilisateurs', icon: 'fas fa-user-shield', accent: 'red', allowed: ['admin'] },
                { label: 'Paramètres', href: '/settings', icon: 'fas fa-cog', accent: 'red', allowed: ['admin'] }
            ];
        %>
        <ul role="list" class="flex flex-1 flex-col gap-y-1.5">
            <% navItems.forEach(item => { 
                const isAllowed = item.allowed.includes(userRole);
                const isActive = isAllowed && (typeof currentPath !== 'undefined' && (item.exact ? currentPath === item.href : currentPath.startsWith(item.href)));
                const borderAccent = item.accent === 'amber' ? 'border-amber-400' : 
                                    (item.accent === 'emerald' ? 'border-emerald-400' : 
                                    (item.accent === 'green' ? 'border-green-400' : 
                                    (item.accent === 'red' ? 'border-red-500' : 'border-blue-400')));
            %>
            <li>
                <% if (isAllowed) { %>
                    <a href="<%= item.href %>" 
                       class="group flex items-center gap-x-3 rounded-md p-2 text-sm font-semibold leading-6 transition <%= isActive ? 'bg-primary text-white border-l-4 ' + borderAccent : 'text-gray-300 hover:bg-primary-light hover:text-white' %>">
                        <i class="<%= item.icon %> w-6 text-center text-lg <%= isActive ? 'text-white' : 'text-gray-400 group-hover:text-white' %>"></i>
                        <span class="truncate"><%= item.label %></span>
                    </a>
                <% } else { %>
                    <div title="Accès restreint (non autorisé pour votre profil <%= userRole %>)" 
                         class="group flex items-center gap-x-3 rounded-md p-2 text-sm font-medium leading-6 text-gray-500 opacity-40 bg-black/20 cursor-not-allowed select-none border-l-4 border-transparent">
                        <i class="<%= item.icon %> w-6 text-center text-lg text-gray-500"></i>
                        <span class="truncate text-gray-400"><%= item.label %></span>
                        <i class="fas fa-lock text-[10px] ml-auto text-gray-500" aria-hidden="true"></i>
                    </div>
                <% } %>
            </li>
            <% }); %>
        </ul>
    </nav>
    
    <!-- Profil connecté & Déconnexion -->
    <div class="bg-black bg-opacity-25 mt-auto border-t border-white/10">
        <% if (typeof user !== 'undefined' && user) { %>
        <div class="px-4 py-3 flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white text-xs uppercase shadow shrink-0">
                <%= (user.prenom ? user.prenom[0] : '') + (user.nom ? user.nom[0] : '') %>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-xs font-bold text-white truncate"><%= user.prenom %> <%= user.nom %></p>
                <% 
                    const roleBadges = {
                        'admin': { label: 'Administrateur', class: 'bg-red-500/20 text-red-300 border-red-500/40' },
                        'medecin': { label: 'Médecin', class: 'bg-blue-500/20 text-blue-300 border-blue-500/40' },
                        'receptionniste': { label: 'Réceptionniste', class: 'bg-amber-500/20 text-amber-300 border-amber-500/40' },
                        'comptable': { label: 'Comptable', class: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' },
                        'pharmacien': { label: 'Pharmacien', class: 'bg-teal-500/20 text-teal-300 border-teal-500/40' }
                    };
                    const badge = roleBadges[user.role] || { label: user.role, class: 'bg-gray-500/20 text-gray-300 border-gray-500/40' };
                %>
                <span class="inline-block px-1.5 py-0.5 text-[9px] font-semibold border rounded-full <%= badge.class %>">
                    <%= badge.label %>
                </span>
            </div>
        </div>
        <% } %>
        <div class="px-3 pb-3">
            <a href="/logout" class="group flex items-center gap-x-2 rounded-md p-2 text-xs font-semibold text-gray-300 hover:bg-red-600 hover:text-white transition-colors">
                <i class="fas fa-sign-out-alt w-5 text-center text-sm text-gray-400 group-hover:text-white"></i>
                Déconnexion
            </a>
        </div>
    </div>
</div>
