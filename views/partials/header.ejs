<div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-gray-200 bg-white px-4 shadow-sm sm:gap-x-6 sm:px-6 lg:px-8">
    <!-- Mobile menu button -->
    <button type="button" @click="sidebarOpen = true" aria-controls="primary-navigation" :aria-expanded="sidebarOpen.toString()" x-ref="mobileMenuTrigger" class="-m-2.5 p-2.5 text-gray-700 md:hidden hover:text-primary">
        <span class="sr-only">Ouvrir la navigation</span>
        <i class="fas fa-bars text-xl"></i>
    </button>

    <!-- Separator -->
    <div class="h-6 w-px bg-gray-200 md:hidden" aria-hidden="true"></div>

    <div class="flex flex-1 gap-x-2 sm:gap-x-4 self-stretch items-center justify-between">
        <div class="relative flex flex-1 items-center max-w-xs sm:max-w-md">
            <div class="w-full">
                <form action="/patients" method="GET" class="relative">
                    <label for="header-search" class="sr-only">Rechercher</label>
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                        <i class="fas fa-search text-gray-400 text-xs sm:text-sm"></i>
                    </div>
                    <input id="header-search" name="search" 
                        class="block w-full rounded-md border-0 bg-white py-1.5 pl-8 sm:pl-10 pr-2 sm:pr-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 text-xs sm:text-sm" 
                        placeholder="Recherche patient..." 
                        type="search">
                </form>
            </div>
            <h1 class="ml-4 text-lg font-semibold leading-6 text-gray-900 hidden lg:block truncate">
                <%- typeof pageTitle !== 'undefined' ? pageTitle : '' %>
            </h1>
        </div>
        <div class="flex items-center gap-x-4 lg:gap-x-6">
            <!-- Notifications Menu Dynamique Multi-Modules (Santé, Caisse, Pharmacie) -->
            <% 
                const sysNotifs = (typeof systemNotifications !== 'undefined' && systemNotifications) 
                    ? systemNotifications 
                    : { totalCount: 0, criticalCount: 0, warningCount: 0, items: [], summary: { pharmacie: 0, attente: 0, facturation: 0 } };
                const initialItems = sysNotifs.items || [];
            %>
            <div class="relative" 
                 x-data="window.cmenaNotificationCenter ? window.cmenaNotificationCenter(<%- JSON.stringify(initialItems) %>) : { notifOpen: false, visibleItems: [], filteredItems: [], unreadCount: 0, hasCritical: false }" 
                 @keydown.escape="notifOpen = false">

                <!-- Bouton Cloche avec indicateur visuel dynamique -->
                <button type="button" @click="notifOpen = !notifOpen" @click.away="notifOpen = false"
                        class="-m-2.5 p-2.5 text-gray-500 hover:text-gray-700 relative focus:outline-none transition"
                        aria-label="Voir les alertes et notifications">
                    <i class="far fa-bell text-xl"></i>
                    <template x-if="unreadCount > 0">
                        <span class="absolute top-1.5 right-1.5 flex h-4 w-4 items-center justify-center rounded-full text-[9px] font-black text-white"
                              :class="hasCritical ? 'bg-red-600 animate-pulse ring-2 ring-white' : 'bg-amber-500 ring-2 ring-white'"
                              x-text="unreadCount > 9 ? '9+' : unreadCount">
                        </span>
                    </template>
                </button>

                <!-- Volet Dropdown du Centre de Notifications -->
                <div x-show="notifOpen" x-cloak
                     x-transition:enter="transition ease-out duration-150"
                     x-transition:enter-start="transform opacity-0 scale-95 translate-y-1"
                     x-transition:enter-end="transform opacity-100 scale-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-100"
                     class="absolute right-0 z-50 mt-2.5 w-80 sm:w-[420px] origin-top-right rounded-2xl bg-white shadow-2xl ring-1 ring-slate-900/10 overflow-hidden divide-y divide-gray-100">
                    
                    <!-- En-tête de la boîte -->
                    <div class="px-4 py-3 bg-slate-900 text-white flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="p-1.5 rounded-lg bg-white/10 text-emerald-400">
                                <i class="fas fa-bell"></i>
                            </span>
                            <div>
                                <h3 class="text-xs font-black uppercase tracking-wider text-slate-100">Centre d'Alertes</h3>
                                <p class="text-[10px] text-slate-400">Surveillance médicale & administrative</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <template x-if="unreadCount > 0">
                                <button type="button" @click="dismissAll()" 
                                        class="text-[10px] font-bold text-slate-300 hover:text-white hover:underline transition"
                                        title="Masquer toutes les alertes de cette session">
                                    Tout marquer lu
                                </button>
                            </template>
                            <template x-if="dismissedIds.length > 0 && unreadCount === 0">
                                <button type="button" @click="resetDismissed()" 
                                        class="text-[10px] text-emerald-400 hover:text-emerald-300 hover:underline">
                                    Réafficher
                                </button>
                            </template>
                        </div>
                    </div>

                    <!-- Onglets de filtrage par module -->
                    <div class="flex items-center gap-1 p-1.5 bg-slate-50 border-b border-gray-100 text-[11px] font-semibold text-gray-600 overflow-x-auto">
                        <button type="button" @click="activeTab = 'all'"
                                :class="activeTab === 'all' ? 'bg-white text-slate-900 shadow-sm font-bold' : 'hover:text-slate-900'"
                                class="px-2.5 py-1 rounded-lg transition whitespace-nowrap">
                            Toutes (<span x-text="visibleItems.length"></span>)
                        </button>
                        <button type="button" @click="activeTab = 'attente'"
                                :class="activeTab === 'attente' ? 'bg-white text-purple-800 shadow-sm font-bold' : 'hover:text-purple-700'"
                                class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                            <i class="fas fa-hospital-user text-purple-600"></i> Attente
                        </button>
                        <button type="button" @click="activeTab = 'pharmacie'"
                                :class="activeTab === 'pharmacie' ? 'bg-white text-emerald-800 shadow-sm font-bold' : 'hover:text-emerald-700'"
                                class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                            <i class="fas fa-pills text-emerald-600"></i> Pharmacie
                        </button>
                        <button type="button" @click="activeTab = 'facturation'"
                                :class="activeTab === 'facturation' ? 'bg-white text-blue-800 shadow-sm font-bold' : 'hover:text-blue-700'"
                                class="px-2 py-1 rounded-lg transition whitespace-nowrap flex items-center gap-1">
                            <i class="fas fa-coins text-blue-600"></i> Caisse
                        </button>
                    </div>

                    <!-- Liste déroulante des alertes -->
                    <div class="max-h-80 overflow-y-auto divide-y divide-gray-100">
                        <template x-for="item in filteredItems" :key="item.id">
                            <div class="p-3 transition hover:bg-slate-50 relative group" :class="item.bgColor">
                                <div class="flex items-start gap-2.5">
                                    <div class="p-2 rounded-lg bg-white shadow-xs shrink-0" :class="item.iconColor">
                                        <i :class="item.icon" class="text-sm"></i>
                                    </div>
                                    <div class="flex-1 min-w-0 pr-6">
                                        <div class="flex items-center gap-1.5 mb-0.5">
                                            <span class="text-[10px] font-black px-1.5 py-0.2 rounded" :class="item.badgeColor" x-text="item.badgeText"></span>
                                            <h4 class="text-xs font-bold text-gray-900 truncate" x-text="item.title"></h4>
                                        </div>
                                        <p class="text-[11px] text-gray-600 leading-relaxed mb-2" x-text="item.description"></p>
                                        
                                        <!-- Actions Rapides (1-Clic) -->
                                        <div class="flex items-center gap-2">
                                            <a :href="item.actionUrl" 
                                               class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-bold shadow-xs transition">
                                                <span x-text="item.actionLabel"></span>
                                                <i class="fas fa-arrow-right text-[9px]"></i>
                                            </a>
                                            <button type="button" @click="dismiss(item.id)"
                                                    class="text-[10px] text-gray-400 hover:text-gray-700 underline transition">
                                                Masquer
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Bouton rapide de fermeture individuelle -->
                                    <button type="button" @click="dismiss(item.id)" 
                                            class="absolute top-2 right-2 p-1 text-gray-400 hover:text-gray-600 opacity-60 hover:opacity-100 rounded" 
                                            title="Marquer comme lu">
                                        <i class="fas fa-times text-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </template>

                        <!-- État vide : Aucune alerte -->
                        <div x-show="filteredItems.length === 0" class="p-6 text-center text-gray-500">
                            <i class="fas fa-shield-alt text-emerald-500 text-3xl mb-2 block"></i>
                            <p class="text-xs font-bold text-gray-800">Situation normale</p>
                            <p class="text-[11px] text-gray-400 mt-0.5">Aucune alerte active dans cette catégorie.</p>
                        </div>
                    </div>

                    <!-- Pied de page avec raccourcis directs -->
                    <div class="p-2.5 bg-gray-50 flex items-center justify-between text-[11px] font-bold">
                        <a href="/consultations/attente" class="text-purple-700 hover:underline inline-flex items-center gap-1">
                            <i class="fas fa-user-clock text-xs"></i> Salle d'attente
                        </a>
                        <span class="text-gray-300">|</span>
                        <a href="/pharmacie" class="text-emerald-700 hover:underline inline-flex items-center gap-1">
                            <i class="fas fa-boxes text-xs"></i> Stocks
                        </a>
                        <span class="text-gray-300">|</span>
                        <a href="/caisse" class="text-blue-700 hover:underline inline-flex items-center gap-1">
                            <i class="fas fa-cash-register text-xs"></i> Caisse
                        </a>
                    </div>
                </div>
            </div>

            <!-- Separator -->
            <div class="hidden lg:block lg:h-6 lg:w-px lg:bg-gray-200" aria-hidden="true"></div>

            <!-- Profile dropdown -->
            <div class="relative" x-data="{ open: false }" @keydown.escape="open = false; $refs.userMenuTrigger.focus()">
                <button type="button" @click="open = !open" @click.away="open = false" class="-m-1.5 flex items-center p-1.5" id="user-menu-button" x-ref="userMenuTrigger" :aria-expanded="open.toString()" aria-controls="user-menu">
                    <span class="sr-only">Ouvrir le menu utilisateur</span>
                    <div class="h-8 w-8 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                        <%= (typeof user !== 'undefined' && user && (user.nom || user.email)) ? (user.nom || user.email).charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <span class="hidden lg:flex lg:items-center">
                        <span class="ml-4 text-sm font-semibold leading-6 text-gray-900" aria-hidden="true">
                            <%= (typeof user !== 'undefined' && user && (user.nom || user.email)) ? (user.nom || user.email.split('@')[0]) : 'Admin' %>
                        </span>
                        <i class="fas fa-chevron-down ml-2 text-xs text-gray-400"></i>
                    </span>
                </button>

                <!-- Dropdown menu -->
                <div x-show="open" x-cloak
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     id="user-menu" class="absolute right-0 z-10 mt-2.5 w-40 origin-top-right rounded-md bg-white py-2 shadow-lg ring-1 ring-gray-900/5 focus:outline-none" aria-labelledby="user-menu-button">
                    <a href="/profile" class="block px-3 py-2 text-sm leading-6 text-gray-900 hover:bg-gray-50">Profil</a>
                    <a href="/settings" class="block px-3 py-2 text-sm leading-6 text-gray-900 hover:bg-gray-50">Paramètres</a>
                    <a href="/logout" class="block px-3 py-2 text-sm leading-6 text-red-600 hover:bg-gray-50">Déconnexion</a>
                </div>
            </div>
        </div>
    </div>
</div>
