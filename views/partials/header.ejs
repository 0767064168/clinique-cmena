<div class="sticky top-0 z-40 flex h-16 shrink-0 items-center gap-x-4 border-b border-gray-200 bg-white px-4 shadow-sm sm:gap-x-6 sm:px-6 lg:px-8">
    <!-- Mobile menu button -->
    <button type="button" @click="sidebarOpen = true" aria-controls="primary-navigation" :aria-expanded="sidebarOpen.toString()" x-ref="mobileMenuTrigger" class="-m-2.5 p-2.5 text-gray-700 md:hidden hover:text-primary">
        <span class="sr-only">Ouvrir la navigation</span>
        <i class="fas fa-bars text-xl"></i>
    </button>

    <!-- Separator -->
    <div class="h-6 w-px bg-gray-200 md:hidden" aria-hidden="true"></div>

    <div class="flex flex-1 gap-x-2 sm:gap-x-4 self-stretch items-center justify-between">
        <div class="relative flex flex-1 items-center max-w-xs sm:max-w-md">
            <div class="w-full">
                <form action="/patients" method="GET" class="relative">
                    <label for="header-search" class="sr-only">Rechercher</label>
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                        <i class="fas fa-search text-gray-400 text-xs sm:text-sm"></i>
                    </div>
                    <input id="header-search" name="search" 
                        class="block w-full rounded-md border-0 bg-white py-1.5 pl-8 sm:pl-10 pr-2 sm:pr-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-red-600 text-xs sm:text-sm" 
                        placeholder="Recherche patient..." 
                        type="search">
                </form>
            </div>
            <h1 class="ml-4 text-lg font-semibold leading-6 text-gray-900 hidden lg:block truncate">
                <%- typeof pageTitle !== 'undefined' ? pageTitle : '' %>
            </h1>
        </div>
        <div class="flex items-center gap-x-4 lg:gap-x-6">
            <!-- Notifications Menu Dynamique -->
            <% 
                const pAlerts = (typeof pharmacieAlerts !== 'undefined' && pharmacieAlerts) ? pharmacieAlerts : { totalAlertes: 0, enAlerte: 0, enRupture: 0, perimes: 0, expire30j: 0 };
                const hasAlerts = pAlerts.totalAlertes > 0;
            %>
            <div class="relative" x-data="{ notifOpen: false }" @keydown.escape="notifOpen = false">
                <button type="button" @click="notifOpen = !notifOpen" @click.away="notifOpen = false"
                        class="-m-2.5 p-2.5 text-gray-500 hover:text-gray-700 relative focus:outline-none"
                        aria-label="Voir les alertes et notifications">
                    <i class="far fa-bell text-xl"></i>
                    <% if (hasAlerts) { %>
                        <span class="absolute top-2 right-2 block h-2.5 w-2.5 rounded-full bg-red-600 ring-2 ring-white animate-pulse"></span>
                    <% } %>
                </button>

                <!-- Dropdown des alertes -->
                <div x-show="notifOpen" x-cloak
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     class="absolute right-0 z-50 mt-2.5 w-80 sm:w-96 origin-top-right rounded-xl bg-white p-3 shadow-2xl ring-1 ring-black/5 divide-y divide-gray-100">
                    <div class="flex items-center justify-between pb-2">
                        <span class="text-xs font-bold text-gray-800 uppercase tracking-wide flex items-center gap-1.5">
                            <i class="fas fa-bell text-blue-600"></i> Centre de Notifications
                        </span>
                        <% if (hasAlerts) { %>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-red-100 text-red-700">
                                <%= pAlerts.totalAlertes %> alerte<%= pAlerts.totalAlertes > 1 ? 's' : '' %>
                            </span>
                        <% } %>
                    </div>

                    <div class="py-2 space-y-2 text-xs">
                        <% if (pAlerts.enRupture > 0) { %>
                            <div class="flex items-center justify-between p-2 rounded-lg bg-red-50 text-red-800 border border-red-100">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-times-circle text-red-600"></i>
                                    <span><strong><%= pAlerts.enRupture %></strong> produit(s) en rupture totale</span>
                                </div>
                                <a href="/pharmacie?stock_alert=oui" class="font-bold underline text-red-700">Voir</a>
                            </div>
                        <% } %>

                        <% if (pAlerts.enAlerte > 0 && (pAlerts.enAlerte - pAlerts.enRupture) > 0) { %>
                            <div class="flex items-center justify-between p-2 rounded-lg bg-amber-50 text-amber-800 border border-amber-100">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-exclamation-triangle text-amber-600"></i>
                                    <span><strong><%= pAlerts.enAlerte - pAlerts.enRupture %></strong> produit(s) sous le seuil d'alerte</span>
                                </div>
                                <a href="/pharmacie?stock_alert=oui" class="font-bold underline text-amber-700">Voir</a>
                            </div>
                        <% } %>

                        <% if (pAlerts.perimes > 0) { %>
                            <div class="flex items-center justify-between p-2 rounded-lg bg-rose-50 text-rose-800 border border-rose-100">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-calendar-times text-rose-600"></i>
                                    <span><strong><%= pAlerts.perimes %></strong> médicament(s) périmé(s)</span>
                                </div>
                                <a href="/pharmacie?delai_peremption=perime" class="font-bold underline text-rose-700">Retirer</a>
                            </div>
                        <% } %>

                        <% if (pAlerts.expire30j > 0) { %>
                            <div class="flex items-center justify-between p-2 rounded-lg bg-orange-50 text-orange-800 border border-orange-100">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-hourglass-end text-orange-600"></i>
                                    <span><strong><%= pAlerts.expire30j %></strong> périment dans ≤ 30 jours</span>
                                </div>
                                <a href="/pharmacie?delai_peremption=30" class="font-bold underline text-orange-700">Voir</a>
                            </div>
                        <% } %>

                        <% if (!hasAlerts) { %>
                            <div class="p-4 text-center text-gray-500">
                                <i class="fas fa-check-circle text-emerald-500 text-2xl mb-1 block"></i>
                                <span>Aucune alerte active. Tous les stocks et dates de péremption sont sous contrôle.</span>
                            </div>
                        <% } %>
                    </div>

                    <div class="pt-2 text-center">
                        <a href="/pharmacie" class="block w-full py-1.5 text-center text-xs font-bold text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-lg transition">
                            Accéder à la Pharmacie & Stock →
                        </a>
                    </div>
                </div>
            </div>

            <!-- Separator -->
            <div class="hidden lg:block lg:h-6 lg:w-px lg:bg-gray-200" aria-hidden="true"></div>

            <!-- Profile dropdown -->
            <div class="relative" x-data="{ open: false }" @keydown.escape="open = false; $refs.userMenuTrigger.focus()">
                <button type="button" @click="open = !open" @click.away="open = false" class="-m-1.5 flex items-center p-1.5" id="user-menu-button" x-ref="userMenuTrigger" :aria-expanded="open.toString()" aria-controls="user-menu">
                    <span class="sr-only">Ouvrir le menu utilisateur</span>
                    <div class="h-8 w-8 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                        <%= (typeof user !== 'undefined' && user && (user.nom || user.email)) ? (user.nom || user.email).charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <span class="hidden lg:flex lg:items-center">
                        <span class="ml-4 text-sm font-semibold leading-6 text-gray-900" aria-hidden="true">
                            <%= (typeof user !== 'undefined' && user && (user.nom || user.email)) ? (user.nom || user.email.split('@')[0]) : 'Admin' %>
                        </span>
                        <i class="fas fa-chevron-down ml-2 text-xs text-gray-400"></i>
                    </span>
                </button>

                <!-- Dropdown menu -->
                <div x-show="open" x-cloak
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     id="user-menu" class="absolute right-0 z-10 mt-2.5 w-40 origin-top-right rounded-md bg-white py-2 shadow-lg ring-1 ring-gray-900/5 focus:outline-none" aria-labelledby="user-menu-button">
                    <a href="/profile" class="block px-3 py-2 text-sm leading-6 text-gray-900 hover:bg-gray-50">Profil</a>
                    <a href="/settings" class="block px-3 py-2 text-sm leading-6 text-gray-900 hover:bg-gray-50">Paramètres</a>
                    <a href="/logout" class="block px-3 py-2 text-sm leading-6 text-red-600 hover:bg-gray-50">Déconnexion</a>
                </div>
            </div>
        </div>
    </div>
</div>
