<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <div class="flex items-center gap-2">
                <a href="/assurances" class="text-gray-400 hover:text-gray-600 mr-1"><i class="fas fa-arrow-left"></i></a>
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-gray-900 tracking-tight">Bordereau — <%= assurance.nom %></h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-100 text-indigo-800">
                    <%= assurance.type ? assurance.type.replace('_', ' ') : 'Assurance' %>
                </span>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Bordereau de transmission et récapitulatif tiers-payant</p>
        </div>
        <div class="flex flex-wrap gap-2 w-full sm:w-auto">
            <a href="/assurances/<%= assurance.id %>/bordereau/export?date_from=<%= dateFrom %>&date_to=<%= dateTo %>" class="flex-1 sm:flex-none text-center bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-2 px-3.5 rounded-lg text-xs sm:text-sm shadow-sm inline-flex items-center justify-center gap-1.5 transition">
                <i class="fas fa-file-excel"></i> Exporter Excel / CSV
            </a>
            <a href="/assurances/<%= assurance.id %>/bordereau/print?date_from=<%= dateFrom %>&date_to=<%= dateTo %>" target="_blank" class="flex-1 sm:flex-none text-center bg-gray-800 hover:bg-gray-900 text-white font-bold py-2 px-3.5 rounded-lg text-xs sm:text-sm shadow-sm inline-flex items-center justify-center gap-1.5 transition">
                <i class="fas fa-print"></i> Imprimer Bordereau A4
            </a>
            <a href="/assurances/<%= assurance.id %>/edit" class="flex-1 sm:flex-none text-center bg-white hover:bg-gray-50 border border-gray-300 text-gray-700 font-bold py-2 px-3.5 rounded-lg text-xs sm:text-sm shadow-sm inline-flex items-center justify-center gap-1.5 transition">
                <i class="fas fa-cog"></i> Configurer
            </a>
        </div>
    </div>

    <!-- Filtre par période -->
    <form action="/assurances/<%= assurance.id %>/bordereau" method="GET" class="bg-white p-4 rounded-xl shadow-sm mb-6 border border-gray-100">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
            <div>
                <label for="date_from" class="block text-xs font-semibold text-gray-600 mb-1">Date début</label>
                <input type="date" id="date_from" name="date_from" value="<%= dateFrom %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            <div>
                <label for="date_to" class="block text-xs font-semibold text-gray-600 mb-1">Date fin</label>
                <input type="date" id="date_to" name="date_to" value="<%= dateTo %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            <div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg text-sm shadow-sm transition inline-flex items-center justify-center gap-1.5">
                    <i class="fas fa-filter"></i> Filtrer la période
                </button>
            </div>
        </div>
    </form>

    <!-- Cartes de synthèse -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-bold text-gray-500 block">Dossiers pris en charge</span>
                    <span class="text-xl font-black text-gray-900"><%= factures.length %> <span class="text-xs font-normal text-gray-500">facture(s)</span></span>
                </div>
                <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-lg"><i class="fas fa-file-invoice text-lg"></i></div>
            </div>
            <p class="text-[10px] text-gray-400 mt-1">Période du <%= new Date(dateFrom).toLocaleDateString('fr-FR') %> au <%= new Date(dateTo).toLocaleDateString('fr-FR') %></p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-bold text-gray-500 block">Total Facturé Brut</span>
                    <span class="text-xl font-black text-gray-900"><%= totalFacture.toLocaleString('fr-FR') %> <span class="text-xs font-normal">FCFA</span></span>
                </div>
                <div class="p-2.5 bg-blue-50 text-blue-600 rounded-lg"><i class="fas fa-calculator text-lg"></i></div>
            </div>
            <p class="text-[10px] text-gray-400 mt-1">Montant global des soins</p>
        </div>

        <div class="bg-white p-4 rounded-xl border-2 border-indigo-300 shadow-sm bg-gradient-to-br from-white to-indigo-50/30">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-black text-indigo-700 block">Part Assurance (À réclamer)</span>
                    <span class="text-xl font-black text-indigo-700"><%= totalPartAssurance.toLocaleString('fr-FR') %> <span class="text-xs font-normal">FCFA</span></span>
                </div>
                <div class="p-2.5 bg-indigo-600 text-white rounded-lg shadow-sm"><i class="fas fa-hand-holding-usd text-lg"></i></div>
            </div>
            <p class="text-[10px] text-indigo-600 font-semibold mt-1">Taux conventionnel : <%= assurance.taux_couverture || 80 %>%</p>
        </div>

        <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-bold text-gray-500 block">Part Patient (Ticket modérateur)</span>
                    <span class="text-xl font-black text-gray-700"><%= totalPartPatient.toLocaleString('fr-FR') %> <span class="text-xs font-normal">FCFA</span></span>
                </div>
                <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-lg"><i class="fas fa-user-check text-lg"></i></div>
            </div>
            <p class="text-[10px] text-gray-400 mt-1">Réglé en caisse par les assurés</p>
        </div>
    </div>

    <!-- Tableau du bordereau -->
    <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-4 border-b flex items-center justify-between flex-wrap gap-2 bg-gray-50">
            <h2 class="text-base font-bold text-gray-800">
                <i class="fas fa-list-alt text-indigo-600 mr-2"></i>Liste des Factures Transmises
            </h2>
            <span class="text-xs font-bold text-gray-500">
                Période : <%= new Date(dateFrom).toLocaleDateString('fr-FR') %> — <%= new Date(dateTo).toLocaleDateString('fr-FR') %>
            </span>
        </div>

        <% if (factures.length === 0) { %>
            <div class="px-6 py-12 text-center">
                <i class="fas fa-file-invoice text-4xl text-gray-300 mb-3"></i>
                <p class="text-gray-600 font-semibold text-base">Aucune facture trouvée pour cet assureur sur cette période</p>
                <p class="text-gray-400 text-xs mt-1">Vérifiez que les patients disposent bien d'un contrat d'assurance au nom de « <%= assurance.nom %> » dans leur dossier.</p>
            </div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-bold text-gray-600 uppercase">Date</th>
                            <th class="px-4 py-3 text-left text-xs font-bold text-gray-600 uppercase">N° Facture</th>
                            <th class="px-4 py-3 text-left text-xs font-bold text-gray-600 uppercase">Patient / Bénéficiaire</th>
                            <th class="px-4 py-3 text-left text-xs font-bold text-gray-600 uppercase">N° Police / Matricule</th>
                            <th class="px-4 py-3 text-right text-xs font-bold text-gray-600 uppercase">Total (FCFA)</th>
                            <th class="px-4 py-3 text-right text-xs font-bold text-indigo-700 uppercase bg-indigo-50/50">Part <%= assurance.nom %></th>
                            <th class="px-4 py-3 text-right text-xs font-bold text-gray-600 uppercase">Part Patient</th>
                            <th class="px-4 py-3 text-center text-xs font-bold text-gray-600 uppercase">Statut</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% factures.forEach((f, idx) => { %>
                            <tr class="<%= idx % 2 === 0 ? '' : 'bg-gray-50/50' %> hover:bg-indigo-50/30 transition">
                                <td class="px-4 py-3 text-xs text-gray-600 font-mono">
                                    <%= new Date(f.date_facture).toLocaleDateString('fr-FR') %>
                                </td>
                                <td class="px-4 py-3 text-xs">
                                    <a href="/factures/<%= f.id %>" class="font-bold text-indigo-600 hover:text-indigo-800">
                                        <%= f.numero_facture %>
                                    </a>
                                </td>
                                <td class="px-4 py-3 text-xs font-semibold text-gray-900">
                                    <%= f.patient_nom %>
                                </td>
                                <td class="px-4 py-3 text-xs text-gray-600 font-mono">
                                    <div class="flex flex-col">
                                        <span class="font-semibold text-gray-800"><%= f.numero_police %></span>
                                        <% if (f.matricule) { %>
                                            <span class="text-[10px] text-gray-400">Mat: <%= f.matricule %></span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-xs text-right text-gray-700 font-medium">
                                    <%= f.total_facture.toLocaleString('fr-FR') %>
                                </td>
                                <td class="px-4 py-3 text-xs text-right font-black text-indigo-700 bg-indigo-50/30">
                                    <%= f.part_assurance.toLocaleString('fr-FR') %>
                                </td>
                                <td class="px-4 py-3 text-xs text-right text-gray-600">
                                    <%= f.part_patient.toLocaleString('fr-FR') %>
                                </td>
                                <td class="px-4 py-3 text-center text-xs">
                                    <% if (f.statut === 'payee') { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-green-100 text-green-800">Payée</span>
                                    <% } else if (f.statut === 'validee') { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800">Validée</span>
                                    <% } else { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-gray-100 text-gray-700"><%= f.statut %></span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot>
                        <tr class="bg-indigo-50 border-t-2 border-indigo-200 font-black">
                            <td colspan="4" class="px-4 py-3 text-xs uppercase text-right text-indigo-900">
                                TOTAUX DE LA PÉRIODE (<%= factures.length %> dossier(s))
                            </td>
                            <td class="px-4 py-3 text-xs text-right text-gray-900">
                                <%= totalFacture.toLocaleString('fr-FR') %> FCFA
                            </td>
                            <td class="px-4 py-3 text-xs text-right text-indigo-900 text-sm">
                                <%= totalPartAssurance.toLocaleString('fr-FR') %> FCFA
                            </td>
                            <td class="px-4 py-3 text-xs text-right text-gray-900">
                                <%= totalPartPatient.toLocaleString('fr-FR') %> FCFA
                            </td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        <% } %>
    </div>
</div>
