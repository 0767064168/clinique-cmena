<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8 max-w-xl">
    <div class="flex items-center gap-3 mb-6">
        <a href="/assurances" class="inline-flex items-center justify-center h-9 w-9 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 transition" title="Retour">
            <i class="fas fa-arrow-left text-sm"></i>
        </a>
        <div>
            <h1 class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">Modifier l'Assurance</h1>
            <p class="text-xs text-gray-500">Mettre à jour les informations du partenaire</p>
        </div>
    </div>

    <% 
        const isStandard = ['MUTUELLE', 'ASSURANCE_PRIVEE'].includes((assurance.type || '').toUpperCase());
        const initialSelect = isStandard ? assurance.type.toUpperCase() : (assurance.type ? 'AUTRE' : 'MUTUELLE');
        const initialCustom = !isStandard ? (assurance.type || '') : '';
    %>

    <div class="bg-white p-5 sm:p-7 rounded-2xl shadow-sm border border-gray-100" 
         x-data="{ selectedType: '<%= initialSelect %>' }">
        <form action="/assurances/<%= assurance.id %>?_method=PUT" method="POST" class="space-y-4 sm:space-y-5">
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    Nom de l'organisme <span class="text-red-500">*</span>
                </label>
                <input type="text" name="nom" value="<%= assurance.nom %>" required 
                    placeholder="Ex: CNAM, MUGEF-CI, ASCOMA" 
                    class="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 text-base sm:text-sm text-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    Type d'organisme
                </label>
                <select name="type" x-model="selectedType" 
                    class="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 text-base sm:text-sm text-gray-800 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                    <option value="MUTUELLE">Mutuelle</option>
                    <option value="ASSURANCE_PRIVEE">Assurance Privée</option>
                    <option value="AUTRE">Autre (à préciser)</option>
                </select>
            </div>

            <!-- Champ précision conditionnel si Autre -->
            <div x-show="selectedType === 'AUTRE'" x-cloak class="transition-all duration-200 bg-amber-50/70 p-3.5 rounded-xl border border-amber-200">
                <label class="block text-xs font-bold text-amber-900 uppercase tracking-wider mb-1">
                    Précisez le type d'organisme <span class="text-red-500">*</span>
                </label>
                <input 
                    type="text" 
                    name="type_autre" 
                    value="<%= initialCustom %>"
                    :required="selectedType === 'AUTRE'"
                    placeholder="Ex: Société d'État, ONG, Ambassade..." 
                    class="w-full border border-amber-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none bg-white">
                <p class="text-[11px] text-amber-700 mt-1">Indiquez la nature exacte de cet organisme partenaire.</p>
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    Numéro de téléphone
                </label>
                <input type="text" name="telephone" value="<%= assurance.telephone || '' %>" 
                    placeholder="Ex: +225 27 20 00 00 00" 
                    class="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 text-base sm:text-sm text-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">
                    Adresse Email (Optionnel)
                </label>
                <input type="email" name="email" value="<%= assurance.email || '' %>" 
                    placeholder="contact@organisme.ci" 
                    class="w-full border border-gray-300 rounded-lg px-3.5 py-2.5 text-base sm:text-sm text-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
            </div>

            <div class="flex flex-col-reverse sm:flex-row justify-end gap-2 pt-4 border-t border-gray-100">
                <a href="/assurances" class="w-full sm:w-auto px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-sm text-center transition">
                    Annuler
                </a>
                <button type="submit" class="w-full sm:w-auto px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-sm shadow-sm text-center transition">
                    <i class="fas fa-save mr-1.5"></i> Mettre à jour
                </button>
            </div>
        </form>
    </div>
</div>
