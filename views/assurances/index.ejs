<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8" x-data="{ showModal: false }">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-gray-900 tracking-tight">Partenaires & Assurances</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-800">
                    <%= typeof assurances !== 'undefined' ? assurances.length : 0 %>
                </span>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Organismes payeurs et mutuelles conventionnées</p>
        </div>
        <button @click="showModal = true" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold py-2.5 px-4 rounded-lg shadow-sm text-sm transition">
            <i class="fas fa-plus text-xs"></i>
            <span>Nouvelle Assurance</span>
        </button>
    </div>

    <!-- Barre de recherche rapide -->
    <div class="bg-white p-3 sm:p-4 rounded-xl shadow-sm mb-6 border border-gray-100">
        <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
            <div class="relative flex-grow">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                    <i class="fas fa-search text-xs"></i>
                </span>
                <input 
                    type="text" 
                    id="searchAssurances" 
                    placeholder="Rechercher une assurance, mutuelle, contact..." 
                    class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    onkeyup="filterAssurances()">
            </div>
            <div class="w-full sm:w-48">
                <select 
                    id="filterAssuranceType" 
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                    onchange="filterAssurances()">
                    <option value="">Tous les types</option>
                    <option value="MUTUELLE">Mutuelle</option>
                    <option value="ASSURANCE_PRIVEE">Assurance Privée</option>
                    <option value="AUTRE">Autre</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Vue Mobile (Cartes adaptées smartphones) -->
    <div class="block md:hidden space-y-3" id="assurancesMobileList">
        <% if (typeof assurances !== 'undefined' && assurances.length > 0) { %>
            <% assurances.forEach(assurance => { %>
                <div class="assurance-card bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-3"
                     data-nom="<%= String(assurance.nom || '').toLowerCase() %>"
                     data-tel="<%= String(assurance.telephone || '').toLowerCase() %>"
                     data-type="<%= String(assurance.type || '').toUpperCase() %>">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <span class="inline-block text-[11px] font-semibold px-2 py-0.5 rounded border mb-1 <%= String(assurance.type || '') === 'MUTUELLE' ? 'bg-purple-100 text-purple-800 border-purple-200' : (String(assurance.type || '') === 'ASSURANCE_PRIVEE' ? 'bg-blue-100 text-blue-800 border-blue-200' : 'bg-gray-100 text-gray-700 border-gray-200') %>">
                                <%= String(assurance.type || 'Autre').replace('_', ' ') %>
                            </span>
                            <h3 class="text-base font-bold text-gray-900 leading-snug"><%= assurance.nom %></h3>
                        </div>
                    </div>

                    <div class="flex items-center text-xs text-gray-600 gap-2">
                        <i class="fas fa-phone text-gray-400"></i>
                        <span><%= assurance.telephone || 'Aucun contact enregistré' %></span>
                    </div>

                    <div class="flex items-center justify-end gap-2 pt-2 border-t border-gray-100">
                        <a href="/assurances/<%= assurance.id %>/edit" class="inline-flex items-center justify-center h-8 px-3 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-indigo-50 text-indigo-700 hover:text-indigo-900 transition">
                            <i class="fas fa-edit mr-1"></i> Modifier
                        </a>
                        <form action="/assurances/<%= assurance.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Supprimer cette assurance ?');">
                            <button type="submit" class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-xs bg-red-50 hover:bg-red-100 text-red-600 transition" title="Supprimer">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="bg-white p-6 rounded-xl text-center text-gray-500 shadow-sm border border-gray-100">
                <i class="fas fa-shield-alt text-2xl text-gray-300 mb-2 block"></i>
                Aucune assurance enregistrée
            </div>
        <% } %>
    </div>

    <!-- Vue Desktop / Tablette (Tableau avec overflow horizontal) -->
    <div class="hidden md:block bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200" id="assurancesTable">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Nom de l'assurance</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Contact</th>
                        <th class="px-6 py-3.5 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% if (typeof assurances !== 'undefined' && assurances.length > 0) { %>
                        <% assurances.forEach(assurance => { %>
                            <tr class="assurance-row hover:bg-slate-50 transition"
                                data-nom="<%= String(assurance.nom || '').toLowerCase() %>"
                                data-tel="<%= String(assurance.telephone || '').toLowerCase() %>"
                                data-type="<%= String(assurance.type || '').toUpperCase() %>">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900"><%= assurance.nom %></td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border <%= String(assurance.type || '') === 'MUTUELLE' ? 'bg-purple-100 text-purple-800 border-purple-200' : (String(assurance.type || '') === 'ASSURANCE_PRIVEE' ? 'bg-blue-100 text-blue-800 border-blue-200' : 'bg-gray-100 text-gray-700 border-gray-200') %>">
                                        <%= String(assurance.type || 'Autre').replace('_', ' ') %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                    <div class="flex items-center gap-1.5">
                                        <i class="fas fa-phone text-xs text-gray-400"></i>
                                        <span><%= assurance.telephone || '-' %></span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <a href="/assurances/<%= assurance.id %>/edit" class="text-indigo-600 hover:text-indigo-900 mr-3 inline-flex items-center gap-1 font-semibold">
                                        <i class="fas fa-edit text-xs"></i> Modifier
                                    </a>
                                    <form action="/assurances/<%= assurance.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Supprimer cette assurance ?');">
                                        <button type="submit" class="text-red-600 hover:text-red-900 inline-flex items-center gap-1 font-semibold">
                                            <i class="fas fa-trash-alt text-xs"></i> Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                                <i class="fas fa-shield-alt text-3xl text-gray-300 mb-2 block"></i>
                                Aucune assurance trouvée
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Message aucun résultat après filtre -->
    <div id="noAssurancesResult" class="hidden bg-white p-6 rounded-xl text-center text-gray-500 shadow-sm border border-gray-100 mt-3">
        <i class="fas fa-search text-2xl text-gray-300 mb-2 block"></i>
        Aucune assurance ne correspond à votre recherche
    </div>

    <!-- Modal d'ajout Responsive -->
    <div x-show="showModal" x-cloak class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm overflow-y-auto h-full w-full z-50 flex items-center justify-center p-3 sm:p-4">
        <div class="relative w-full max-w-md p-5 sm:p-6 bg-white rounded-2xl shadow-2xl border border-gray-100 transition-all" @click.away="showModal = false">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-gray-100">
                <h3 class="text-base sm:text-lg font-bold text-gray-900 flex items-center gap-2">
                    <i class="fas fa-shield-alt text-blue-600"></i>
                    Nouvelle Assurance
                </h3>
                <button type="button" @click="showModal = false" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fas fa-times text-base"></i>
                </button>
            </div>
            <form action="/assurances" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Nom de l'organisme <span class="text-red-500">*</span></label>
                    <input type="text" name="nom" required placeholder="Ex: CNAM, MUGEF-CI, ASCOMA" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Type d'organisme</label>
                    <select name="type" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                        <option value="MUTUELLE">Mutuelle</option>
                        <option value="ASSURANCE_PRIVEE">Assurance Privée</option>
                        <option value="AUTRE">Autre</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Numéro de téléphone</label>
                    <input type="text" name="telephone" placeholder="Ex: +225 27 20 00 00 00" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                </div>
                <div class="flex flex-col-reverse sm:flex-row gap-2 pt-2 border-t border-gray-100">
                    <button type="button" @click="showModal = false" class="w-full sm:w-auto px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-sm text-center transition">
                        Annuler
                    </button>
                    <button type="submit" class="w-full sm:flex-1 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg text-sm shadow-sm text-center transition">
                        <i class="fas fa-check mr-1"></i> Enregistrer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function filterAssurances() {
        const query = (document.getElementById('searchAssurances').value || '').toLowerCase().trim();
        const type = (document.getElementById('filterAssuranceType').value || '').toUpperCase().trim();

        const cards = document.querySelectorAll('.assurance-card');
        const rows = document.querySelectorAll('.assurance-row');
        let visibleCount = 0;

        cards.forEach(card => {
            const nom = card.getAttribute('data-nom') || '';
            const tel = card.getAttribute('data-tel') || '';
            const cardType = card.getAttribute('data-type') || '';

            const matchQuery = !query || nom.includes(query) || tel.includes(query);
            const matchType = !type || cardType === type;

            if (matchQuery && matchType) {
                card.classList.remove('hidden');
                visibleCount++;
            } else {
                card.classList.add('hidden');
            }
        });

        rows.forEach(row => {
            const nom = row.getAttribute('data-nom') || '';
            const tel = row.getAttribute('data-tel') || '';
            const rowType = row.getAttribute('data-type') || '';

            const matchQuery = !query || nom.includes(query) || tel.includes(query);
            const matchType = !type || rowType === type;

            if (matchQuery && matchType) {
                row.classList.remove('hidden');
            } else {
                row.classList.add('hidden');
            }
        });

        const noResults = document.getElementById('noAssurancesResult');
        if (visibleCount === 0 && (cards.length > 0 || rows.length > 0)) {
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
        }
    }
</script>
