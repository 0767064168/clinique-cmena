<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bordereau — <%= assurance.nom %> — <%= new Date(dateFrom).toLocaleDateString('fr-FR') %> au <%= new Date(dateTo).toLocaleDateString('fr-FR') %></title>
    <link href="/css/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <style>
        @page { size: A4 landscape; margin: 8mm; }
        @media print {
            body { padding: 0 !important; margin: 0 !important; background: white !important; font-size: 10px; }
            .no-print { display: none !important; }
            tr { page-break-inside: avoid; }
        }
        body { font-family: 'Helvetica Neue', Arial, sans-serif; background: #f8fafc; color: #1e293b; }
    </style>
</head>
<body class="bg-white">
    <!-- Contrôles d'impression -->
    <div class="no-print fixed top-4 right-4 z-50 flex gap-2">
        <button onclick="window.print()" class="bg-gray-800 hover:bg-gray-900 text-white font-bold py-2 px-4 rounded-lg text-sm shadow-lg inline-flex items-center gap-1.5 cursor-pointer">
            <i class="fas fa-print"></i> Imprimer
        </button>
        <button onclick="window.close()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-2 px-4 rounded-lg text-sm cursor-pointer">
            Fermer
        </button>
    </div>

    <div class="max-w-6xl mx-auto p-4">
        <!-- En-tête officiel GSPM -->
        <div class="text-center mb-4">
            <div class="flex justify-between items-start">
                <img src="/images/logo_gspm.jpg" alt="Logo GSPM" class="h-14 w-14 object-contain" onerror="this.style.display='none'">
                <div>
                    <p class="text-xs font-bold uppercase tracking-wider">République de Côte d'Ivoire</p>
                    <p class="text-xs font-bold">Ministère de la Défense</p>
                    <p class="text-xs font-bold">Groupement de Sapeurs-Pompiers Militaires</p>
                    <p class="text-[10px] text-gray-600 font-medium">Centre Médical — 3e Compagnie GSPM Bouaké</p>
                </div>
                <img src="/images/logo_defense.jpg" alt="Logo Défense" class="h-14 w-14 object-contain" onerror="this.style.display='none'">
            </div>
            <!-- Ligne tricolore ivoirienne -->
            <div class="mt-2 mb-2" style="height: 3px; background: linear-gradient(to right, #FF6600, #FFFFFF, #009900);"></div>
        </div>

        <!-- Titre du document -->
        <div class="text-center mb-4">
            <h1 class="text-lg font-black uppercase tracking-wider text-gray-900">
                Bordereau Récapitulatif de Transmission des Factures
            </h1>
            <p class="text-xs text-gray-700 font-semibold mt-0.5">
                Organisme Payeur : <span class="uppercase text-indigo-900 font-black"><%= assurance.nom %></span>
                <% if (assurance.telephone) { %> — Tél: <%= assurance.telephone %><% } %>
            </p>
            <p class="text-[11px] text-gray-500">
                Période de prise en charge : <strong>du <%= new Date(dateFrom).toLocaleDateString('fr-FR') %> au <%= new Date(dateTo).toLocaleDateString('fr-FR') %></strong>
            </p>
        </div>

        <!-- Synthèse financière du bordereau -->
        <div class="grid grid-cols-4 gap-3 mb-4 text-xs">
            <div class="border border-gray-300 rounded p-2 text-center bg-gray-50">
                <span class="text-[10px] uppercase font-bold text-gray-500 block">Nombre de Factures</span>
                <span class="text-sm font-black text-gray-800"><%= factures.length %></span>
            </div>
            <div class="border border-gray-300 rounded p-2 text-center bg-gray-50">
                <span class="text-[10px] uppercase font-bold text-gray-500 block">Total Dépenses Médicales</span>
                <span class="text-sm font-black text-gray-800"><%= totalFacture.toLocaleString('fr-FR') %> FCFA</span>
            </div>
            <div class="border-2 border-indigo-500 rounded p-2 text-center bg-indigo-50">
                <span class="text-[10px] uppercase font-black text-indigo-700 block">Part à la Charge de l'Assureur</span>
                <span class="text-sm font-black text-indigo-900"><%= totalPartAssurance.toLocaleString('fr-FR') %> FCFA</span>
            </div>
            <div class="border border-gray-300 rounded p-2 text-center bg-gray-50">
                <span class="text-[10px] uppercase font-bold text-gray-500 block">Part Réglée par l'Assuré</span>
                <span class="text-sm font-black text-gray-800"><%= totalPartPatient.toLocaleString('fr-FR') %> FCFA</span>
            </div>
        </div>

        <!-- Tableau des prises en charge -->
        <% if (factures.length === 0) { %>
            <div class="border border-gray-300 rounded p-8 text-center text-gray-500 text-xs">
                Aucune facture enregistrée pour <%= assurance.nom %> durant cette période.
            </div>
        <% } else { %>
            <table class="w-full text-[10px] border-collapse border border-gray-300 mb-4">
                <thead class="bg-gray-100 text-gray-700 font-bold uppercase">
                    <tr>
                        <th class="border border-gray-300 px-2 py-1.5 text-center w-8">N°</th>
                        <th class="border border-gray-300 px-2 py-1.5 text-left w-20">Date</th>
                        <th class="border border-gray-300 px-2 py-1.5 text-left w-24">N° Facture</th>
                        <th class="border border-gray-300 px-2 py-1.5 text-left">Nom & Prénoms Bénéficiaire</th>
                        <th class="border border-gray-300 px-2 py-1.5 text-left w-28">N° Police / Matr.</th>
                        <th class="border border-gray-300 px-2 py-1.5 text-right w-24">Montant Total</th>
                        <th class="border border-gray-300 px-2 py-1.5 text-right w-24 bg-indigo-50 font-black">Part <%= assurance.nom %></th>
                        <th class="border border-gray-300 px-2 py-1.5 text-right w-24">Part Assuré</th>
                    </tr>
                </thead>
                <tbody>
                    <% factures.forEach((f, idx) => { %>
                        <tr class="<%= idx % 2 === 0 ? 'bg-white' : 'bg-gray-50' %>">
                            <td class="border border-gray-300 px-2 py-1 text-center font-mono"><%= idx + 1 %></td>
                            <td class="border border-gray-300 px-2 py-1 font-mono"><%= new Date(f.date_facture).toLocaleDateString('fr-FR') %></td>
                            <td class="border border-gray-300 px-2 py-1 font-bold text-gray-800"><%= f.numero_facture %></td>
                            <td class="border border-gray-300 px-2 py-1 font-semibold uppercase"><%= f.patient_nom %></td>
                            <td class="border border-gray-300 px-2 py-1 font-mono">
                                <%= f.numero_police %>
                                <% if (f.matricule) { %><span class="text-[9px] text-gray-500 block">Mat: <%= f.matricule %></span><% } %>
                            </td>
                            <td class="border border-gray-300 px-2 py-1 text-right"><%= f.total_facture.toLocaleString('fr-FR') %></td>
                            <td class="border border-gray-300 px-2 py-1 text-right font-bold text-indigo-900 bg-indigo-50"><%= f.part_assurance.toLocaleString('fr-FR') %></td>
                            <td class="border border-gray-300 px-2 py-1 text-right text-gray-600"><%= f.part_patient.toLocaleString('fr-FR') %></td>
                        </tr>
                    <% }); %>
                </tbody>
                <tfoot>
                    <tr class="bg-indigo-100 font-black text-gray-900 border-t-2 border-indigo-400">
                        <td colspan="5" class="border border-gray-300 px-2 py-1.5 text-right uppercase">
                            TOTAL À PAYER PAR <%= assurance.nom %> :
                        </td>
                        <td class="border border-gray-300 px-2 py-1.5 text-right">
                            <%= totalFacture.toLocaleString('fr-FR') %> FCFA
                        </td>
                        <td class="border border-gray-300 px-2 py-1.5 text-right text-indigo-900 text-[11px]">
                            <%= totalPartAssurance.toLocaleString('fr-FR') %> FCFA
                        </td>
                        <td class="border border-gray-300 px-2 py-1.5 text-right">
                            <%= totalPartPatient.toLocaleString('fr-FR') %> FCFA
                        </td>
                    </tr>
                </tfoot>
            </table>

            <div class="text-[10px] text-gray-600 italic mb-6">
                Arrêté le présent bordereau à la somme de : <strong class="uppercase text-gray-900"><%= totalPartAssurance.toLocaleString('fr-FR') %> FRANCS CFA</strong>.
            </div>
        <% } %>

        <!-- Blocs de signature officiels -->
        <div class="grid grid-cols-3 gap-8 mt-6 text-xs">
            <div class="text-center">
                <p class="font-bold uppercase text-[10px] mb-12">Le Caissier / Comptable</p>
                <div class="border-b border-gray-400 mb-1"></div>
                <p class="text-gray-600 text-[10px]"><%= user ? (user.nom + ' ' + user.prenom) : '..............................' %></p>
                <p class="text-gray-400 text-[9px]">Nom, Signature et Date</p>
            </div>
            <div class="text-center">
                <p class="font-bold uppercase text-[10px] mb-12">Pour Réception Assureur</p>
                <div class="border-b border-gray-400 mb-1"></div>
                <p class="text-gray-400 text-[10px]">Date, Cachet et Signature</p>
            </div>
            <div class="text-center">
                <p class="font-bold uppercase text-[10px] mb-12">Le Médecin-Chef / Commandant CSA</p>
                <div class="border-b border-gray-400 mb-1"></div>
                <p class="text-gray-600 text-[10px]">..............................</p>
                <p class="text-gray-400 text-[9px]">Signature et Cachet Officiel</p>
            </div>
        </div>

        <!-- Pied de page officiel GSPM -->
        <div class="text-center text-[8px] text-gray-400 mt-8 border-t pt-2">
            CSA 3e COMPAGNIE GSPM BOUAKÉ — BORDEREAU DE TRANSMISSION ASSURANCES — ÉMIS LE <%= new Date().toLocaleDateString('fr-FR') %> À <%= new Date().toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'}) %> — SAUVER OU PÉRIR
        </div>
    </div>
</body>
</html>
