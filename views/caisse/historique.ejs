<div class="space-y-6">
    <!-- En-tête -->
    <div class="sm:flex sm:items-center sm:justify-between pb-4 border-b border-gray-200">
        <div class="flex items-center gap-3">
            <a href="/caisse" class="p-2 text-gray-500 hover:text-gray-700 bg-white rounded-lg border border-gray-300 shadow-sm transition">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-900 flex items-center gap-2">
                    <span class="p-2 bg-emerald-600 text-white rounded-lg text-sm">
                        <i class="fas fa-archive"></i>
                    </span>
                    Historique des Clôtures de Caisse (Arrêtés Z)
                </h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    Registre officiel des arrêtés journaliers, comptages physiques et suivi des écarts de caisse
                </p>
            </div>
        </div>
        <div class="mt-4 sm:mt-0 flex items-center gap-2">
            <a href="/caisse" class="px-4 py-2 rounded-lg bg-green-600 hover:bg-green-700 text-white text-xs sm:text-sm font-bold shadow-sm transition inline-flex items-center gap-1.5">
                <i class="fas fa-cash-register"></i> Caisse du Jour
            </a>
        </div>
    </div>

    <!-- Filtres -->
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
        <form method="GET" action="/caisse/historique" class="flex flex-col sm:flex-row items-end gap-3">
            <div class="w-full sm:w-48">
                <label class="block text-xs font-bold text-gray-600 mb-1">Date début</label>
                <input type="date" name="dateDebut" value="<%= typeof dateDebut !== 'undefined' ? dateDebut : '' %>" 
                       class="w-full rounded-lg border-gray-300 text-xs py-2 shadow-sm focus:ring-primary focus:border-primary">
            </div>
            <div class="w-full sm:w-48">
                <label class="block text-xs font-bold text-gray-600 mb-1">Date fin</label>
                <input type="date" name="dateFin" value="<%= typeof dateFin !== 'undefined' ? dateFin : '' %>" 
                       class="w-full rounded-lg border-gray-300 text-xs py-2 shadow-sm focus:ring-primary focus:border-primary">
            </div>
            <button type="submit" class="w-full sm:w-auto px-4 py-2 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-lg transition shadow-sm">
                <i class="fas fa-filter mr-1"></i> Filtrer
            </button>
            <% if (dateDebut || dateFin) { %>
                <a href="/caisse/historique" class="text-xs text-gray-500 hover:text-red-600 transition p-2">
                    <i class="fas fa-undo"></i> Réinitialiser
                </a>
            <% } %>
        </form>
    </div>

    <!-- Tableau Historique -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-xs sm:text-sm">
                <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-[11px] font-semibold">
                    <tr>
                        <th class="px-4 py-3 text-left">N° Clôture & Date</th>
                        <th class="px-4 py-3 text-left">Caissier</th>
                        <th class="px-4 py-3 text-right">Total Encaissé</th>
                        <th class="px-4 py-3 text-right">Dépenses</th>
                        <th class="px-4 py-3 text-right">Espèces Théoriques</th>
                        <th class="px-4 py-3 text-right">Espèces Comptées</th>
                        <th class="px-4 py-3 text-center">Écart</th>
                        <th class="px-4 py-3 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    <% if (!clotures || clotures.length === 0) { %>
                        <tr>
                            <td colspan="8" class="px-4 py-12 text-center text-gray-400 italic">
                                <i class="fas fa-inbox text-3xl mb-2 text-gray-300 block"></i>
                                Aucune clôture de caisse archivée pour le moment.
                            </td>
                        </tr>
                    <% } else { %>
                        <% clotures.forEach(c => { 
                            const ecartVal = parseFloat(c.ecart_caisse) || 0;
                            let ecartBadge = 'bg-emerald-100 text-emerald-800 border-emerald-200';
                            let ecartText = '0 FCFA (Conforme)';
                            if (ecartVal > 0) {
                                ecartBadge = 'bg-amber-100 text-amber-800 border-amber-200';
                                ecartText = '+' + ecartVal.toLocaleString('fr-FR') + ' F (Surplus)';
                            } else if (ecartVal < 0) {
                                ecartBadge = 'bg-red-100 text-red-800 border-red-200';
                                ecartText = ecartVal.toLocaleString('fr-FR') + ' F (Manquant)';
                            }
                        %>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <div class="font-bold font-mono text-gray-900"><%= c.numero_cloture %></div>
                                    <div class="text-[11px] text-gray-500">
                                        <%= new Date(c.date_cloture).toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </div>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <span class="font-semibold text-gray-800"><%= c.caissier_nom %></span>
                                    <div class="text-[10px] text-gray-400">
                                        <%= new Date(c.date_heure).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-right font-mono font-bold text-gray-900 whitespace-nowrap">
                                    <%= Number(c.total_encaissements || 0).toLocaleString('fr-FR') %> F
                                </td>
                                <td class="px-4 py-3 text-right font-mono font-bold text-red-600 whitespace-nowrap">
                                    <%= Number(c.total_depenses || 0).toLocaleString('fr-FR') %> F
                                </td>
                                <td class="px-4 py-3 text-right font-mono font-bold text-gray-700 whitespace-nowrap">
                                    <%= Number(c.solde_net_theorique || 0).toLocaleString('fr-FR') %> F
                                </td>
                                <td class="px-4 py-3 text-right font-mono font-black text-gray-900 whitespace-nowrap">
                                    <%= Number(c.solde_especes_physique || 0).toLocaleString('fr-FR') %> F
                                </td>
                                <td class="px-4 py-3 text-center whitespace-nowrap">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black border <%= ecartBadge %>">
                                        <%= ecartText %>
                                    </span>
                                </td>
                                <td class="px-4 py-3 text-right whitespace-nowrap space-x-1">
                                    <a href="/caisse?date=<%= c.date_cloture %>" title="Voir la journée" class="p-1.5 text-gray-500 hover:text-green-600 hover:bg-green-50 rounded-lg transition">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="/caisse/ticket?date=<%= c.date_cloture %>" target="_blank" title="Ticket 80mm" class="p-1.5 text-gray-500 hover:text-primary hover:bg-blue-50 rounded-lg transition">
                                        <i class="fas fa-receipt"></i>
                                    </a>
                                    <a href="/caisse/clotures/<%= c.id %>/print" target="_blank" title="PV Officiel A4" class="p-1.5 text-gray-500 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition">
                                        <i class="fas fa-print"></i>
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
