<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Consultations</h1>
        <a href="/consultations/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            Nouvelle Consultation
        </a>
    </div>

    <!-- Filters -->
    <div class="bg-white p-4 rounded-lg shadow mb-6">
        <form action="/consultations" method="GET" class="flex flex-wrap gap-4 items-end">
            <div>
                <label class="block text-sm text-gray-600 mb-1">Du</label>
                <input type="date" name="date_from" class="border rounded-md px-3 py-2" value="<%= typeof query !== 'undefined' ? query.date_from : '' %>">
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">Au</label>
                <input type="date" name="date_to" class="border rounded-md px-3 py-2" value="<%= typeof query !== 'undefined' ? query.date_to : '' %>">
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">Praticien</label>
                <select name="praticien_id" class="border rounded-md px-3 py-2 min-w-[200px]">
                    <option value="">Tous les praticiens</option>
                    <% if (typeof praticiens !== 'undefined') { %>
                        <% praticiens.forEach(p => { %>
                            <option value="<%= p.id %>" <%= typeof query !== 'undefined' && query.praticien_id == p.id ? 'selected' : '' %>><%= p.nom %> <%= p.prenom %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">Statut</label>
                <select name="statut" class="border rounded-md px-3 py-2 min-w-[150px]">
                    <option value="">Tous les statuts</option>
                    <option value="en_cours" <%= typeof query !== 'undefined' && query.statut === 'en_cours' ? 'selected' : '' %>>En cours</option>
                    <option value="termine" <%= typeof query !== 'undefined' && query.statut === 'termine' ? 'selected' : '' %>>Terminé</option>
                    <option value="annule" <%= typeof query !== 'undefined' && query.statut === 'annule' ? 'selected' : '' %>>Annulé</option>
                </select>
            </div>
            <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">Filtrer</button>
            <a href="/consultations" class="text-sm text-gray-500 hover:underline px-2 py-2">Réinitialiser</a>
        </form>
    </div>

    <!-- List -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Praticien</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Motif</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% if (typeof consultations !== 'undefined' && consultations.length > 0) { %>
                    <% consultations.forEach(consultation => { %>
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= new Date(consultation.date_entree).toLocaleString('fr-FR') %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><a href="/patients/<%= consultation.patient_id %>" class="hover:underline"><%= consultation.patient_nom %> <%= consultation.patient_prenom %></a></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= consultation.praticien_nom %></td>
                            <td class="px-6 py-4 text-sm text-gray-500 truncate max-w-xs"><%= consultation.motif %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                    <%= consultation.statut === 'termine' ? 'bg-green-100 text-green-800' : 
                                       (consultation.statut === 'en_cours' ? 'bg-blue-100 text-blue-800' : 'bg-red-100 text-red-800') %>">
                                    <%= consultation.statut === 'en_cours' ? 'En cours' : (consultation.statut === 'termine' ? 'Terminé' : 'Annulé') %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex gap-2">
                                <a href="/consultations/<%= consultation.id %>" class="text-blue-600 hover:text-blue-900">Voir</a>
                                <a href="/consultations/<%= consultation.id %>/edit" class="text-indigo-600 hover:text-indigo-900">Modifier</a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="6" class="px-6 py-4 text-center text-gray-500">Aucune consultation trouvée</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
