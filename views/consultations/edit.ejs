<div class="container mx-auto px-4 py-8">
    <div class="max-w-3xl mx-auto">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Modifier Consultation</h1>
            <a href="/consultations/<%= consultation.id %>" class="text-gray-600 hover:text-gray-900 font-medium">Retour</a>
        </div>

        <form action="/consultations/<%= consultation.id %>?_method=PUT" method="POST" class="bg-white shadow rounded-lg p-6 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Patient</label>
                    <input type="text" disabled class="w-full border rounded-md px-3 py-2 bg-gray-100 text-gray-600" value="<%= consultation.patient_nom %> <%= consultation.patient_prenom %>">
                    <input type="hidden" name="patient_id" value="<%= consultation.patient_id %>">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Praticien *</label>
                    <select name="praticien_id" required class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
                        <% if (typeof praticiens !== 'undefined') { %>
                            <% praticiens.forEach(p => { %>
                                <option value="<%= p.id %>" <%= consultation.praticien_id === p.id ? 'selected' : '' %>><%= p.nom %> <%= p.prenom %> (<%= p.specialite %><%= p.matricule ? ' - Mle: ' + p.matricule : '' %>)</option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Statut</label>
                    <select name="statut" class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="en_cours" <%= consultation.statut === 'en_cours' ? 'selected' : '' %>>En cours</option>
                        <option value="termine" <%= consultation.statut === 'termine' ? 'selected' : '' %>>Terminé</option>
                        <option value="annule" <%= consultation.statut === 'annule' ? 'selected' : '' %>>Annulé</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Date d'entrée *</label>
                    <input type="datetime-local" name="date_entree" required class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500" value="<%= new Date(consultation.date_entree).toISOString().slice(0, 16) %>">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Date de sortie</label>
                    <input type="datetime-local" name="date_sortie" class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500" value="<%= consultation.date_sortie ? new Date(consultation.date_sortie).toISOString().slice(0, 16) : '' %>">
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Motif</label>
                    <textarea name="motif" rows="2" class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"><%= consultation.motif %></textarea>
                </div>

                <!-- Section Constantes Vitales -->
                <div class="md:col-span-2 bg-slate-50 border border-slate-200 rounded-xl p-5">
                    <div class="flex items-center gap-2 mb-3">
                        <i class="fas fa-heartbeat text-red-600 text-lg"></i>
                        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-wide">Constantes Vitales du Patient</h3>
                        <span class="text-[11px] text-gray-500 font-normal ml-auto">(Réservé au dossier médical — n'apparaît pas sur la facture)</span>
                    </div>
                    <% const v = (consultation && consultation.vitals) ? consultation.vitals : {}; %>
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
                        <!-- Tension Artérielle -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Tension (TA)</label>
                            <div class="relative">
                                <input type="text" name="tension" value="<%= v.tension || '' %>" placeholder="12/8" 
                                    class="w-full border rounded-md px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
                                <span class="absolute right-2 top-2 text-[10px] text-gray-400 font-medium">mmHg</span>
                            </div>
                        </div>

                        <!-- Température -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Température</label>
                            <div class="relative">
                                <input type="text" name="temperature" value="<%= v.temperature || '' %>" placeholder="37.2" 
                                    class="w-full border rounded-md px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
                                <span class="absolute right-2 top-2 text-[10px] text-gray-400 font-medium">°C</span>
                            </div>
                        </div>

                        <!-- Poids -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Poids</label>
                            <div class="relative">
                                <input type="text" name="poids" value="<%= v.poids || '' %>" placeholder="72" 
                                    class="w-full border rounded-md px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
                                <span class="absolute right-2 top-2 text-[10px] text-gray-400 font-medium">kg</span>
                            </div>
                        </div>

                        <!-- Pouls -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Pouls</label>
                            <div class="relative">
                                <input type="text" name="pouls" value="<%= v.pouls || '' %>" placeholder="78" 
                                    class="w-full border rounded-md px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
                                <span class="absolute right-2 top-2 text-[10px] text-gray-400 font-medium">bpm</span>
                            </div>
                        </div>

                        <!-- Taille -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Taille</label>
                            <div class="relative">
                                <input type="text" name="taille" value="<%= v.taille || '' %>" placeholder="175" 
                                    class="w-full border rounded-md px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-red-500 focus:outline-none">
                                <span class="absolute right-2 top-2 text-[10px] text-gray-400 font-medium">cm</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Observations</label>
                    <textarea name="observations" rows="3" class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"><%= consultation.observations_clean || consultation.observations %></textarea>
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Diagnostic</label>
                    <textarea name="diagnostic" rows="3" class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"><%= consultation.diagnostic %></textarea>
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex justify-end gap-4 border-t pt-4">
                <a href="/consultations/<%= consultation.id %>" class="px-4 py-2 border rounded-md text-gray-700 hover:bg-gray-50">Annuler</a>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 font-bold">Mettre à jour</button>
            </div>
        </form>
    </div>
</div>
