<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8" x-data="{ autoRefresh: true }" x-init="setInterval(() => { if(autoRefresh) window.location.reload(); }, 60000)">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-gray-900 tracking-tight">Salle d'Attente</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 animate-pulse">
                    <i class="fas fa-circle text-[6px] mr-1"></i> En direct
                </span>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Suivi en temps réel des patients — <%= new Date().toLocaleDateString('fr-FR', {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'}) %></p>
        </div>
        <div class="flex flex-wrap gap-2 w-full sm:w-auto">
            <a href="/consultations/create" class="flex-1 sm:flex-none text-center bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg text-xs sm:text-sm shadow-sm inline-flex items-center justify-center gap-1.5">
                <i class="fas fa-plus"></i> Nouvelle Consultation
            </a>
            <label class="flex-1 sm:flex-none flex items-center gap-2 bg-white border border-gray-200 px-3 py-2 rounded-lg text-xs cursor-pointer select-none">
                <input type="checkbox" x-model="autoRefresh" class="rounded text-green-600">
                <span class="text-gray-600 font-medium">Rafraîchissement auto (1 min)</span>
            </label>
        </div>
    </div>

    <!-- Compteurs -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-3.5 text-center">
            <i class="fas fa-hourglass-half text-amber-500 text-xl mb-1"></i>
            <p class="text-2xl font-black text-amber-800"><%= enAttente.length %></p>
            <p class="text-[10px] uppercase font-bold text-amber-600">En Attente</p>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-3.5 text-center">
            <i class="fas fa-user-md text-blue-500 text-xl mb-1"></i>
            <p class="text-2xl font-black text-blue-800"><%= enCours.length %></p>
            <p class="text-[10px] uppercase font-bold text-blue-600">En Consultation</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-xl p-3.5 text-center">
            <i class="fas fa-check-circle text-green-500 text-xl mb-1"></i>
            <p class="text-2xl font-black text-green-800"><%= termines.length %></p>
            <p class="text-[10px] uppercase font-bold text-green-600">Terminés Aujourd'hui</p>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-3.5 text-center">
            <i class="fas fa-calendar-check text-gray-500 text-xl mb-1"></i>
            <p class="text-2xl font-black text-gray-800"><%= totalJour %></p>
            <p class="text-[10px] uppercase font-bold text-gray-600">Total du Jour</p>
        </div>
    </div>

    <!-- Patients en attente -->
    <% if (enAttente.length > 0) { %>
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6 border-l-4 border-amber-400">
        <div class="px-6 py-4 border-b bg-amber-50/50 flex items-center gap-2">
            <i class="fas fa-hourglass-half text-amber-500"></i>
            <h2 class="text-lg font-semibold text-gray-700">Patients en Attente</h2>
            <span class="ml-auto text-xs font-bold text-amber-600 bg-amber-100 px-2 py-0.5 rounded-full"><%= enAttente.length %></span>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ordre</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Motif</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Arrivée</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Attente</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Constantes</th>
                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% enAttente.forEach((c, idx) => { %>
                        <tr class="hover:bg-amber-50/30 transition">
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-amber-100 text-amber-800 text-sm font-black"><%= idx + 1 %></span>
                            </td>
                            <td class="px-4 py-3">
                                <a href="/patients/<%= c.patient_id %>" class="text-sm font-bold text-gray-900 hover:text-blue-600"><%= c.patient_nom %> <%= c.patient_prenom %></a>
                                <p class="text-[10px] text-gray-400 font-mono">N° <%= c.numero_dossier || '-' %></p>
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-600"><%= c.motif || 'Non précisé' %></td>
                            <td class="px-4 py-3 text-sm text-gray-600 font-mono"><%= new Date(c.date_entree).toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'}) %></td>
                            <td class="px-4 py-3">
                                <% 
                                    const minutesAttente = Math.max(0, Math.round((Date.now() - new Date(c.date_entree).getTime()) / 60000));
                                    const heures = Math.floor(minutesAttente / 60);
                                    const mins = minutesAttente % 60;
                                    const attenteStr = heures > 0 ? heures + 'h ' + mins + 'min' : mins + ' min';
                                    const attenteClass = minutesAttente > 60 ? 'text-red-600 bg-red-50' : minutesAttente > 30 ? 'text-amber-600 bg-amber-50' : 'text-green-600 bg-green-50';
                                %>
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold <%= attenteClass %>">
                                    <i class="fas fa-clock text-[10px]"></i> <%= attenteStr %>
                                </span>
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-500">
                                <% if (c.clinical && (c.clinical.tension || c.clinical.temperature || c.clinical.poids)) { %>
                                    <div class="flex flex-wrap gap-1">
                                        <% if (c.clinical.tension) { %><span class="bg-slate-100 px-1.5 py-0.5 rounded">TA: <%= c.clinical.tension %></span><% } %>
                                        <% if (c.clinical.temperature) { %><span class="bg-slate-100 px-1.5 py-0.5 rounded">T°: <%= c.clinical.temperature %>°C</span><% } %>
                                        <% if (c.clinical.poids) { %><span class="bg-slate-100 px-1.5 py-0.5 rounded"><%= c.clinical.poids %> kg</span><% } %>
                                    </div>
                                <% } else { %>
                                    <span class="text-gray-400 italic">Non relevées</span>
                                <% } %>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <a href="/consultations/<%= c.id %>" class="inline-flex items-center gap-1 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-bold shadow-sm transition">
                                    <i class="fas fa-stethoscope"></i> Prendre en charge
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

    <!-- En cours de consultation -->
    <% if (enCours.length > 0) { %>
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6 border-l-4 border-blue-400">
        <div class="px-6 py-4 border-b bg-blue-50/50 flex items-center gap-2">
            <i class="fas fa-user-md text-blue-500"></i>
            <h2 class="text-lg font-semibold text-gray-700">En Cours de Consultation</h2>
            <span class="ml-auto text-xs font-bold text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full"><%= enCours.length %></span>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Médecin</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Motif</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Depuis</th>
                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Voir</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% enCours.forEach(c => { %>
                        <tr class="hover:bg-blue-50/30 transition">
                            <td class="px-4 py-3">
                                <span class="text-sm font-bold text-gray-900"><%= c.patient_nom %> <%= c.patient_prenom %></span>
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-600"><%= c.praticien_nom || 'Non assigné' %></td>
                            <td class="px-4 py-3 text-sm text-gray-600"><%= c.motif || '-' %></td>
                            <td class="px-4 py-3 text-sm font-mono text-gray-600"><%= new Date(c.date_entree).toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'}) %></td>
                            <td class="px-4 py-3 text-center">
                                <a href="/consultations/<%= c.id %>" class="text-blue-600 hover:text-blue-800 font-bold text-xs"><i class="fas fa-eye mr-1"></i> Consulter</a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

    <!-- Terminés -->
    <% if (termines.length > 0) { %>
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6 border-l-4 border-green-400">
        <div class="px-6 py-4 border-b bg-green-50/50 flex items-center gap-2">
            <i class="fas fa-check-circle text-green-500"></i>
            <h2 class="text-lg font-semibold text-gray-700">Consultations Terminées Aujourd'hui</h2>
            <span class="ml-auto text-xs font-bold text-green-600 bg-green-100 px-2 py-0.5 rounded-full"><%= termines.length %></span>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Patient</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Médecin</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Motif</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Diagnostic</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Heure sortie</th>
                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Voir</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% termines.forEach(c => { %>
                        <tr class="hover:bg-green-50/30 transition">
                            <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= c.patient_nom %> <%= c.patient_prenom %></td>
                            <td class="px-4 py-3 text-sm text-gray-600"><%= c.praticien_nom || '-' %></td>
                            <td class="px-4 py-3 text-sm text-gray-600"><%= c.motif || '-' %></td>
                            <td class="px-4 py-3 text-sm text-gray-700 font-medium"><%= c.diagnostic || '—' %></td>
                            <td class="px-4 py-3 text-sm font-mono text-gray-600"><%= c.date_sortie ? new Date(c.date_sortie).toLocaleTimeString('fr-FR', {hour:'2-digit', minute:'2-digit'}) : '-' %></td>
                            <td class="px-4 py-3 text-center">
                                <a href="/consultations/<%= c.id %>" class="text-green-600 hover:text-green-800 font-bold text-xs"><i class="fas fa-eye mr-1"></i> Voir</a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
    <% } %>

    <% if (enAttente.length === 0 && enCours.length === 0 && termines.length === 0) { %>
    <div class="bg-white shadow rounded-lg p-12 text-center">
        <i class="fas fa-couch text-5xl text-gray-300 mb-3"></i>
        <p class="text-gray-500 font-medium text-lg">Salle d'attente vide</p>
        <p class="text-gray-400 text-sm">Aucune consultation enregistrée aujourd'hui</p>
    </div>
    <% } %>
</div>
