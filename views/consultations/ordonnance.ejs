<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ordonnance Médicale — <%= patient ? (patient.nom + ' ' + patient.prenom) : 'Patient' %></title>
    <link href="/css/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @page {
            size: A4;
            margin: 10mm;
        }

        @media print {
            body {
                padding: 0 !important;
                margin: 0 !important;
                background: white !important;
                font-size: 12px;
            }
            .no-print {
                display: none !important;
            }
            .ordonnance-box {
                max-width: 100% !important;
                width: 100% !important;
                min-height: 0 !important;
                border: none !important;
                box-shadow: none !important;
                border-radius: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .prescription-zone {
                min-height: 260px !important;
            }
        }

        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }

        .prescription-zone {
            position: relative;
            min-height: 240px;
            background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(248,250,252,0.8));
        }

        .prescription-zone::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(to bottom, rgba(148, 163, 184, 0.15) 1px, transparent 1px);
            background-size: 100% 26px;
            pointer-events: none;
            border-radius: 0.75rem;
        }

        .signature-line {
            display: inline-block;
            width: 180px;
            border-bottom: 1.5px solid #374151;
            margin-top: 40px;
        }
    </style>
</head>
<body class="py-8 px-4">
    <!-- Barre d'actions non imprimable -->
    <div class="max-w-2xl mx-auto mb-6 flex justify-between items-center no-print bg-white p-3 rounded-xl shadow-sm border border-gray-200">
        <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg text-sm inline-flex items-center gap-2 shadow">
            <i class="fas fa-print"></i> Imprimer l'Ordonnance
        </button>
        <button onclick="window.close()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-lg text-sm">
            Fermer
        </button>
    </div>

    <!-- Feuille d'Ordonnance A4 Officielle GSPM -->
    <div class="ordonnance-box max-w-2xl mx-auto bg-white p-8 sm:p-12 rounded-xl shadow-lg border border-gray-200 min-h-[780px] flex flex-col justify-between">
        <div>
            <!-- En-tête officiel militaire -->
            <div class="border-b-2 border-red-700 pb-4 mb-6">
                <div class="flex items-center justify-between">
                    <img src="/images/logo_gspm.jpg" alt="Logo GSPM" class="h-16 w-16 object-contain" onerror="this.style.display='none'">
                    <div class="text-center flex-1 px-4">
                        <h2 class="text-xs font-black tracking-wider uppercase text-gray-800">RÉPUBLIQUE DE CÔTE D'IVOIRE</h2>
                        <p class="text-[10px] uppercase font-bold text-gray-600">MINISTÈRE DE LA DÉFENSE</p>
                        <p class="text-[11px] uppercase font-black text-red-700">GROUPEMENT DE SAPEURS-POMPIERS MILITAIRES</p>
                        <p class="text-[10px] font-bold text-gray-800">CENTRE MÉDICO-SOCIAL / CSA 3<sup>e</sup> COMPAGNIE — BOUAKÉ</p>
                    </div>
                    <img src="/images/logo_defense.jpg" alt="Logo Défense" class="h-16 w-16 object-contain" onerror="this.style.display='none'">
                </div>
            </div>

            <!-- Praticien & Date -->
            <div class="flex justify-between items-start text-xs mb-8 bg-gray-50 p-4 rounded-lg border border-gray-200">
                <div>
                    <span class="text-gray-500 uppercase tracking-wider block text-[10px] font-bold">Médecin / Praticien Prescripteur :</span>
                    <strong class="text-sm font-bold text-gray-900 block mt-0.5"><%= consultation.praticien_nom || 'Médecin de garde' %></strong>
                    <span class="text-gray-600"><%= consultation.praticien_specialite || 'Médecine Générale' %></span>
                    <% if (consultation.praticien_matricule) { %>
                        <span class="block text-gray-500 font-mono text-[11px]">Mle : <%= consultation.praticien_matricule %></span>
                    <% } %>
                </div>
                <div class="text-right">
                    <span class="text-gray-500 uppercase tracking-wider block text-[10px] font-bold">Lieu & Date :</span>
                    <span class="text-sm font-semibold text-gray-800 block mt-0.5">Bouaké, le <%= new Date(consultation.date_entree).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' }) %></span>
                </div>
            </div>

            <!-- Fiche Patient -->
            <div class="border border-gray-300 rounded-lg p-4 mb-8 text-xs grid grid-cols-2 gap-4">
                <div>
                    <span class="text-gray-500">Nom & Prénom(s) :</span>
                    <strong class="text-sm font-bold text-gray-900 block uppercase"><%= patient ? (patient.nom + ' ' + patient.prenom) : '-' %></strong>
                </div>
                <div>
                    <span class="text-gray-500">N° Dossier :</span>
                    <strong class="font-mono text-gray-800 block"><%= patient ? patient.numero_dossier : '-' %></strong>
                </div>
                <% if (patient && patient.date_naissance) { %>
                    <div>
                        <span class="text-gray-500">Âge :</span>
                        <span class="text-gray-800 font-medium block">
                            <%= Math.floor((new Date() - new Date(patient.date_naissance)) / (365.25 * 24 * 60 * 60 * 1000)) %> ans
                        </span>
                    </div>
                <% } %>
                <% if (consultation.vitals && (consultation.vitals.poids || consultation.vitals.tension)) { %>
                    <div>
                        <span class="text-gray-500">Constantes :</span>
                        <span class="text-gray-800 font-medium block">
                            <%= consultation.vitals.poids ? ('Poids: ' + consultation.vitals.poids + ' kg ') : '' %>
                            <%= consultation.vitals.tension ? ('| TA: ' + consultation.vitals.tension) : '' %>
                        </span>
                    </div>
                <% } %>
            </div>

            <!-- Titre ORDONNANCE -->
            <div class="text-center mb-6">
                <h1 class="text-xl font-black tracking-widest uppercase border-b-2 border-gray-900 inline-block pb-1">
                    ORDONNANCE MÉDICALE
                </h1>
            </div>

            <!-- Zone réservée à l'écriture manuscrite des prescriptions par le praticien -->
            <div class="space-y-4 text-sm text-gray-800 px-2">
                <div class="prescription-zone border border-gray-300 rounded-lg bg-white/80 p-3 relative overflow-hidden">
                    <p class="text-[10px] uppercase tracking-wider text-gray-500 mb-2 relative z-10">Prescription manuscrite du praticien</p>
                    <div class="relative z-10 h-[170px] w-full"></div>
                </div>
            </div>
        </div>

        <!-- Bas de page & Signature -->
        <div class="pt-8 border-t border-gray-200 mt-12">
            <div class="flex justify-between items-end px-4">
                <div class="text-[10px] text-gray-500 italic">
                    <p>Ordonnance valable pour délivrance en pharmacie.</p>
                    <p>En cas d'urgence, contacter le CSA 3e Cie GSPM Bouaké.</p>
                </div>
                <div class="text-center">
                    <div class="signature-line"></div>
                    <p class="text-xs font-bold text-gray-800 mt-2">Signature & Cachet du Praticien</p>
                    <p class="text-xs font-semibold text-gray-700 mt-2"><%= consultation.praticien_nom || '' %></p>
                </div>
            </div>

            <div class="text-center text-[9px] text-gray-400 uppercase tracking-widest mt-6 border-t pt-2">
                GROUPEMENT DE SAPEURS-POMPIERS MILITAIRES — SAUVER OU PÉRIR
            </div>
        </div>
    </div>
</body>
</html>
