<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8 max-w-4xl">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Paramètres</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Coordonnées officielles pour factures et documents</p>
        </div>
        <a href="/dashboard" class="text-gray-600 hover:text-gray-900 text-sm font-semibold flex items-center gap-1">
            <i class="fas fa-arrow-left"></i> Tableau de bord
        </a>
    </div>

    <form action="/settings" method="POST" class="bg-white shadow-lg rounded-2xl border border-gray-200 p-4 sm:p-8 space-y-6 sm:space-y-8">
        
        <!-- Informations Générales -->
        <section>
            <h2 class="text-lg font-bold text-gray-800 border-b pb-2 mb-4 flex items-center gap-2">
                <i class="fas fa-clinic-medical text-red-600"></i>
                Identité de l'Établissement
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="md:col-span-2">
                    <label for="nom_clinique" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Nom officiel de l'établissement *
                    </label>
                    <input type="text" id="nom_clinique" name="nom_clinique" required 
                        value="<%= settings.nom_clinique || 'CSA 3e COMPAGNIE GSPM BOUAKE' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm font-semibold text-gray-800 focus:ring-2 focus:ring-red-600 focus:outline-none">
                </div>
                <div>
                    <label for="devise" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Monnaie / Devise
                    </label>
                    <input type="text" id="devise" name="devise" 
                        value="<%= settings.devise || 'FCFA' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
                </div>
                <div>
                    <label for="pays" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Pays
                    </label>
                    <input type="text" id="pays" name="pays" 
                        value="<%= settings.pays || 'Côte d\'Ivoire' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
                </div>
            </div>
        </section>

        <!-- Coordonnées & Localisation -->
        <section>
            <h2 class="text-lg font-bold text-gray-800 border-b pb-2 mb-4 flex items-center gap-2">
                <i class="fas fa-map-marked-alt text-red-600"></i>
                Coordonnées & Localisation
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="ville" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Ville
                    </label>
                    <input type="text" id="ville" name="ville" 
                        value="<%= settings.ville || 'Bouaké' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
                </div>
                <div>
                    <label for="bp" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Boîte Postale (BP)
                    </label>
                    <input type="text" id="bp" name="bp" 
                        value="<%= settings.bp || '' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                        placeholder="Ex: BP 125 Bouaké">
                </div>
                <div class="md:col-span-2">
                    <label for="adresse" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Adresse physique / Localisation
                    </label>
                    <input type="text" id="adresse" name="adresse" 
                        value="<%= settings.adresse || '' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                        placeholder="Ex: Quartier Commerce, Caserne GSPM">
                </div>
            </div>
        </section>

        <!-- Contacts -->
        <section>
            <h2 class="text-lg font-bold text-gray-800 border-b pb-2 mb-4 flex items-center gap-2">
                <i class="fas fa-phone-alt text-red-600"></i>
                Téléphone & Contact
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label for="telephone" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Téléphone Fixe
                    </label>
                    <input type="text" id="telephone" name="telephone" 
                        value="<%= settings.telephone || '' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                        placeholder="+225 ...">
                </div>
                <div>
                    <label for="mobile" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Téléphone Mobile / Urgence
                    </label>
                    <input type="text" id="mobile" name="mobile" 
                        value="<%= settings.mobile || '' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                        placeholder="+225 ...">
                </div>
                <div>
                    <label for="email" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Email officiel
                    </label>
                    <input type="email" id="email" name="email" 
                        value="<%= settings.email || '' %>"
                        class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                        placeholder="contact@gspm.ci">
                </div>
            </div>
        </section>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-end gap-3 pt-4 border-t border-gray-200">
            <a href="/dashboard" class="px-5 py-2.5 border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">
                Annuler
            </a>
            <button type="submit" class="px-6 py-2.5 bg-red-700 hover:bg-red-800 text-white rounded-lg text-sm font-bold shadow transition flex items-center gap-2">
                <i class="fas fa-save"></i>
                Enregistrer les paramètres
            </button>
        </div>
    </form>
</div>
