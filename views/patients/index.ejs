<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">Patients</h1>
        <div class="flex flex-wrap gap-2 w-full sm:w-auto">
            <a id="btnExportExcel" href="/patients/export/excel<%= typeof search !== 'undefined' && search ? '?search=' + encodeURIComponent(search) : '' %>"
               class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm">
                <i class="fas fa-file-excel"></i> Exporter Excel
            </a>
            <a href="/patients/create" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm">
                <i class="fas fa-plus"></i> Nouveau Patient
            </a>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="bg-white p-3 sm:p-4 rounded-lg shadow mb-6">
        <form id="searchForm" action="/patients" method="GET" class="flex flex-col sm:flex-row gap-2 sm:gap-4">
            <input type="text" name="search" placeholder="Nom, prénom, N° dossier..." class="flex-grow border rounded-md px-3 sm:px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" value="<%= typeof search !== 'undefined' ? search : (typeof query !== 'undefined' ? query.search : '') %>">
            <div class="flex gap-2">
                <button type="submit" class="flex-1 sm:flex-none bg-gray-800 hover:bg-gray-900 text-white font-bold py-2 px-4 rounded text-sm">
                    Rechercher
                </button>
                <% if (typeof search !== 'undefined' && search) { %>
                    <a href="/patients" class="bg-gray-100 hover:bg-gray-200 text-gray-600 font-medium py-2 px-3 rounded flex items-center justify-center text-sm">Effacer</a>
                <% } %>
            </div>
        </form>
    </div>

    <!-- Patients Table -->
    <div class="bg-white rounded-lg shadow overflow-x-auto">
        <% if (typeof patients !== 'undefined' && patients.length > 0) { %>
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">N° Dossier</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nom & Prénom</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Téléphone</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ville</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date inscription</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% patients.forEach(patient => { %>
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= patient.numero_dossier %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= patient.nom %> <%= patient.prenom %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= patient.telephone || '-' %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= patient.ville || '-' %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= new Date(patient.created_at).toLocaleDateString('fr-FR') %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="/patients/<%= patient.id %>" class="text-blue-600 hover:text-blue-900 mr-3 inline-flex items-center gap-1 font-semibold">
                                    <i class="fas fa-eye text-xs"></i> Voir
                                </a>
                                <a href="/patients/<%= patient.id %>/edit" class="text-indigo-600 hover:text-indigo-900 mr-3 inline-flex items-center gap-1 font-semibold">
                                    <i class="fas fa-edit text-xs"></i> Modifier
                                </a>
                                <form action="/patients/<%= patient.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce patient ?');">
                                    <button type="submit" class="text-red-600 hover:text-red-900 inline-flex items-center gap-1 font-semibold">
                                        <i class="fas fa-trash-alt text-xs"></i> Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            
            <!-- Pagination -->
            <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div class="px-6 py-3 flex items-center justify-between border-t border-gray-200 bg-white">
                <div class="flex-1 flex justify-between sm:hidden">
                    <% if (currentPage > 1) { %>
                        <a href="/patients?page=<%= currentPage - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">Précédent</a>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="/patients?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">Suivant</a>
                    <% } %>
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Page <span class="font-medium"><%= currentPage %></span> sur <span class="font-medium"><%= totalPages %></span>
                        </p>
                    </div>
                    <div class="flex gap-2">
                        <% if (currentPage > 1) { %>
                            <a href="/patients?page=<%= currentPage - 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">Précédent</a>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="/patients?page=<%= currentPage + 1 %><%= typeof search !== 'undefined' && search ? '&search=' + encodeURIComponent(search) : '' %>" class="px-3 py-1 border border-gray-300 rounded text-sm hover:bg-gray-50">Suivant</a>
                        <% } %>
                    </div>
                </div>
            </div>
            <% } %>
        <% } else { %>
            <div class="p-8 text-center text-gray-500">
                <p class="mb-4">Aucun patient trouvé.</p>
                <a href="/patients/create" class="text-blue-600 hover:underline">Ajouter un nouveau patient</a>
            </div>
        <% } %>
    </div>
</div>

<script>
// Met à jour le lien d'export Excel avec le terme de recherche actif
(function() {
    const btn = document.getElementById('btnExportExcel');
    const form = document.getElementById('searchForm');
    if (!btn || !form) return;
    form.addEventListener('submit', function() {
        const search = form.querySelector('input[name="search"]').value.trim();
        btn.href = '/patients/export/excel' + (search ? '?search=' + encodeURIComponent(search) : '');
    });
})();
</script>
