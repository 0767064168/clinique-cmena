<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Patients</h1>
        <a href="/patients/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            Nouveau Patient
        </a>
    </div>

    <!-- Search Bar -->
    <div class="bg-white p-4 rounded-lg shadow mb-6">
        <form action="/patients" method="GET" class="flex gap-4">
            <input type="text" name="search" placeholder="Rechercher par nom, prénom, N° dossier..." class="flex-grow border rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" value="<%= typeof query !== 'undefined' ? query.search : '' %>">
            <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">
                Rechercher
            </button>
        </form>
    </div>

    <!-- Patients Table -->
    <div class="bg-white rounded-lg shadow overflow-hidden">
        <% if (typeof patients !== 'undefined' && patients.length > 0) { %>
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">N° Dossier</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nom & Prénom</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Téléphone</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ville</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date inscription</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% patients.forEach(patient => { %>
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= patient.numero_dossier %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= patient.nom %> <%= patient.prenom %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= patient.telephone %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= patient.ville %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= new Date(patient.created_at).toLocaleDateString('fr-FR') %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex gap-2">
                                <a href="/patients/<%= patient.id %>" class="text-blue-600 hover:text-blue-900">Voir</a>
                                <a href="/patients/<%= patient.id %>/edit" class="text-indigo-600 hover:text-indigo-900">Modifier</a>
                                <form action="/patients/<%= patient.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce patient ?');">
                                    <button type="submit" class="text-red-600 hover:text-red-900">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            
            <!-- Pagination (Placeholder) -->
            <div class="px-6 py-3 flex items-center justify-between border-t border-gray-200 bg-white">
                <div class="flex-1 flex justify-between sm:hidden">
                    <a href="#" class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">Précédent</a>
                    <a href="#" class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">Suivant</a>
                </div>
                <div class="hidden sm:flex-1 sm:flex sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Affichage de la page <span class="font-medium">1</span>
                        </p>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="p-8 text-center text-gray-500">
                <p class="mb-4">Aucun patient trouvé.</p>
                <a href="/patients/create" class="text-blue-600 hover:underline">Ajouter un nouveau patient</a>
            </div>
        <% } %>
    </div>
</div>
