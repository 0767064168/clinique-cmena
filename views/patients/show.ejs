<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8" x-data="{ tab: 'informations' }">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <h1 class="text-xl sm:text-3xl font-bold text-gray-800">Dossier : <%= patient.nom %> <%= patient.prenom %></h1>
        <div class="flex flex-wrap gap-2 w-full sm:w-auto">
            <a href="/consultations/create?patient_id=<%= patient.id %>" class="flex-1 sm:flex-none text-center bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-3 rounded text-xs sm:text-sm">Consultation</a>
            <a href="/factures/create?patient_id=<%= patient.id %>" class="flex-1 sm:flex-none text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-3 rounded text-xs sm:text-sm">Facture</a>
            <a href="/patients/<%= patient.id %>/edit" class="flex-1 sm:flex-none text-center bg-gray-600 hover:bg-gray-700 text-white font-bold py-2 px-3 rounded text-xs sm:text-sm">Modifier</a>
        </div>
    </div>

    <!-- Tabs Header -->
    <div class="border-b border-gray-200 mb-6 overflow-x-auto">
        <nav class="-mb-px flex gap-4 sm:gap-8 min-w-max">
            <button @click="tab = 'informations'" :class="{'border-blue-500 text-blue-600': tab === 'informations', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': tab !== 'informations'}" class="whitespace-nowrap pb-4 px-1 border-b-2 font-medium text-xs sm:text-sm">Informations</button>
            <button @click="tab = 'chronologie'" :class="{'border-blue-500 text-blue-600': tab === 'chronologie', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': tab !== 'chronologie'}" class="whitespace-nowrap pb-4 px-1 border-b-2 font-medium text-xs sm:text-sm">Chronologie</button>
            <button @click="tab = 'consultations'" :class="{'border-blue-500 text-blue-600': tab === 'consultations', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': tab !== 'consultations'}" class="whitespace-nowrap pb-4 px-1 border-b-2 font-medium text-xs sm:text-sm">Consultations</button>
            <button @click="tab = 'factures'" :class="{'border-blue-500 text-blue-600': tab === 'factures', 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300': tab !== 'factures'}" class="whitespace-nowrap pb-4 px-1 border-b-2 font-medium text-xs sm:text-sm">Factures</button>
        </nav>
    </div>

    <!-- Tab Contents -->
    <div>
        <!-- Informations Tab -->
        <div x-show="tab === 'informations'" class="bg-white shadow rounded-lg p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Profil</h3>
                    <dl class="space-y-3">
                        <div class="flex justify-between"><dt class="text-gray-500">N° Dossier:</dt> <dd class="font-medium"><%= patient.numero_dossier %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Sexe:</dt> <dd class="font-medium"><%= patient.sexe === 'M' ? 'Masculin' : (patient.sexe === 'F' ? 'Féminin' : '-') %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Date de naissance:</dt> <dd class="font-medium"><%= patient.date_naissance ? new Date(patient.date_naissance).toLocaleDateString('fr-FR') : '-' %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Téléphone:</dt> <dd class="font-medium"><%= patient.telephone || '-' %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Ville:</dt> <dd class="font-medium"><%= patient.ville || '-' %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Adresse:</dt> <dd class="font-medium"><%= patient.adresse || '-' %></dd></div>
                    </dl>
                </div>
                <div>
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Médical & Assurance</h3>
                    <dl class="space-y-3">
                        <div class="flex justify-between"><dt class="text-gray-500">Groupe Sanguin:</dt> <dd class="font-medium"><%= patient.groupe_sanguin || '-' %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Allergies:</dt> <dd class="font-medium"><%= patient.allergies || '-' %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Antécédents:</dt> <dd class="font-medium"><%= patient.antecedents || '-' %></dd></div>
                        <hr class="my-2">
                        <div class="flex justify-between"><dt class="text-gray-500">Assurance:</dt> <dd class="font-medium"><%= patient.type_assurance %> <%= patient.assureur ? '- ' + patient.assureur : '' %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">Souscripteur:</dt> <dd class="font-medium"><%= patient.souscripteur || '-' %></dd></div>
                        <div class="flex justify-between"><dt class="text-gray-500">N° Police:</dt> <dd class="font-medium"><%= patient.numero_police || '-' %></dd></div>
                        <hr class="my-2">
                        <div class="flex justify-between"><dt class="text-gray-500">Urgence:</dt> <dd class="font-medium"><%= patient.contact_urgence_nom || '-' %> (<%= patient.contact_urgence_tel || '-' %>)</dd></div>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Chronologie médicale (Timeline combinée Consultations + Factures) -->
        <div x-show="tab === 'chronologie'" style="display: none;" class="bg-white shadow rounded-lg p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-2">
                <i class="fas fa-history text-red-600"></i>
                Historique chronologique du patient
            </h3>
            <% 
                // Fusionner les consultations et factures par ordre antéchronologique
                const events = [];
                (consultations || []).forEach(c => {
                    events.push({
                        type: 'consultation',
                        date: new Date(c.date_entree),
                        title: 'Consultation médicale',
                        praticien: c.praticiens ? (c.praticiens.nom + ' ' + c.praticiens.prenom) : '-',
                        desc: c.motif || 'Sans motif particulier',
                        statut: c.statut,
                        id: c.id
                    });
                });
                (factures || []).forEach(f => {
                    events.push({
                        type: 'facture',
                        date: new Date(f.date_facture),
                        title: 'Facturation N°' + (f.numero_facture || ''),
                        total: f.total_net || 0,
                        reste: f.reste_a_payer || 0,
                        statut: f.statut,
                        id: f.id
                    });
                });
                events.sort((a, b) => b.date - a.date);
            %>
            <% if (events.length > 0) { %>
                <div class="relative border-l-2 border-red-200 ml-4 space-y-8 py-2">
                    <% events.forEach(e => { %>
                        <div class="relative pl-6">
                            <% if (e.type === 'consultation') { %>
                                <span class="absolute -left-3 top-1 flex h-6 w-6 items-center justify-center rounded-full bg-blue-600 text-white text-xs shadow">
                                    <i class="fas fa-stethoscope"></i>
                                </span>
                                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <span class="text-xs font-bold uppercase text-blue-700 tracking-wider">Consultation</span>
                                            <h4 class="font-bold text-gray-900 mt-0.5">Praticien : <%= e.praticien %></h4>
                                            <p class="text-sm text-gray-600 mt-1"><%= e.desc %></p>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-xs font-medium text-gray-500 block"><%= e.date.toLocaleDateString('fr-FR') %></span>
                                            <span class="text-xs px-2 py-0.5 rounded-full mt-1 inline-block font-semibold <%= e.statut === 'termine' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800' %>">
                                                <%= e.statut === 'termine' ? 'Terminée' : 'En cours' %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-right">
                                        <a href="/consultations/<%= e.id %>" class="text-xs text-blue-600 hover:text-blue-800 font-bold inline-flex items-center gap-1">
                                            Voir le détail <i class="fas fa-arrow-right text-[10px]"></i>
                                        </a>
                                    </div>
                                </div>
                            <% } else { %>
                                <span class="absolute -left-3 top-1 flex h-6 w-6 items-center justify-center rounded-full bg-green-600 text-white text-xs shadow">
                                    <i class="fas fa-file-invoice-dollar"></i>
                                </span>
                                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <span class="text-xs font-bold uppercase text-green-700 tracking-wider">Facturation</span>
                                            <h4 class="font-bold text-gray-900 mt-0.5"><%= e.title %></h4>
                                            <p class="text-sm text-gray-800 font-semibold mt-1">Montant : <%= (e.total).toLocaleString('fr-FR') %> FCFA</p>
                                            <% if (e.reste > 0) { %>
                                                <p class="text-xs text-red-600 font-semibold">Reste à régler : <%= (e.reste).toLocaleString('fr-FR') %> FCFA</p>
                                            <% } else { %>
                                                <p class="text-xs text-green-700 font-semibold">Réglée intégralement</p>
                                            <% } %>
                                        </div>
                                        <div class="text-right">
                                            <span class="text-xs font-medium text-gray-500 block"><%= e.date.toLocaleDateString('fr-FR') %></span>
                                            <span class="text-xs px-2 py-0.5 rounded-full mt-1 inline-block font-semibold <%= e.statut === 'payee' ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800' %>">
                                                <%= e.statut === 'payee' ? 'Payée' : e.statut %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="mt-3 text-right flex justify-end gap-3">
                                        <a href="/factures/<%= e.id %>/print" target="_blank" class="text-xs text-gray-600 hover:text-gray-900 font-bold">
                                            <i class="fas fa-print"></i> Imprimer
                                        </a>
                                        <a href="/factures/<%= e.id %>" class="text-xs text-green-700 hover:text-green-900 font-bold inline-flex items-center gap-1">
                                            Consulter <i class="fas fa-arrow-right text-[10px]"></i>
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <p class="text-center text-gray-500 py-8">Aucun événement médical ni facture enregistré pour ce patient.</p>
            <% } %>
        </div>

        <!-- Consultations Tab -->
        <div x-show="tab === 'consultations'" style="display: none;">
            <div class="bg-white shadow rounded-lg overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Praticien</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Motif</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (typeof consultations !== 'undefined' && consultations.length > 0) { %>
                            <% consultations.forEach(consultation => { %>
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= new Date(consultation.date_entree).toLocaleString('fr-FR') %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= consultation.praticiens ? consultation.praticiens.nom + ' ' + consultation.praticiens.prenom : (consultation.praticien_nom || '-') %></td>
                                    <td class="px-6 py-4 text-sm text-gray-500"><%= consultation.motif || '-' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= consultation.statut %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                        <a href="/consultations/<%= consultation.id %>" class="text-blue-600 hover:text-blue-900">Voir</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="5" class="px-6 py-4 text-center text-gray-500">Aucune consultation</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Factures Tab -->
        <div x-show="tab === 'factures'" style="display: none;">
            <div class="bg-white shadow rounded-lg overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">N° Facture</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Montant TTC</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Reste à payer</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if (typeof factures !== 'undefined' && factures.length > 0) { %>
                            <% factures.forEach(facture => { %>
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= facture.numero_facture || '-' %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(facture.date_facture).toLocaleDateString('fr-FR') %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= (facture.total_net || 0).toLocaleString('fr-FR') %> FCFA</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= (facture.reste_a_payer || 0).toLocaleString('fr-FR') %> FCFA</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                            <%= facture.statut === 'payee' ? 'bg-green-100 text-green-800' : 
                                               (facture.statut === 'brouillon' ? 'bg-gray-100 text-gray-800' : 
                                               (facture.statut === 'validee' ? 'bg-blue-100 text-blue-800' : 
                                               (facture.statut === 'partiellement_payee' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'))) %>">
                                            <%= facture.statut %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex gap-2">
                                        <a href="/factures/<%= facture.id %>" class="text-blue-600 hover:text-blue-900">Détails</a>
                                        <a href="/factures/<%= facture.id %>/print" target="_blank" class="text-gray-600 hover:text-gray-900">Imprimer</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="6" class="px-6 py-4 text-center text-gray-500">Aucune facture</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Make sure to include AlpineJS in the layout -->
