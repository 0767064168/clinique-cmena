<div class="space-y-6" x-data="inventaireSaisie">
    <!-- En-tête -->
    <div class="sm:flex sm:items-center sm:justify-between pb-4 border-b border-gray-200">
        <div class="flex items-center gap-3">
            <a href="/pharmacie/inventaires/<%= inv.id %>" class="p-2 text-gray-500 hover:text-gray-700 bg-white rounded-lg border border-gray-300 shadow-sm transition">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-900 flex items-center gap-2">
                    <span class="p-2 bg-amber-500 text-white rounded-lg text-sm">
                        <i class="fas fa-edit"></i>
                    </span>
                    Saisie de Comptage Physique — <%= inv.numero_inventaire %>
                </h1>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                    <%= inv.titre || 'Inventaire Pharmacie' %> — <%= inv.date_inventaire %> &bull; <strong x-text="lignes.length"></strong> articles répertoriés
                </p>
            </div>
        </div>

        <div class="mt-4 sm:mt-0 flex flex-wrap items-center gap-2">
            <button type="button" @click="copierTheorique()" 
                    class="px-3 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold shadow-xs transition">
                <i class="fas fa-magic mr-1"></i> Pré-remplir conforme
            </button>
            <a href="/pharmacie/inventaires/<%= inv.id %>/feuille-comptage" target="_blank" 
               class="px-3 py-2 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 text-gray-700 text-xs font-semibold shadow-xs transition">
                <i class="fas fa-print mr-1"></i> Fiche papier A4
            </a>
            <button type="button" @click="sauvegarder()" :disabled="sauvegardeEnCours"
                    class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-xs sm:text-sm font-bold shadow-md transition inline-flex items-center gap-1.5 cursor-pointer">
                <i class="fas fa-save" :class="sauvegardeEnCours ? 'fa-spin' : ''"></i>
                <span x-text="sauvegardeEnCours ? 'Enregistrement...' : 'Enregistrer la saisie'"></span>
            </button>
        </div>
    </div>

    <!-- Filtres rapides -->
    <div class="bg-white p-4 rounded-xl border border-gray-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="relative w-full sm:w-80">
            <input type="text" x-model="search" placeholder="Filtrer médicament, code, rayon..." 
                   class="w-full rounded-lg border-gray-300 text-xs pl-8 pr-3 py-2 shadow-xs focus:ring-emerald-500 focus:border-emerald-500">
            <i class="fas fa-search absolute left-2.5 top-2.5 text-gray-400 text-xs pointer-events-none"></i>
        </div>

        <div class="inline-flex rounded-lg border border-gray-200 p-0.5 bg-gray-50 text-xs font-semibold w-full sm:w-auto overflow-x-auto">
            <button type="button" @click="filtreEcart = 'tous'" 
                    :class="filtreEcart === 'tous' ? 'bg-white text-gray-900 shadow-xs' : 'text-gray-500'" 
                    class="px-3 py-1 rounded-md transition whitespace-nowrap">
                Tous (<span x-text="lignes.length"></span>)
            </button>
            <button type="button" @click="filtreEcart = 'non_comptes'" 
                    :class="filtreEcart === 'non_comptes' ? 'bg-white text-amber-700 shadow-xs' : 'text-gray-500'" 
                    class="px-3 py-1 rounded-md transition whitespace-nowrap">
                Non comptés
            </button>
            <button type="button" @click="filtreEcart = 'avec_ecart'" 
                    :class="filtreEcart === 'avec_ecart' ? 'bg-white text-red-700 shadow-xs' : 'text-gray-500'" 
                    class="px-3 py-1 rounded-md transition whitespace-nowrap">
                Avec écarts
            </button>
            <button type="button" @click="filtreEcart = 'conformes'" 
                    :class="filtreEcart === 'conformes' ? 'bg-white text-emerald-700 shadow-xs' : 'text-gray-500'" 
                    class="px-3 py-1 rounded-md transition whitespace-nowrap">
                Conformes
            </button>
        </div>
    </div>

    <!-- Table de Saisie Rapide -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-xs sm:text-sm">
                <thead class="bg-gray-50 text-gray-500 uppercase tracking-wider text-[11px] font-semibold">
                    <tr>
                        <th class="px-4 py-3 text-left">Code & Produit</th>
                        <th class="px-4 py-3 text-left">Emplacement</th>
                        <th class="px-4 py-3 text-right">Prix Vente</th>
                        <th class="px-4 py-3 text-center">Stock Théorique</th>
                        <th class="px-4 py-3 text-center w-36">Stock Réel Compté</th>
                        <th class="px-4 py-3 text-center">Écart</th>
                        <th class="px-4 py-3 text-right">Impact Financier</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    <template x-for="(l, idx) in lignesFiltrees" :key="l.id || l.produit_id">
                        <tr class="hover:bg-slate-50 transition"
                            :class="ecartClass(l)">
                            
                            <!-- Produit -->
                            <td class="px-4 py-2.5">
                                <span class="font-bold text-gray-900 block" x-text="l.designation"></span>
                                <span class="text-[10px] text-gray-400 font-mono" x-text="l.code ? '[' + l.code + '] ' + (l.forme || '') : (l.forme || l.categorie)"></span>
                            </td>

                            <!-- Emplacement -->
                            <td class="px-4 py-2.5 text-gray-500 text-xs whitespace-nowrap" x-text="l.emplacement || '-'"></td>

                            <!-- Prix -->
                            <td class="px-4 py-2.5 text-right font-mono text-gray-700 whitespace-nowrap" 
                                x-text="Number(l.prix_vente || 0).toLocaleString('fr-FR') + ' F'"></td>

                            <!-- Stock Théorique -->
                            <td class="px-4 py-2.5 text-center font-mono font-bold text-gray-700 bg-gray-50/60" 
                                x-text="l.stock_theorique"></td>

                            <!-- Saisie Stock Réel -->
                            <td class="px-4 py-2 text-center">
                                <input type="number" min="0" step="1" 
                                       x-model="l.stock_physique" 
                                       placeholder="—"
                                       class="w-24 rounded-lg border-gray-300 py-1.5 text-center font-mono font-black text-sm focus:ring-emerald-500 focus:border-emerald-500 shadow-xs"
                                       :class="l.stock_physique !== null && l.stock_physique !== '' ? 'bg-white' : 'bg-amber-50/70 border-amber-300'">
                            </td>

                            <!-- Écart Calculé -->
                            <td class="px-4 py-2.5 text-center whitespace-nowrap">
                                <template x-if="calculerEcart(l) === null">
                                    <span class="text-[11px] text-gray-400 italic">Non saisi</span>
                                </template>
                                <template x-if="calculerEcart(l) === 0">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-green-100 text-green-800">
                                        0 (Conforme)
                                    </span>
                                </template>
                                <template x-if="calculerEcart(l) > 0">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-black bg-teal-100 text-teal-800">
                                        +<span x-text="calculerEcart(l)"></span> (Surplus)
                                    </span>
                                </template>
                                <template x-if="calculerEcart(l) < 0">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-black bg-red-100 text-red-800">
                                        <span x-text="calculerEcart(l)"></span> (Manquant)
                                    </span>
                                </template>
                            </td>

                            <!-- Impact Financier -->
                            <td class="px-4 py-2.5 text-right font-mono font-bold whitespace-nowrap"
                                :class="impactClass(l)">
                                <template x-if="calculerEcart(l) !== null">
                                    <span x-text="(calculerEcart(l) * Number(l.prix_vente || 0)).toLocaleString('fr-FR') + ' F'"></span>
                                </template>
                                <template x-if="calculerEcart(l) === null">
                                    <span>-</span>
                                </template>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Barre d'Action Flottante en Bas -->
    <div class="sticky bottom-4 bg-slate-900 text-white p-4 rounded-2xl shadow-2xl border border-slate-800 flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-4 text-xs font-medium">
            <span>Articles comptés : <strong class="text-emerald-400" x-text="comptesText"></strong></span>
            <span>Écarts détectés : <strong class="text-amber-400" x-text="nbEcarts"></strong></span>
        </div>
        <div class="flex items-center gap-2">
            <a href="/pharmacie/inventaires/<%= inv.id %>" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold transition">
                Abandonner modifications
            </a>
            <button type="button" @click="sauvegarder()" :disabled="sauvegardeEnCours" 
                    class="px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-black shadow transition inline-flex items-center gap-1.5 cursor-pointer">
                <i class="fas fa-check"></i>
                <span x-text="sauvegardeEnCours ? 'Enregistrement...' : 'Valider la Saisie'"></span>
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('inventaireSaisie', () => ({
        lignes: <%- JSON.stringify(inv.lignes || []) %>,
        search: '',
        filtreEcart: 'tous',
        sauvegardeEnCours: false,

        get lignesFiltrees() {
            return this.lignes.filter(l => {
                const matchSearch = !this.search || 
                    (l.designation && l.designation.toLowerCase().includes(this.search.toLowerCase())) ||
                    (l.code && l.code.toLowerCase().includes(this.search.toLowerCase())) ||
                    (l.emplacement && l.emplacement.toLowerCase().includes(this.search.toLowerCase()));

                if (!matchSearch) return false;

                if (this.filtreEcart === 'non_comptes') {
                    return l.stock_physique === null || l.stock_physique === undefined || l.stock_physique === '';
                }
                if (this.filtreEcart === 'avec_ecart') {
                    const ec = this.calculerEcart(l);
                    return ec !== null && ec !== 0;
                }
                if (this.filtreEcart === 'conformes') {
                    const ec = this.calculerEcart(l);
                    return ec === 0;
                }
                return true;
            });
        },

        get comptesText() {
            const n = this.lignes.filter(l => l.stock_physique !== null && l.stock_physique !== '' && l.stock_physique !== undefined).length;
            return n + ' / ' + this.lignes.length;
        },

        get nbEcarts() {
            return this.lignes.filter(l => {
                const ec = this.calculerEcart(l);
                return ec !== null && ec !== 0;
            }).length;
        },

        calculerEcart(ligne) {
            if (ligne.stock_physique === null || ligne.stock_physique === undefined || ligne.stock_physique === '') return null;
            return Number(ligne.stock_physique) - Number(ligne.stock_theorique || 0);
        },

        ecartClass(l) {
            const ec = this.calculerEcart(l);
            if (ec === null || ec === 0) return '';
            return ec > 0 ? 'bg-teal-50/40' : 'bg-red-50/40';
        },

        impactClass(l) {
            const ec = this.calculerEcart(l);
            if (ec === null) return 'text-gray-400';
            if (ec < 0) return 'text-red-600';
            if (ec > 0) return 'text-teal-600';
            return 'text-gray-400';
        },

        copierTheorique() {
            if (!confirm('Voulez-vous pré-remplir le stock physique avec le stock théorique pour tous les articles non encore comptés ? Vous pourrez ensuite ajuster uniquement ceux ayant un écart.')) return;
            this.lignes.forEach(l => {
                if (l.stock_physique === null || l.stock_physique === undefined || l.stock_physique === '') {
                    l.stock_physique = l.stock_theorique;
                }
            });
        },

        async sauvegarder() {
            this.sauvegardeEnCours = true;
            try {
                const comptages = this.lignes.map(l => ({
                    ligne_id: l.id,
                    produit_id: l.produit_id,
                    stock_physique: (l.stock_physique !== '' && l.stock_physique !== null && l.stock_physique !== undefined) ? Number(l.stock_physique) : null,
                    date_peremption_reelle: l.date_peremption_reelle,
                    notes: l.notes || ''
                }));

                const res = await fetch('/pharmacie/inventaires/<%= inv.id %>/saisie', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ comptages })
                });

                if (!res.ok) throw new Error('Erreur réseau lors de la sauvegarde');
                
                alert('Comptages enregistrés avec succès !');
                window.location.href = '/pharmacie/inventaires/<%= inv.id %>';
            } catch (err) {
                alert('Erreur : ' + err.message);
            } finally {
                this.sauvegardeEnCours = false;
            }
        }
    }));
});
</script>
