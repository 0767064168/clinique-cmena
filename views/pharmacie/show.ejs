<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <a href="/pharmacie" class="text-sm text-emerald-600 hover:text-emerald-800 font-semibold mb-1 inline-flex items-center gap-1">
                <i class="fas fa-arrow-left text-xs"></i> Retour à la pharmacie
            </a>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-gray-900 tracking-tight"><%= produit.designation %></h1>
                <% if (produit.code) { %>
                    <span class="font-mono text-xs font-bold px-2 py-0.5 bg-gray-100 text-gray-700 rounded border border-gray-200"><%= produit.code %></span>
                <% } %>
            </div>
            <% if (produit.forme || produit.dosage) { %>
                <p class="text-xs sm:text-sm text-gray-500 mt-0.5"><%= [produit.forme, produit.dosage].filter(Boolean).join(' — ') %></p>
            <% } %>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <a href="/pharmacie/<%= produit.id %>/edit" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold py-2 px-3 sm:px-4 rounded-lg text-xs sm:text-sm transition">
                <i class="fas fa-edit"></i> Modifier
            </a>
        </div>
    </div>

    <% 
    const today = new Date().toISOString().split('T')[0];
    let diffDays = null;
    if (produit.date_peremption) {
        const expDate = new Date(produit.date_peremption);
        const curDate = new Date();
        expDate.setHours(0, 0, 0, 0);
        curDate.setHours(0, 0, 0, 0);
        diffDays = Math.ceil((expDate - curDate) / (1000 * 60 * 60 * 24));
    }
    const isExpired = diffDays !== null && diffDays < 0;
    const isExpiring30 = diffDays !== null && diffDays >= 0 && diffDays <= 30;
    const isExpiring60 = diffDays !== null && diffDays > 30 && diffDays <= 60;
    const isExpiring90 = diffDays !== null && diffDays > 60 && diffDays <= 90;
    const isLowStock = (produit.stock_actuel || 0) <= (produit.stock_minimum || 0);
    const isOutOfStock = (produit.stock_actuel || 0) <= 0;
    const valeurStock = (produit.stock_actuel || 0) * parseFloat(produit.prix_vente || 0);
    const metrics = typeof stockMetrics !== 'undefined' ? stockMetrics : {
        stock_initial: produit.stock_actuel || 0,
        total_entrees: 0,
        total_sorties: 0,
        stock_restant: produit.stock_actuel || 0
    };
    %>

    <!-- Alertes Péremption -->
    <% if (isExpired) { %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-4 rounded-r-lg">
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 text-xl mr-3"></i>
                <div>
                    <h3 class="text-sm font-bold text-red-800">Attention : Produit Périmé (<%= Math.abs(diffDays) %> jour<%= Math.abs(diffDays) > 1 ? 's' : '' %> de dépassement)</h3>
                    <p class="text-xs text-red-700 mt-0.5">La date de péremption (<%= formatDate(produit.date_peremption) %>) est dépassée. Ce produit ne doit plus être dispensé et doit être isolé pour destruction/retour.</p>
                </div>
            </div>
        </div>
    <% } else if (isExpiring30) { %>
        <div class="bg-rose-50 border-l-4 border-rose-500 p-4 mb-4 rounded-r-lg">
            <div class="flex items-center">
                <i class="fas fa-hourglass-end text-rose-500 text-xl mr-3"></i>
                <div>
                    <h3 class="text-sm font-bold text-rose-800">Alerte Critique : Péremption Imminente (<%= diffDays === 0 ? "Aujourd'hui" : `dans ${diffDays} jour${diffDays > 1 ? 's' : ''}` %>)</h3>
                    <p class="text-xs text-rose-700 mt-0.5">Ce produit périme le <%= formatDate(produit.date_peremption) %>. Veuillez privilégier sa dispensation en priorité absolue (règle FEFO).</p>
                </div>
            </div>
        </div>
    <% } else if (isExpiring60) { %>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-4 rounded-r-lg">
            <div class="flex items-center">
                <i class="fas fa-hourglass-half text-amber-500 text-xl mr-3"></i>
                <div>
                    <h3 class="text-sm font-bold text-amber-800">Avertissement : Péremption Proche (<%= diffDays %> jours restants)</h3>
                    <p class="text-xs text-amber-700 mt-0.5">La date de péremption (<%= formatDate(produit.date_peremption) %>) approche (&le; 60 jours). À surveiller dans les prochaines commandes.</p>
                </div>
            </div>
        </div>
    <% } else if (isExpiring90) { %>
        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4 rounded-r-lg">
            <div class="flex items-center">
                <i class="fas fa-calendar-alt text-yellow-600 text-xl mr-3"></i>
                <div>
                    <h3 class="text-sm font-bold text-yellow-800">Information : Péremption dans <%= diffDays %> jours (&le; 90 jours)</h3>
                    <p class="text-xs text-yellow-700 mt-0.5">La date de péremption est fixée au <%= formatDate(produit.date_peremption) %>.</p>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Alertes Stock -->
    <% if (isOutOfStock) { %>
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg">
            <div class="flex items-center">
                <i class="fas fa-times-circle text-red-500 text-xl mr-3"></i>
                <div>
                    <h3 class="text-sm font-bold text-red-800">Rupture de Stock</h3>
                    <p class="text-xs text-red-700 mt-0.5">Le stock actuel est épuisé (0 <%= produit.unite %>). Veuillez effectuer un réapprovisionnement.</p>
                </div>
            </div>
        </div>
    <% } else if (isLowStock) { %>
        <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-6 rounded-r-lg">
            <div class="flex items-center">
                <i class="fas fa-exclamation-circle text-amber-500 text-xl mr-3"></i>
                <div>
                    <h3 class="text-sm font-bold text-amber-800">Alerte Stock Bas</h3>
                    <p class="text-xs text-amber-700 mt-0.5">Le stock actuel (<%= produit.stock_actuel %> <%= produit.unite %>) est inférieur ou égal au seuil minimum d'alerte (<%= produit.stock_minimum %> <%= produit.unite %>).</p>
                </div>
            </div>
        </div>
    <% } %>

    <!-- 4 Métriques de Stock (Stock Initial, Entrées, Sorties, Restant) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
        <div class="bg-blue-50/80 border border-blue-200 rounded-xl p-4 flex items-center gap-3">
            <div class="flex-shrink-0 h-11 w-11 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg">
                <i class="fas fa-boxes-stacked"></i>
            </div>
            <div>
                <span class="text-[11px] uppercase font-bold text-blue-700 tracking-wider block">Stock Initial</span>
                <span class="text-2xl font-black text-blue-900"><%= metrics.stock_initial %></span>
                <span class="text-xs font-semibold text-blue-600"><%= produit.unite %></span>
            </div>
        </div>
        <div class="bg-emerald-50/80 border border-emerald-200 rounded-xl p-4 flex items-center gap-3">
            <div class="flex-shrink-0 h-11 w-11 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
                <i class="fas fa-arrow-circle-down"></i>
            </div>
            <div>
                <span class="text-[11px] uppercase font-bold text-emerald-700 tracking-wider block">Médicaments Entrés</span>
                <span class="text-2xl font-black text-emerald-700">+<%= metrics.total_entrees %></span>
                <span class="text-xs font-semibold text-emerald-600"><%= produit.unite %></span>
            </div>
        </div>
        <div class="bg-red-50/80 border border-red-200 rounded-xl p-4 flex items-center gap-3">
            <div class="flex-shrink-0 h-11 w-11 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-bold text-lg">
                <i class="fas fa-arrow-circle-up"></i>
            </div>
            <div>
                <span class="text-[11px] uppercase font-bold text-red-700 tracking-wider block">Médicaments Sortis</span>
                <span class="text-2xl font-black text-red-700"><%= metrics.total_sorties > 0 ? '-' + metrics.total_sorties : '0' %></span>
                <span class="text-xs font-semibold text-red-600"><%= produit.unite %></span>
            </div>
        </div>
        <div class="bg-indigo-50/80 border border-indigo-200 rounded-xl p-4 flex items-center gap-3">
            <div class="flex-shrink-0 h-11 w-11 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-lg">
                <i class="fas fa-warehouse"></i>
            </div>
            <div>
                <span class="text-[11px] uppercase font-bold text-indigo-700 tracking-wider block">Médicament Restant</span>
                <span class="text-2xl font-black <%= isOutOfStock ? 'text-red-600' : (isLowStock ? 'text-amber-600' : 'text-indigo-900') %>"><%= metrics.stock_restant %></span>
                <span class="text-xs font-semibold text-indigo-600"><%= produit.unite %></span>
            </div>
        </div>
    </div>

    <!-- Cartes d'informations -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Informations Produit -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 space-y-4">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider flex items-center gap-2 border-b pb-2">
                <i class="fas fa-pills text-emerald-600"></i> Fiche Produit
            </h2>
            <div class="grid grid-cols-2 gap-3 text-sm">
                <div>
                    <span class="text-xs text-gray-500 block uppercase font-medium">Catégorie</span>
                    <span class="font-semibold text-gray-800 capitalize"><%= produit.categorie %></span>
                </div>
                <div>
                    <span class="text-xs text-gray-500 block uppercase font-medium">Forme / Dosage</span>
                    <span class="font-semibold text-gray-800"><%= [produit.forme, produit.dosage].filter(Boolean).join(' ') || '-' %></span>
                </div>
                <div>
                    <span class="text-xs text-gray-500 block uppercase font-medium">Unité de mesure</span>
                    <span class="font-semibold text-gray-800 capitalize"><%= produit.unite %></span>
                </div>
                <div>
                    <span class="text-xs text-gray-500 block uppercase font-medium">Emplacement</span>
                    <span class="font-semibold text-gray-800"><%= produit.emplacement || 'Non spécifié' %></span>
                </div>
                <div>
                    <span class="text-xs text-gray-500 block uppercase font-medium">Fournisseur</span>
                    <span class="font-semibold text-gray-800"><%= produit.fournisseur || 'Non spécifié' %></span>
                </div>
                <div>
                    <span class="text-xs text-gray-500 block uppercase font-medium">Date de péremption</span>
                    <span class="font-semibold <%= isExpired ? 'text-red-600 font-bold' : (isExpiring30 ? 'text-rose-600 font-bold' : (isExpiring60 ? 'text-amber-600 font-bold' : (isExpiring90 ? 'text-yellow-700 font-semibold' : 'text-gray-800'))) %>">
                        <%= produit.date_peremption ? formatDate(produit.date_peremption) : '-' %>
                    </span>
                    <% if (produit.date_peremption) { %>
                        <div class="mt-1">
                            <% if (isExpired) { %>
                                <span class="inline-block px-2 py-0.5 text-xs font-bold rounded-full bg-red-100 text-red-800">
                                    <i class="fas fa-ban mr-1"></i> Périmé (<%= Math.abs(diffDays) %>j)
                                </span>
                            <% } else if (isExpiring30) { %>
                                <span class="inline-block px-2 py-0.5 text-xs font-bold rounded-full bg-rose-100 text-rose-800">
                                    <i class="fas fa-hourglass-end mr-1"></i> &le; 30j (<%= diffDays %>j)
                                </span>
                            <% } else if (isExpiring60) { %>
                                <span class="inline-block px-2 py-0.5 text-xs font-bold rounded-full bg-amber-100 text-amber-800">
                                    <i class="fas fa-hourglass-half mr-1"></i> &le; 60j (<%= diffDays %>j)
                                </span>
                            <% } else if (isExpiring90) { %>
                                <span class="inline-block px-2 py-0.5 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800">
                                    <i class="fas fa-calendar-alt mr-1"></i> &le; 90j (<%= diffDays %>j)
                                </span>
                            <% } else { %>
                                <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800">
                                    <i class="fas fa-check-circle mr-1"></i> Valide (<%= diffDays %>j)
                                </span>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Informations Stock & Finances -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 space-y-4">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider flex items-center gap-2 border-b pb-2">
                <i class="fas fa-chart-bar text-emerald-600"></i> Situation du Stock & Tarifs
            </h2>
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-slate-50 p-3 rounded-lg">
                    <span class="text-xs text-gray-500 block uppercase font-medium">Stock Restant (Actuel)</span>
                    <span class="text-2xl font-black <%= isOutOfStock ? 'text-red-600' : (isLowStock ? 'text-amber-600' : 'text-emerald-700') %>">
                        <%= metrics.stock_restant %>
                    </span>
                    <span class="text-xs font-semibold text-gray-500"><%= produit.unite %></span>
                </div>
                <div class="bg-slate-50 p-3 rounded-lg">
                    <span class="text-xs text-gray-500 block uppercase font-medium">Seuil Minimum</span>
                    <span class="text-2xl font-black text-gray-700"><%= produit.stock_minimum %></span>
                    <span class="text-xs font-semibold text-gray-500"><%= produit.unite %></span>
                </div>
                <div class="bg-slate-50 p-3 rounded-lg">
                    <span class="text-xs text-gray-500 block uppercase font-medium">Prix d'Achat</span>
                    <span class="text-base font-bold text-gray-800"><%= formatMoney(produit.prix_achat) %></span>
                </div>
                <div class="bg-slate-50 p-3 rounded-lg">
                    <span class="text-xs text-gray-500 block uppercase font-medium">Prix de Vente</span>
                    <span class="text-base font-bold text-emerald-700"><%= formatMoney(produit.prix_vente) %></span>
                </div>
            </div>
            <div class="pt-2 border-t flex justify-between items-center text-sm">
                <span class="text-gray-600 font-medium">Valeur totale en stock :</span>
                <span class="text-lg font-black text-emerald-700"><%= formatMoney(valeurStock) %></span>
            </div>
        </div>
    </div>

    <!-- Formulaire d'enregistrement d'un mouvement de stock -->
    <div class="bg-white rounded-xl shadow-md border-t-4 border-emerald-600 p-5 mb-8">
        <h2 class="text-base font-bold text-gray-900 mb-4 flex items-center gap-2">
            <i class="fas fa-exchange-alt text-emerald-600"></i> Enregistrer un Mouvement de Stock
        </h2>
        <form action="/pharmacie/<%= produit.id %>/mouvement" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Type de Mouvement <span class="text-red-500">*</span></label>
                    <div class="grid grid-cols-2 gap-2 p-1 rounded-xl border border-gray-200 bg-gray-100">
                        <label class="relative cursor-pointer">
                            <input type="radio" name="type_mouvement" value="entree" checked class="peer sr-only">
                            <span class="flex items-center justify-center gap-2 w-full rounded-lg border border-transparent bg-emerald-600 text-white font-bold py-2.5 px-3 text-sm shadow-sm transition peer-checked:border-emerald-700 peer-checked:bg-emerald-700 peer-checked:shadow-md peer-focus-visible:ring-2 peer-focus-visible:ring-emerald-500">
                                <i class="fas fa-arrow-up"></i>
                                Entrée
                            </span>
                        </label>
                        <label class="relative cursor-pointer">
                            <input type="radio" name="type_mouvement" value="sortie" class="peer sr-only">
                            <span class="flex items-center justify-center gap-2 w-full rounded-lg border border-transparent bg-red-600 text-white font-bold py-2.5 px-3 text-sm shadow-sm transition peer-checked:border-red-700 peer-checked:bg-red-700 peer-checked:shadow-md peer-focus-visible:ring-2 peer-focus-visible:ring-red-500">
                                <i class="fas fa-arrow-down"></i>
                                Sortie
                            </span>
                        </label>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Quantité (<%= produit.unite %>) <span class="text-red-500">*</span></label>
                    <input type="number" name="quantite" required min="1" placeholder="Ex: 20" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Motif</label>
                    <input type="text" name="motif" placeholder="Approvisionnement, Soins, Dispensation..." class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Référence / Patient</label>
                    <input type="text" name="reference" placeholder="N° Bon, Nom patient..." class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none">
                </div>
            </div>
            <div class="flex justify-end pt-2">
                <button type="submit" class="w-full sm:w-auto px-6 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg text-sm shadow-sm transition">
                    <i class="fas fa-check mr-1"></i> Valider le Mouvement
                </button>
            </div>
        </form>
    </div>

    <!-- Historique des Mouvements de Stock -->
    <div class="bg-white shadow rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-200 flex justify-between items-center bg-gray-50">
            <div class="flex items-center gap-2">
                <h3 class="font-bold text-gray-900 text-sm sm:text-base">Historique des Mouvements</h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-gray-200 text-gray-800">
                    <%= mouvements ? mouvements.length : 0 %>
                </span>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-gray-50 text-xs text-gray-500 uppercase font-semibold">
                    <tr>
                        <th class="px-4 py-3 text-left">Date & Heure</th>
                        <th class="px-4 py-3 text-left">Type</th>
                        <th class="px-4 py-3 text-right">Quantité</th>
                        <th class="px-4 py-3 text-center">Évolution Stock</th>
                        <th class="px-4 py-3 text-left">Motif</th>
                        <th class="px-4 py-3 text-left">Référence</th>
                        <th class="px-4 py-3 text-left">Opérateur</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    <% if (mouvements && mouvements.length > 0) { %>
                        <% mouvements.forEach(m => { %>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-4 py-3 whitespace-nowrap text-xs text-gray-600">
                                    <%= formatDateTime(m.created_at) %>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <% if (m.type_mouvement === 'entree') { %>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-800">
                                            <i class="fas fa-arrow-up text-[10px]"></i> Entrée
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800">
                                            <i class="fas fa-arrow-down text-[10px]"></i> Sortie
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-right font-extrabold <%= m.type_mouvement === 'entree' ? 'text-green-600' : 'text-red-600' %>">
                                    <%= m.type_mouvement === 'entree' ? '+' : '-' %><%= m.quantite %> <%= produit.unite %>
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-center text-xs font-semibold text-gray-600">
                                    <span class="text-gray-400"><%= m.stock_avant %></span>
                                    <i class="fas fa-arrow-right text-[10px] text-gray-400 mx-1"></i>
                                    <span class="text-gray-900 font-bold"><%= m.stock_apres %></span>
                                </td>
                                <td class="px-4 py-3 text-gray-800 text-xs">
                                    <%= m.motif || '-' %>
                                </td>
                                <td class="px-4 py-3 text-gray-600 text-xs">
                                    <%= m.reference || '-' %>
                                </td>
                                <td class="px-4 py-3 text-gray-700 text-xs whitespace-nowrap font-medium">
                                    <%= m.utilisateur_nom || 'Système' %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="px-4 py-8 text-center text-gray-400">
                                <i class="fas fa-history text-2xl mb-1 block text-gray-300"></i>
                                Aucun mouvement de stock enregistré
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
