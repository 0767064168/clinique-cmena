<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Praticiens</h1>
        <a href="/praticiens/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            Nouveau Praticien
        </a>
    </div>

    <% if (typeof praticiens !== 'undefined' && praticiens.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% praticiens.forEach(praticien => { %>
                <div class="bg-white rounded-lg shadow overflow-hidden border border-gray-200 hover:shadow-md transition-shadow duration-200">
                    <div class="p-6">
                        <div class="flex justify-between items-start">
                            <div>
                                <h2 class="text-xl font-bold text-gray-800"><%= praticien.nom %> <%= praticien.prenom %></h2>
                                <p class="text-sm font-medium text-blue-600 mt-1"><%= praticien.specialite %></p>
                            </div>
                            <!-- Status badge - Assuming 'actif' is a boolean or string -->
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= praticien.actif !== false ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                                <%= praticien.actif !== false ? 'Actif' : 'Inactif' %>
                            </span>
                        </div>
                        
                        <div class="mt-4 space-y-2">
                            <div class="flex items-center text-sm text-gray-600">
                                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                <%= praticien.telephone || 'Non renseigné' %>
                            </div>
                            <div class="flex items-center text-sm text-gray-600">
                                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                <%= praticien.email || 'Non renseigné' %>
                            </div>
                        </div>
                    </div>
                    <div class="bg-gray-50 px-6 py-3 border-t flex justify-end gap-3">
                        <a href="/praticiens/<%= praticien.id %>/edit" class="text-indigo-600 hover:text-indigo-900 text-sm font-medium">Modifier</a>
                        <form action="/praticiens/<%= praticien.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce praticien ?');">
                            <button type="submit" class="text-red-600 hover:text-red-900 text-sm font-medium">Supprimer</button>
                        </form>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
            <p class="mb-4">Aucun praticien trouvé.</p>
            <a href="/praticiens/create" class="text-blue-600 hover:underline">Ajouter un nouveau praticien</a>
        </div>
    <% } %>
</div>
