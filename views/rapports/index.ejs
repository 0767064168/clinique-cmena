<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">Rapports d'Activité & Financiers</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">CSA 3<sup>e</sup> Compagnie GSPM Bouaké — Bilan des encaissements et prestations</p>
        </div>
        <div class="flex flex-wrap gap-2 w-full md:w-auto">
            <button onclick="window.print()" class="flex-1 sm:flex-none justify-center bg-gray-800 hover:bg-gray-900 text-white font-bold py-2.5 px-4 rounded-lg inline-flex items-center gap-2 shadow-sm text-sm">
                <i class="fas fa-print"></i> Imprimer
            </button>
            <a href="/dashboard" class="flex-1 sm:flex-none justify-center text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 px-4 rounded-lg text-sm">
                Tableau de bord
            </a>
        </div>
    </div>

    <!-- Période / Filtres -->
    <div class="bg-white p-3 sm:p-5 rounded-xl shadow-sm mb-6 sm:mb-8 border border-gray-200">
        <form action="/rapports" method="GET" class="flex flex-wrap items-end gap-3 sm:gap-4">
            <div class="flex-1 min-w-[140px]">
                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Date Début</label>
                <input type="date" name="date_from" value="<%= date_from %>" required class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="flex-1 min-w-[140px]">
                <label class="block text-xs font-semibold text-gray-600 uppercase mb-1">Date Fin</label>
                <input type="date" name="date_to" value="<%= date_to %>" required class="w-full border rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500">
            </div>
            <div class="w-full sm:w-auto">
                <button type="submit" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-5 rounded-lg text-sm shadow">
                    <i class="fas fa-filter mr-1"></i> Filtrer
                </button>
            </div>
            <!-- Raccourcis rapides -->
            <div class="flex items-center flex-wrap gap-2 text-xs w-full sm:w-auto sm:ml-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-gray-100">
                <span class="text-gray-500 font-medium">Période rapide :</span>
                <% 
                    const now = new Date();
                    const curYear = now.getFullYear();
                    const curMonth = String(now.getMonth() + 1).padStart(2, '0');
                    const lastDay = new Date(curYear, now.getMonth() + 1, 0).getDate();
                %>
                <a href="/rapports?date_from=<%= curYear %>-<%= curMonth %>-01&date_to=<%= curYear %>-<%= curMonth %>-<%= String(lastDay).padStart(2, '0') %>" class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium">Ce mois-ci</a>
                <a href="/rapports?date_from=<%= curYear %>-01-01&date_to=<%= curYear %>-12-31" class="px-2.5 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium">Cette année</a>
            </div>
        </form>
    </div>

    <!-- KPI Grid Financier -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        <!-- Chiffre d'affaires net -->
        <div class="bg-white p-5 rounded-lg shadow border-l-4 border-blue-600">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Facturé Net</p>
                    <p class="text-2xl font-extrabold text-gray-900 mt-1"><%= (stats.totalFactureNet || 0).toLocaleString('fr-FR') %> <span class="text-sm font-normal text-gray-500">FCFA</span></p>
                </div>
                <div class="p-3 bg-blue-50 text-blue-600 rounded-lg">
                    <i class="fas fa-file-invoice-dollar text-xl"></i>
                </div>
            </div>
            <p class="text-xs text-gray-500 mt-2"><%= stats.totalFactures %> facture(s) émise(s)</p>
        </div>

        <!-- Total Encaissé -->
        <div class="bg-white p-5 rounded-lg shadow border-l-4 border-green-600">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Recouvrement / Encaissé</p>
                    <p class="text-2xl font-extrabold text-green-700 mt-1"><%= (stats.totalEncaisse || 0).toLocaleString('fr-FR') %> <span class="text-sm font-normal text-gray-500">FCFA</span></p>
                </div>
                <div class="p-3 bg-green-50 text-green-600 rounded-lg">
                    <i class="fas fa-hand-holding-usd text-xl"></i>
                </div>
            </div>
            <% const tauxRecouvrement = stats.totalFactureNet > 0 ? Math.round((stats.totalEncaisse / stats.totalFactureNet) * 100) : 100; %>
            <p class="text-xs text-gray-500 mt-2">Taux de recouvrement : <strong class="text-green-700"><%= tauxRecouvrement %>%</strong></p>
        </div>

        <!-- Reste à recouvrer -->
        <div class="bg-white p-5 rounded-lg shadow border-l-4 border-red-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Reste à Recouvrer</p>
                    <p class="text-2xl font-extrabold text-red-600 mt-1"><%= (stats.totalResteAPayer || 0).toLocaleString('fr-FR') %> <span class="text-sm font-normal text-gray-500">FCFA</span></p>
                </div>
                <div class="p-3 bg-red-50 text-red-500 rounded-lg">
                    <i class="fas fa-clock text-xl"></i>
                </div>
            </div>
            <p class="text-xs text-gray-500 mt-2">Créances et soldes en attente</p>
        </div>

        <!-- Remises -->
        <div class="bg-white p-5 rounded-lg shadow border-l-4 border-yellow-500">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Remises</p>
                    <p class="text-2xl font-extrabold text-yellow-700 mt-1"><%= (stats.totalRemises || 0).toLocaleString('fr-FR') %> <span class="text-sm font-normal text-gray-500">FCFA</span></p>
                </div>
                <div class="p-3 bg-yellow-50 text-yellow-600 rounded-lg">
                    <i class="fas fa-tags text-xl"></i>
                </div>
            </div>
            <p class="text-xs text-gray-500 mt-2">Réductions accordées</p>
        </div>
    </div>

    <!-- Activité Médicale & Modes de Paiement -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
        <!-- Activité Médicale -->
        <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
            <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="fas fa-stethoscope text-blue-600"></i> Activité Médicale sur la Période
            </h2>
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-gray-50 p-4 rounded-lg text-center">
                    <p class="text-gray-500 text-xs uppercase font-semibold">Total Consultations</p>
                    <p class="text-3xl font-extrabold text-gray-900 mt-1"><%= stats.totalConsultations %></p>
                    <p class="text-xs text-green-600 mt-1"><%= stats.consultationsTerminees %> terminée(s)</p>
                </div>
                <div class="bg-gray-50 p-4 rounded-lg text-center">
                    <p class="text-gray-500 text-xs uppercase font-semibold">Nouveaux Patients</p>
                    <p class="text-3xl font-extrabold text-gray-900 mt-1"><%= stats.nouveauxPatients %></p>
                    <p class="text-xs text-gray-500 mt-1">inscrits sur la période</p>
                </div>
            </div>
            <!-- Répartition des factures par statut -->
            <div class="mt-6">
                <p class="text-xs font-semibold text-gray-600 uppercase mb-3">Répartition des factures</p>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between items-center bg-green-50 p-2 rounded">
                        <span class="font-medium text-green-800">Payées intégralement</span>
                        <span class="font-bold text-green-900"><%= stats.statutsCount.payee || 0 %></span>
                    </div>
                    <div class="flex justify-between items-center bg-blue-50 p-2 rounded">
                        <span class="font-medium text-blue-800">Validées (en attente)</span>
                        <span class="font-bold text-blue-900"><%= stats.statutsCount.validee || 0 %></span>
                    </div>
                    <div class="flex justify-between items-center bg-yellow-50 p-2 rounded">
                        <span class="font-medium text-yellow-800">Partiellement payées</span>
                        <span class="font-bold text-yellow-900"><%= stats.statutsCount.partiellement_payee || 0 %></span>
                    </div>
                    <div class="flex justify-between items-center bg-gray-50 p-2 rounded">
                        <span class="font-medium text-gray-700">Brouillons</span>
                        <span class="font-bold text-gray-900"><%= stats.statutsCount.brouillon || 0 %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Encaissements par Mode de Règlement -->
        <div class="bg-white rounded-lg shadow p-6 border border-gray-200">
            <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="fas fa-cash-register text-green-600"></i> Encaissements par Mode de Règlement
            </h2>
            <div class="space-y-3">
                <div class="flex justify-between items-center p-3 rounded-lg bg-gray-50">
                    <div class="flex items-center gap-3">
                        <span class="p-2 bg-green-100 text-green-700 rounded-md"><i class="fas fa-money-bill-wave"></i></span>
                        <span class="text-sm font-semibold text-gray-800">Espèces</span>
                    </div>
                    <span class="font-bold text-sm text-gray-900"><%= (stats.modesPaiement.especes || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <div class="flex justify-between items-center p-3 rounded-lg bg-gray-50">
                    <div class="flex items-center gap-3">
                        <span class="p-2 bg-blue-100 text-blue-700 rounded-md"><i class="fas fa-mobile-alt"></i></span>
                        <span class="text-sm font-semibold text-gray-800">Mobile Money (Orange/MTN/Wave)</span>
                    </div>
                    <span class="font-bold text-sm text-gray-900"><%= (stats.modesPaiement.mobile_money || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <div class="flex justify-between items-center p-3 rounded-lg bg-gray-50">
                    <div class="flex items-center gap-3">
                        <span class="p-2 bg-indigo-100 text-indigo-700 rounded-md"><i class="fas fa-credit-card"></i></span>
                        <span class="text-sm font-semibold text-gray-800">Carte Bancaire</span>
                    </div>
                    <span class="font-bold text-sm text-gray-900"><%= (stats.modesPaiement.carte || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <div class="flex justify-between items-center p-3 rounded-lg bg-gray-50">
                    <div class="flex items-center gap-3">
                        <span class="p-2 bg-purple-100 text-purple-700 rounded-md"><i class="fas fa-university"></i></span>
                        <span class="text-sm font-semibold text-gray-800">Virement Bancaire</span>
                    </div>
                    <span class="font-bold text-sm text-gray-900"><%= (stats.modesPaiement.virement || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <div class="flex justify-between items-center p-3 rounded-lg bg-gray-50">
                    <div class="flex items-center gap-3">
                        <span class="p-2 bg-yellow-100 text-yellow-700 rounded-md"><i class="fas fa-money-check"></i></span>
                        <span class="text-sm font-semibold text-gray-800">Chèque</span>
                    </div>
                    <span class="font-bold text-sm text-gray-900"><%= (stats.modesPaiement.cheque || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Détail des Factures de la Période -->
    <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-200">
        <div class="px-6 py-4 border-b flex justify-between items-center bg-gray-50">
            <h2 class="text-base font-bold text-gray-800">Détail des Factures de la Période (<%= factures.length %>)</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-xs">
                <thead class="bg-gray-100 uppercase font-semibold text-gray-600">
                    <tr>
                        <th class="px-4 py-3 text-left">N° Facture</th>
                        <th class="px-4 py-3 text-left">Date</th>
                        <th class="px-4 py-3 text-left">Patient</th>
                        <th class="px-4 py-3 text-left">N° Dossier</th>
                        <th class="px-4 py-3 text-right">Total Net</th>
                        <th class="px-4 py-3 text-right">Payé</th>
                        <th class="px-4 py-3 text-right">Reste</th>
                        <th class="px-4 py-3 text-center">Statut</th>
                        <th class="px-4 py-3 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    <% if (factures && factures.length > 0) { %>
                        <% factures.forEach(f => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 font-bold text-blue-600">
                                    <a href="/factures/<%= f.id %>">N°<%= f.numero_facture %></a>
                                </td>
                                <td class="px-4 py-3 text-gray-600"><%= new Date(f.date_facture).toLocaleDateString('fr-FR') %></td>
                                <td class="px-4 py-3 font-medium text-gray-900">
                                    <%= f.patients ? f.patients.nom + ' ' + f.patients.prenom : '-' %>
                                </td>
                                <td class="px-4 py-3 text-gray-500 font-mono"><%= f.patients ? (f.patients.numero_dossier ? 'DOS-' + f.patients.numero_dossier : '-') : '-' %></td>
                                <td class="px-4 py-3 text-right font-bold text-gray-900"><%= (f.total_net || 0).toLocaleString('fr-FR') %> FCFA</td>
                                <td class="px-4 py-3 text-right text-green-700 font-semibold"><%= (f.montant_paye || 0).toLocaleString('fr-FR') %> FCFA</td>
                                <td class="px-4 py-3 text-right text-red-600 font-semibold"><%= (f.reste_a_payer || 0).toLocaleString('fr-FR') %> FCFA</td>
                                <td class="px-4 py-3 text-center">
                                    <% if (f.statut === 'payee') { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-green-100 text-green-800">Payée</span>
                                    <% } else if (f.statut === 'validee') { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-100 text-blue-800">Validée</span>
                                    <% } else if (f.statut === 'partiellement_payee') { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-yellow-100 text-yellow-800">Partielle</span>
                                    <% } else { %>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-gray-100 text-gray-800">Brouillon</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <a href="/factures/<%= f.id %>/print" target="_blank" class="text-gray-600 hover:text-gray-900 font-medium">Imprimer</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="px-4 py-8 text-center text-gray-500">Aucune facture enregistrée sur cette période</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
