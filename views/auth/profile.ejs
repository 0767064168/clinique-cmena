<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8 max-w-4xl">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Mon Profil</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Informations du compte et sécurité</p>
        </div>
        <a href="/dashboard" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-gray-900 text-sm font-semibold bg-gray-100 hover:bg-gray-200 px-3 py-2 rounded-lg transition">
            <i class="fas fa-arrow-left text-xs"></i> Tableau de bord
        </a>
    </div>

    <% 
        const isAdmin = (user.role === 'admin');
        let roleBadge = 'bg-gray-100 text-gray-800 border-gray-200';
        let roleLabel = user.role;
        switch(user.role) {
            case 'admin': roleBadge = 'bg-red-100 text-red-800 border-red-200'; roleLabel = 'Administrateur'; break;
            case 'medecin': roleBadge = 'bg-blue-100 text-blue-800 border-blue-200'; roleLabel = 'Médecin'; break;
            case 'receptionniste': roleBadge = 'bg-emerald-100 text-emerald-800 border-emerald-200'; roleLabel = 'Réceptionniste'; break;
            case 'comptable': roleBadge = 'bg-purple-100 text-purple-800 border-purple-200'; roleLabel = 'Comptable'; break;
            case 'pharmacien': roleBadge = 'bg-amber-100 text-amber-800 border-amber-200'; roleLabel = 'Pharmacien'; break;
        }
    %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Carte Profil -->
        <div class="bg-white shadow-sm rounded-2xl border border-gray-200 p-6 text-center space-y-4">
            <div class="h-24 w-24 mx-auto rounded-full <%= isAdmin ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700' %> flex items-center justify-center font-black text-3xl shadow-inner">
                <%= (user.prenom ? user.prenom[0] : '') + (user.nom ? user.nom[0] : '') %>
            </div>
            <div>
                <h2 class="text-xl font-bold text-gray-900"><%= user.nom %> <%= user.prenom %></h2>
                <p class="text-xs sm:text-sm text-gray-500 font-mono mt-0.5"><%= user.email %></p>
            </div>
            <div>
                <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full border <%= roleBadge %> uppercase tracking-wider">
                    <%= roleLabel %>
                </span>
            </div>
            <div class="pt-4 border-t border-gray-100 text-xs text-gray-400 space-y-1">
                <span>Établissement :</span>
                <p class="font-semibold text-gray-700">CSA 3<sup>e</sup> Compagnie GSPM Bouaké</p>
                <div class="pt-2">
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-green-700 bg-green-50 px-2.5 py-1 rounded-full border border-green-200">
                        <span class="h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
                        Compte Actif
                    </span>
                </div>
            </div>
        </div>

        <!-- Section Mot de passe & Sécurité -->
        <div class="md:col-span-2 bg-white shadow-sm rounded-2xl border border-gray-200 p-5 sm:p-8">
            <% if (isAdmin) { %>
                <!-- CAS 1 : L'UTILISATEUR EST ADMINISTRATEUR (Modification autorisée) -->
                <div class="flex items-center justify-between border-b pb-3 mb-6">
                    <h2 class="text-base sm:text-lg font-bold text-gray-800 flex items-center gap-2">
                        <i class="fas fa-user-shield text-red-600"></i>
                        Sécurité & Mot de passe
                    </h2>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-red-700 bg-red-50 border border-red-200 px-2.5 py-0.5 rounded-full">
                        Accès Admin
                    </span>
                </div>

                <div class="mb-5 p-3.5 bg-blue-50 border-l-4 border-blue-600 rounded-r-lg text-xs text-blue-900 leading-relaxed">
                    <p class="font-semibold mb-1">
                        <i class="fas fa-info-circle mr-1 text-blue-600"></i>
                        Espace réservé à l'administrateur
                    </p>
                    <span>Vous pouvez changer votre mot de passe ici. Pour attribuer ou modifier les mots de passe des autres agents, rendez-vous dans la rubrique <a href="/utilisateurs" class="font-bold underline hover:text-blue-700">Gestion des Utilisateurs</a>.</span>
                </div>

                <form action="/auth/profile/password" method="POST" class="space-y-4 sm:space-y-5">
                    <!-- Mot de passe actuel -->
                    <div>
                        <label for="current_password" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Mot de passe actuel *
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                                <i class="fas fa-key text-sm"></i>
                            </span>
                            <input type="password" id="current_password" name="current_password" required
                                class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                                placeholder="Votre mot de passe actuel">
                            <button type="button" onclick="togglePass('current_password', 'eye-curr')" id="eye-curr"
                                class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600">
                                <i class="fas fa-eye text-sm"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Nouveau mot de passe -->
                    <div>
                        <label for="new_password" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Nouveau mot de passe *
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                                <i class="fas fa-lock text-sm"></i>
                            </span>
                            <input type="password" id="new_password" name="new_password" required minlength="6"
                                class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                                placeholder="Au moins 6 caractères">
                            <button type="button" onclick="togglePass('new_password', 'eye-new')" id="eye-new"
                                class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600">
                                <i class="fas fa-eye text-sm"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Confirmer le nouveau mot de passe -->
                    <div>
                        <label for="confirm_password" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                            Confirmer le nouveau mot de passe *
                        </label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                                <i class="fas fa-check-circle text-sm"></i>
                            </span>
                            <input type="password" id="confirm_password" name="confirm_password" required minlength="6"
                                class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                                placeholder="Répétez le nouveau mot de passe">
                            <button type="button" onclick="togglePass('confirm_password', 'eye-conf')" id="eye-conf"
                                class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600">
                                <i class="fas fa-eye text-sm"></i>
                            </button>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-gray-100 flex flex-col sm:flex-row justify-end">
                        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-red-700 hover:bg-red-800 text-white rounded-lg text-sm font-bold shadow transition inline-flex items-center justify-center gap-2">
                            <i class="fas fa-save"></i>
                            Mettre à jour mon mot de passe
                        </button>
                    </div>
                </form>

            <% } else { %>
                <!-- CAS 2 : L'UTILISATEUR N'EST PAS ADMINISTRATEUR (Mot de passe géré par l'admin) -->
                <div class="flex items-center justify-between border-b pb-3 mb-6">
                    <h2 class="text-base sm:text-lg font-bold text-gray-800 flex items-center gap-2">
                        <i class="fas fa-lock text-gray-500"></i>
                        Sécurité & Accès au compte
                    </h2>
                    <span class="text-[11px] font-bold uppercase tracking-wider text-gray-600 bg-gray-100 border border-gray-200 px-2.5 py-0.5 rounded-full">
                        Accès Utilisateur
                    </span>
                </div>

                <div class="space-y-5">
                    <!-- Bannière d'explication officielle -->
                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 sm:p-6 text-amber-900">
                        <div class="flex items-start gap-4">
                            <div class="h-12 w-12 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 text-xl shadow-sm">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="space-y-2">
                                <h3 class="text-base font-bold text-amber-950">
                                    Gestion centralisée des mots de passe
                                </h3>
                                <p class="text-xs sm:text-sm text-amber-800 leading-relaxed">
                                    Conformément à la politique de sécurité du <strong>CSA 3<sup>e</sup> Compagnie GSPM Bouaké</strong>, la création et la modification des mots de passe des utilisateurs sont gérées exclusivement par l'administrateur du système.
                                </p>
                                <div class="pt-2 text-xs font-semibold text-amber-900 flex items-center gap-1.5">
                                    <i class="fas fa-bell text-amber-600"></i>
                                    <span>Votre mot de passe vous est communiqué directement par l'administrateur.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Procédure en cas de besoin de renouvellement -->
                    <div class="bg-gray-50 rounded-xl p-5 border border-gray-200 space-y-3">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700">
                            Besoin de modifier ou réinitialiser votre mot de passe ?
                        </h4>
                        <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                            Si vous avez oublié votre mot de passe ou souhaitez le renouveler, veuillez contacter directement l'administrateur système de la clinique. Il effectuera la réinitialisation depuis son interface d'administration et vous transmettra votre nouveau mot de passe sécurisé.
                        </p>
                        <div class="flex items-center gap-2 pt-2 text-xs text-gray-500">
                            <i class="fas fa-check-circle text-green-600"></i>
                            <span>Votre session actuelle est sécurisée et active.</span>
                        </div>
                    </div>

                    <!-- Récapitulatif des identifiants -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                        <div class="p-3 bg-white border border-gray-200 rounded-lg">
                            <span class="text-[10px] uppercase font-bold text-gray-400 block">Identifiant de connexion</span>
                            <span class="font-mono text-xs font-semibold text-gray-800"><%= user.email %></span>
                        </div>
                        <div class="p-3 bg-white border border-gray-200 rounded-lg">
                            <span class="text-[10px] uppercase font-bold text-gray-400 block">Rôle assigné</span>
                            <span class="text-xs font-bold text-gray-800"><%= roleLabel %></span>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
function togglePass(inputId, btnId) {
    const input = document.getElementById(inputId);
    const btn = document.getElementById(btnId).querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        btn.classList.remove('fa-eye');
        btn.classList.add('fa-eye-slash');
    } else {
        input.type = 'password';
        btn.classList.remove('fa-eye-slash');
        btn.classList.add('fa-eye');
    }
}
</script>
