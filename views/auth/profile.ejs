<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8 max-w-4xl">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Mon Profil</h1>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Informations et mot de passe</p>
        </div>
        <a href="/dashboard" class="text-gray-600 hover:text-gray-900 text-sm font-semibold flex items-center gap-1">
            <i class="fas fa-arrow-left"></i> Tableau de bord
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Carte Profil -->
        <div class="bg-white shadow-lg rounded-2xl border border-gray-200 p-6 text-center space-y-4">
            <div class="h-24 w-24 mx-auto rounded-full bg-red-100 text-red-700 flex items-center justify-center font-black text-3xl shadow-inner">
                <%= (user.prenom ? user.prenom[0] : '') + (user.nom ? user.nom[0] : '') %>
            </div>
            <div>
                <h2 class="text-xl font-bold text-gray-900"><%= user.nom %> <%= user.prenom %></h2>
                <p class="text-sm text-gray-500 font-mono mt-0.5"><%= user.email %></p>
            </div>
            <div>
                <% 
                    let roleBadge = 'bg-gray-100 text-gray-800';
                    let roleLabel = user.role;
                    switch(user.role) {
                        case 'admin': roleBadge = 'bg-red-100 text-red-800 border border-red-200'; roleLabel = 'Administrateur'; break;
                        case 'medecin': roleBadge = 'bg-blue-100 text-blue-800 border border-blue-200'; roleLabel = 'Médecin'; break;
                        case 'receptionniste': roleBadge = 'bg-emerald-100 text-emerald-800 border border-emerald-200'; roleLabel = 'Réceptionniste'; break;
                        case 'comptable': roleBadge = 'bg-purple-100 text-purple-800 border border-purple-200'; roleLabel = 'Comptable'; break;
                        case 'pharmacien': roleBadge = 'bg-amber-100 text-amber-800 border border-amber-200'; roleLabel = 'Pharmacien'; break;
                    }
                %>
                <span class="px-3 py-1 inline-flex text-xs leading-5 font-bold rounded-full <%= roleBadge %> uppercase tracking-wider">
                    <%= roleLabel %>
                </span>
            </div>
            <div class="pt-4 border-t border-gray-100 text-xs text-gray-400">
                <span>Établissement :</span>
                <p class="font-semibold text-gray-700 mt-0.5">CSA 3<sup>e</sup> Compagnie GSPM Bouaké</p>
            </div>
        </div>

        <!-- Formulaire Modification Mot de Passe -->
        <div class="md:col-span-2 bg-white shadow-lg rounded-2xl border border-gray-200 p-8">
            <h2 class="text-lg font-bold text-gray-800 border-b pb-3 mb-6 flex items-center gap-2">
                <i class="fas fa-lock text-red-600"></i>
                Sécurité & Mot de passe
            </h2>

            <form action="/auth/profile/password" method="POST" class="space-y-5">
                <!-- Mot de passe actuel -->
                <div>
                    <label for="current_password" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Mot de passe actuel *
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                            <i class="fas fa-key text-sm"></i>
                        </span>
                        <input type="password" id="current_password" name="current_password" required
                            class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                            placeholder="Votre mot de passe actuel">
                        <button type="button" onclick="togglePass('current_password', 'eye-curr')" id="eye-curr"
                            class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600">
                            <i class="fas fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Nouveau mot de passe -->
                <div>
                    <label for="new_password" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Nouveau mot de passe *
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                            <i class="fas fa-lock text-sm"></i>
                        </span>
                        <input type="password" id="new_password" name="new_password" required minlength="6"
                            class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                            placeholder="Au moins 6 caractères">
                        <button type="button" onclick="togglePass('new_password', 'eye-new')" id="eye-new"
                            class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600">
                            <i class="fas fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Confirmer le nouveau mot de passe -->
                <div>
                    <label for="confirm_password" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                        Confirmer le nouveau mot de passe *
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                            <i class="fas fa-check-circle text-sm"></i>
                        </span>
                        <input type="password" id="confirm_password" name="confirm_password" required minlength="6"
                            class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                            placeholder="Répétez le nouveau mot de passe">
                        <button type="button" onclick="togglePass('confirm_password', 'eye-conf')" id="eye-conf"
                            class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600">
                            <i class="fas fa-eye text-sm"></i>
                        </button>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="px-6 py-2.5 bg-red-700 hover:bg-red-800 text-white rounded-lg text-sm font-bold shadow transition flex items-center gap-2">
                        <i class="fas fa-save"></i>
                        Mettre à jour mon mot de passe
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function togglePass(inputId, btnId) {
    const input = document.getElementById(inputId);
    const btn = document.getElementById(btnId).querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        btn.classList.remove('fa-eye');
        btn.classList.add('fa-eye-slash');
    } else {
        input.type = 'password';
        btn.classList.remove('fa-eye-slash');
        btn.classList.add('fa-eye');
    }
}
</script>
