<!DOCTYPE html>
<html lang="fr" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Connexion | CSA 3e Compagnie GSPM Bouaké' %></title>
  <link rel="stylesheet" href="/css/tailwind.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
  <style>
    .devise-text { font-family: 'Times New Roman', serif; letter-spacing: 0.2em; font-style: italic; }
    .flag-band div { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .bg-firefighter {
      background-image: linear-gradient(rgba(15, 23, 42, 0.72), rgba(15, 23, 42, 0.78)), url('/images/firefighter_bg.jpg');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 bg-firefighter">
  <div class="max-w-lg w-full bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl border border-white/30 overflow-hidden my-6">
    
    <!-- En-tête officiel GSPM & Ministère de la Défense -->
    <div class="bg-gradient-to-b from-gray-50 to-white pt-6 px-6 pb-4 border-b border-gray-200">
      <div class="flex justify-between items-center mb-3">
        <!-- Logo GSPM -->
        <div class="text-center w-5/12">
          <p class="font-extrabold text-[10px] uppercase text-gray-800 tracking-tight leading-tight">
            GROUPEMENT DE SAPEURS POMPIERS MILITAIRES
          </p>
          <div class="my-2 flex justify-center">
            <img src="/images/logo_gspm.jpg" alt="Logo GSPM" class="h-16 w-auto object-contain drop-shadow-sm">
          </div>
          <p class="font-bold text-[10px] uppercase text-red-800 tracking-tight leading-tight">
            CSA 3<sup>e</sup> COMPAGNIE GSPM
          </p>
        </div>

        <!-- Armoiries Ministère de la Défense -->
        <div class="text-center w-5/12">
          <p class="font-extrabold text-[10px] uppercase text-gray-800 tracking-tight leading-tight">
            RÉPUBLIQUE DE CÔTE D'IVOIRE
          </p>
          <div class="my-2 flex justify-center">
            <img src="/images/logo_defense.jpg" alt="Ministère de la Défense" class="h-16 w-auto object-contain drop-shadow-sm">
          </div>
          <p class="font-bold text-[10px] uppercase text-gray-700 tracking-tight leading-tight">
            MINISTÈRE DE LA DÉFENSE
          </p>
        </div>
      </div>

      <!-- Bande tricolore officielle (Orange, Blanc, Vert) -->
      <div style="border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; padding: 1.5px 0;" class="my-3">
        <div class="flag-band" style="display: flex; height: 5px; width: 100%;">
          <div style="flex: 1; background-color: #f77f00;"></div>
          <div style="flex: 1; background-color: #ffffff; border-left: 1px solid #ddd; border-right: 1px solid #ddd;"></div>
          <div style="flex: 1; background-color: #009e49;"></div>
        </div>
      </div>

      <!-- Titre de l'application -->
      <div class="text-center mt-2">
        <h1 class="text-lg font-black text-slate-800 uppercase tracking-wide">Système de Gestion Médicale & Facturation</h1>
        <p class="text-xs text-slate-500 font-semibold">Centre Médical Militaire — Bouaké</p>
      </div>
    </div>

    <!-- Corps du formulaire -->
    <div class="p-8 pt-6 space-y-6">
      
      <!-- Messages Flash (Erreur / Succès) -->
      <% if (typeof messages !== 'undefined' && messages.error) { %>
        <div class="bg-red-50 border-l-4 border-red-600 p-3.5 rounded-r-lg text-red-800 text-sm flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-red-600 text-base"></i>
          <span><%= messages.error %></span>
        </div>
      <% } else if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-50 border-l-4 border-red-600 p-3.5 rounded-r-lg text-red-800 text-sm flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-red-600 text-base"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof messages !== 'undefined' && messages.success) { %>
        <div class="bg-green-50 border-l-4 border-green-600 p-3.5 rounded-r-lg text-green-800 text-sm flex items-center gap-2">
          <i class="fa-solid fa-circle-check text-green-600 text-base"></i>
          <span><%= messages.success %></span>
        </div>
      <% } %>

      <form class="space-y-5" action="/auth/login" method="POST">
        <!-- Identifiant / Email -->
        <div>
          <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Identifiant ou Adresse Email
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <i class="fa-solid fa-user-shield text-sm"></i>
            </span>
            <input 
              id="email" 
              name="email" 
              type="text" 
              required 
              class="w-full pl-10 pr-3.5 py-2.5 border border-slate-300 rounded-lg text-sm text-slate-800 focus:ring-2 focus:ring-red-600 focus:border-red-600 focus:outline-none transition shadow-sm" 
              placeholder="admin ou admin@gspm.ci"
              autocomplete="username">
          </div>
          <p class="text-[11px] text-slate-400 mt-1">Vous pouvez utiliser votre email ou simplement votre identifiant (ex: <code class="font-mono text-slate-600 bg-slate-100 px-1 py-0.5 rounded">admin</code>)</p>
        </div>

        <!-- Mot de passe -->
        <div>
          <label for="password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
            Mot de passe
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
              <i class="fa-solid fa-lock text-sm"></i>
            </span>
            <input 
              id="password" 
              name="password" 
              type="password" 
              required 
              class="w-full pl-10 pr-10 py-2.5 border border-slate-300 rounded-lg text-sm text-slate-800 focus:ring-2 focus:ring-red-600 focus:border-red-600 focus:outline-none transition shadow-sm" 
              placeholder="••••••••"
              autocomplete="current-password">
            <button 
              type="button" 
              onclick="togglePassword()" 
              class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 focus:outline-none"
              title="Afficher/Masquer le mot de passe">
              <i id="eye-icon" class="fa-solid fa-eye text-sm"></i>
            </button>
          </div>
        </div>

        <!-- Options supplémentaires -->
        <div class="flex items-center justify-between text-xs text-slate-600">
          <label class="flex items-center cursor-pointer select-none">
            <input type="checkbox" name="remember" class="rounded border-slate-300 text-red-600 focus:ring-red-500 mr-2 h-4 w-4">
            <span>Se souvenir de moi</span>
          </label>
          <span class="text-slate-400 font-medium">Session sécurisée</span>
        </div>

        <!-- Bouton de soumission -->
        <div>
          <button 
            type="submit" 
            class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-lg shadow-md text-sm font-bold text-white bg-red-700 hover:bg-red-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-600 transition uppercase tracking-wider">
            <i class="fa-solid fa-right-to-bracket"></i>
            Se connecter
          </button>
        </div>
      </form>
    </div>

    <!-- Pied de page officiel GSPM -->
    <div class="bg-gray-50 border-t border-gray-200 py-3 text-center">
      <p class="devise-text text-xs font-bold text-gray-700 tracking-widest uppercase">
        SAUVER OU PERIR
      </p>
      <p class="text-[10px] text-gray-400 mt-0.5">
        CSA 3<sup>e</sup> Compagnie GSPM Bouaké — Tous droits réservés
      </p>
    </div>

  </div>

  <script>
    function togglePassword() {
      const passwordInput = document.getElementById('password');
      const eyeIcon = document.getElementById('eye-icon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.classList.remove('fa-eye');
        eyeIcon.classList.add('fa-eye-slash');
      } else {
        passwordInput.type = 'password';
        eyeIcon.classList.remove('fa-eye-slash');
        eyeIcon.classList.add('fa-eye');
      }
    }
  </script>
</body>
</html>
