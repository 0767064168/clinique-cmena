<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Erreur Serveur - 500 | CSA CMENA GSPM</title>
    <link rel="stylesheet" href="/css/tailwind.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
</head>
<body class="h-full flex items-center justify-center p-4">
    <div class="max-w-md w-full text-center bg-white rounded-2xl shadow-xl border border-slate-200 p-8 space-y-6">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-50 text-red-600 text-3xl shadow-inner">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div>
            <span class="text-xs font-black text-red-600 uppercase tracking-widest">Erreur 500</span>
            <h1 class="text-2xl font-black text-gray-900 mt-1">Erreur interne du serveur</h1>
            <p class="text-sm text-gray-500 mt-2">Un problème inattendu est survenu lors du traitement de votre requête.</p>
        </div>
        <% if (typeof error !== 'undefined' && error && error.message) { %>
            <div class="text-left bg-red-50 p-3 rounded-lg border border-red-200 text-xs text-red-800 font-mono overflow-x-auto">
                <%= error.message %>
            </div>
        <% } %>
        <div class="pt-2">
            <a href="/" class="inline-flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow transition">
                <i class="fas fa-home text-xs"></i>
                <span>Retour au tableau de bord</span>
            </a>
        </div>
        <p class="text-[11px] text-gray-400">Clinique Médico-Chirurgicale NANAN (CMENA) — CSA GSPM 3e Cie</p>
    </div>
</body>
</html>
