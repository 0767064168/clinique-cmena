<!DOCTYPE html>
<html lang="fr" class="bg-gray-50 h-full antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- typeof pageTitle !== 'undefined' ? pageTitle + ' - ' : '' %>CSA 3e Compagnie GSPM Bouaké</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome (Local) -->
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <!-- Tailwind CSS (Pré-compilé et minifié) -->
    <link rel="stylesheet" href="/css/tailwind.min.css">
    <!-- Styles personnalisés CMENA -->
    <link rel="stylesheet" href="/css/styles.css">
    <!-- Alpine.js (Local, zéro dépendance Internet) -->
    <script defer src="/vendor/alpine/alpine.min.js"></script>
    <!-- Script principal CMENA -->
    <script defer src="/js/main.js"></script>
    <style>
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="h-full font-sans text-gray-900"
      x-data="{ sidebarOpen: false, isDesktop: window.matchMedia('(min-width: 768px)').matches }"
      @resize.window.debounce.100ms="isDesktop = window.matchMedia('(min-width: 768px)').matches"
      @keydown.escape.window="if (sidebarOpen) { sidebarOpen = false; $nextTick(() => $refs.mobileMenuTrigger.focus()) }">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-gray-900 focus:shadow-lg">
        Passer au contenu principal
    </a>

    <!-- Sidebar -->
    <%- include('partials/sidebar') %>

    <!-- Main Content -->
    <div class="flex flex-col flex-1 h-full md:pl-64 transition-all duration-300">
        <!-- Header -->
        <%- include('partials/header') %>

        <!-- Main Area -->
        <main id="main-content" tabindex="-1" class="flex-1 pb-8">
            <div class="px-2 sm:px-6 lg:px-8 mt-4 sm:mt-8">
                <!-- Flash Messages -->
                <% if (typeof messages !== 'undefined') { %>
                    <% if (messages.success && messages.success.length > 0) { %>
                        <div class="mb-4 bg-green-50 border-l-4 border-green-500 p-4 rounded-md shadow-sm">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-check-circle text-green-400"></i>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-green-700"><%= messages.success %></p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    <% if (messages.error && messages.error.length > 0) { %>
                        <div class="mb-4 bg-red-50 border-l-4 border-red-500 p-4 rounded-md shadow-sm">
                            <div class="flex">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-exclamation-circle text-red-400"></i>
                                </div>
                                <div class="ml-3">
                                    <p class="text-sm text-red-700"><%= messages.error %></p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% } %>

                <%- body %>
            </div>
        </main>
        
        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200 mt-auto py-4">
            <div class="px-4 sm:px-6 lg:px-8 text-center text-sm text-gray-500">
                &copy; <%= new Date().getFullYear() %> CSA 3e Compagnie GSPM Bouaké - Groupement de Sapeurs Pompiers Militaires. Tous droits réservés.
            </div>
        </footer>
    </div>
</body>
</html>
