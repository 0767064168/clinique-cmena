<div class="container mx-auto px-4 py-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Gestion des Utilisateurs</h1>
            <p class="text-sm text-gray-500 mt-1">Créez et gérez les comptes d'accès pour le personnel du CSA GSPM</p>
        </div>
        <a href="/utilisateurs/create" class="inline-flex items-center gap-2 bg-red-700 hover:bg-red-800 text-white font-bold py-2.5 px-4 rounded-lg shadow transition">
            <i class="fas fa-user-plus"></i>
            Nouvel Utilisateur
        </a>
    </div>

    <!-- Filtres & Recherche -->
    <div class="bg-white p-4 rounded-xl shadow border border-gray-200 mb-6">
        <form action="/utilisateurs" method="GET" class="flex flex-wrap gap-4 items-end">
            <div class="flex-grow min-w-[220px]">
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Rechercher</label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="search" placeholder="Nom, prénom, email..." 
                        class="w-full pl-9 pr-3 py-2 border rounded-md text-sm focus:ring-2 focus:ring-red-600 focus:outline-none"
                        value="<%= query && query.search ? query.search : '' %>">
                </div>
            </div>
            <div class="w-48">
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Rôle</label>
                <select name="role" class="w-full border rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
                    <option value="">Tous les rôles</option>
                    <option value="admin" <%= query && query.role === 'admin' ? 'selected' : '' %>>Administrateur</option>
                    <option value="medecin" <%= query && query.role === 'medecin' ? 'selected' : '' %>>Médecin</option>
                    <option value="receptionniste" <%= query && query.role === 'receptionniste' ? 'selected' : '' %>>Réceptionniste</option>
                    <option value="comptable" <%= query && query.role === 'comptable' ? 'selected' : '' %>>Comptable</option>
                    <option value="pharmacien" <%= query && query.role === 'pharmacien' ? 'selected' : '' %>>Pharmacien</option>
                </select>
            </div>
            <div class="w-36">
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Statut</label>
                <select name="actif" class="w-full border rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-red-600 focus:outline-none">
                    <option value="">Tous</option>
                    <option value="true" <%= query && query.actif === 'true' ? 'selected' : '' %>>Actif</option>
                    <option value="false" <%= query && query.actif === 'false' ? 'selected' : '' %>>Inactif</option>
                </select>
            </div>
            <button type="submit" class="bg-gray-800 hover:bg-gray-900 text-white font-semibold py-2 px-4 rounded-md text-sm transition">
                Filtrer
            </button>
            <a href="/utilisateurs" class="text-sm text-gray-500 hover:text-gray-800 px-2 py-2">
                Réinitialiser
            </a>
        </form>
    </div>

    <!-- Tableau des Utilisateurs -->
    <div class="bg-white rounded-xl shadow border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Utilisateur</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Email / Identifiant</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Rôle</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Créé le</th>
                    <th class="px-6 py-3.5 text-right text-xs font-bold text-gray-600 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% if (typeof utilisateurs !== 'undefined' && utilisateurs.length > 0) { %>
                    <% utilisateurs.forEach(u => { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="h-10 w-10 flex-shrink-0 rounded-full bg-red-100 text-red-700 flex items-center justify-center font-bold text-sm">
                                        <%= (u.prenom ? u.prenom[0] : '') + (u.nom ? u.nom[0] : '') %>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-bold text-gray-900"><%= u.nom %> <%= u.prenom %></div>
                                        <div class="text-xs text-gray-500">ID: <%= u.id.slice(0, 8) %>...</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                                <span class="font-mono bg-gray-100 px-2 py-1 rounded text-xs"><%= u.email %></span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <% 
                                    let roleBadge = 'bg-gray-100 text-gray-800';
                                    let roleLabel = u.role;
                                    switch(u.role) {
                                        case 'admin': roleBadge = 'bg-red-100 text-red-800 border border-red-200'; roleLabel = 'Administrateur'; break;
                                        case 'medecin': roleBadge = 'bg-blue-100 text-blue-800 border border-blue-200'; roleLabel = 'Médecin'; break;
                                        case 'receptionniste': roleBadge = 'bg-emerald-100 text-emerald-800 border border-emerald-200'; roleLabel = 'Réceptionniste'; break;
                                        case 'comptable': roleBadge = 'bg-purple-100 text-purple-800 border border-purple-200'; roleLabel = 'Comptable'; break;
                                        case 'pharmacien': roleBadge = 'bg-amber-100 text-amber-800 border border-amber-200'; roleLabel = 'Pharmacien'; break;
                                    }
                                %>
                                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= roleBadge %>">
                                    <%= roleLabel %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <% if (u.actif) { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                                        <span class="h-1.5 w-1.5 rounded-full bg-green-600"></span> Actif
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                                        <span class="h-1.5 w-1.5 rounded-full bg-gray-400"></span> Inactif
                                    </span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <%= u.created_at ? new Date(u.created_at).toLocaleDateString('fr-FR') : '-' %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex justify-end items-center gap-2">
                                    <!-- Bouton toggle actif -->
                                    <form action="/utilisateurs/<%= u.id %>/toggle-actif" method="POST" class="inline">
                                        <button type="submit" 
                                            class="text-xs px-2.5 py-1 rounded border <%= u.actif ? 'border-amber-300 text-amber-700 hover:bg-amber-50' : 'border-green-300 text-green-700 hover:bg-green-50' %> font-medium transition"
                                            title="<%= u.actif ? 'Désactiver le compte' : 'Activer le compte' %>">
                                            <%= u.actif ? 'Désactiver' : 'Activer' %>
                                        </button>
                                    </form>

                                    <!-- Bouton Modifier -->
                                    <a href="/utilisateurs/<%= u.id %>/edit" class="text-blue-600 hover:text-blue-900 px-2 py-1" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <!-- Bouton Supprimer -->
                                    <form action="/utilisateurs/<%= u.id %>?_method=DELETE" method="POST" class="inline" 
                                        onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement cet utilisateur ?');">
                                        <button type="submit" class="text-red-600 hover:text-red-900 px-2 py-1" title="Supprimer">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                            <i class="fas fa-users-slash text-3xl text-gray-300 mb-2 block"></i>
                            Aucun utilisateur trouvé.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
