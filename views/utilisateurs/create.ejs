<div class="container mx-auto px-4 py-8 max-w-3xl">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Nouvel Utilisateur</h1>
            <p class="text-sm text-gray-500 mt-1">Créer un nouveau compte d'accès pour un agent de la clinique</p>
        </div>
        <a href="/utilisateurs" class="text-gray-600 hover:text-gray-900 text-sm font-semibold flex items-center gap-1">
            <i class="fas fa-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <form action="/utilisateurs" method="POST" class="bg-white shadow-lg rounded-2xl border border-gray-200 p-8 space-y-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Nom -->
            <div>
                <label for="nom" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                    Nom de famille *
                </label>
                <input type="text" id="nom" name="nom" required 
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm uppercase focus:ring-2 focus:ring-red-600 focus:outline-none" 
                    placeholder="Ex: KOUASSI">
            </div>

            <!-- Prénom -->
            <div>
                <label for="prenom" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                    Prénom(s) *
                </label>
                <input type="text" id="prenom" name="prenom" required 
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none" 
                    placeholder="Ex: Jean-Marc">
            </div>

            <!-- Email ou Identifiant -->
            <div class="md:col-span-2">
                <label for="email" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                    Identifiant / Email de connexion *
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                        <i class="fas fa-at text-sm"></i>
                    </span>
                    <input type="text" id="email" name="email" required 
                        class="w-full pl-10 pr-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none" 
                        placeholder="Ex: jm.kouassi ou jm.kouassi@gspm.ci">
                </div>
                <p class="text-[11px] text-gray-500 mt-1">Si vous écrivez simplement un identifiant sans arobase (ex: <code class="bg-gray-100 px-1 py-0.5 rounded font-mono">jm.kouassi</code>), le suffixe <code class="font-mono">@gspm.ci</code> sera automatiquement appliqué.</p>
            </div>

            <!-- Rôle -->
            <div>
                <label for="role" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                    Rôle / Fonction *
                </label>
                <select id="role" name="role" required 
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none bg-white">
                    <option value="receptionniste">Réceptionniste / Accueil</option>
                    <option value="medecin">Médecin / Praticien</option>
                    <option value="comptable">Comptable / Facturation</option>
                    <option value="pharmacien">Pharmacien</option>
                    <option value="admin">Administrateur système</option>
                </select>
            </div>

            <!-- Statut initial -->
            <div>
                <label for="actif" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                    Statut du compte
                </label>
                <select id="actif" name="actif" 
                    class="w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none bg-white">
                    <option value="true">Actif (Accès autorisé)</option>
                    <option value="false">Inactif (Accès bloqué)</option>
                </select>
            </div>

            <!-- Mot de passe initial -->
            <div class="md:col-span-2">
                <label for="password" class="block text-xs font-bold text-gray-700 uppercase mb-1">
                    Mot de passe initial *
                </label>
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
                        <i class="fas fa-lock text-sm"></i>
                    </span>
                    <input type="password" id="password" name="password" required minlength="6"
                        class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-600 focus:outline-none" 
                        placeholder="Au moins 6 caractères (ex: Pompier@2026)">
                    <button type="button" onclick="togglePass('password', 'eye-btn')" id="eye-btn" 
                        class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600">
                        <i class="fas fa-eye text-sm"></i>
                    </button>
                </div>
                <p class="text-[11px] text-gray-500 mt-1">Transmettez ce mot de passe de manière sécurisée à l'agent concerné.</p>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-200">
            <a href="/utilisateurs" class="px-5 py-2.5 border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">
                Annuler
            </a>
            <button type="submit" class="px-6 py-2.5 bg-red-700 hover:bg-red-800 text-white rounded-lg text-sm font-bold shadow transition flex items-center gap-2">
                <i class="fas fa-check"></i>
                Créer l'utilisateur
            </button>
        </div>
    </form>
</div>

<script>
function togglePass(inputId, btnId) {
    const input = document.getElementById(inputId);
    const btn = document.getElementById(btnId).querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        btn.classList.remove('fa-eye');
        btn.classList.add('fa-eye-slash');
    } else {
        input.type = 'password';
        btn.classList.remove('fa-eye-slash');
        btn.classList.add('fa-eye');
    }
}
</script>
