<!-- Quick actions & Accès Rapides -->
<% const dashRole = (typeof user !== 'undefined' && user) ? user.role : 'admin'; %>
<div class="mb-6 flex flex-wrap gap-2.5">
    <% if (['admin', 'medecin', 'receptionniste'].includes(dashRole)) { %>
    <a href="/patients/create" class="inline-flex items-center gap-x-2 rounded-lg bg-primary px-3.5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-primary-light transition">
        <i class="fas fa-user-plus"></i> Nouveau Patient
    </a>
    <a href="/consultations/create" class="inline-flex items-center gap-x-2 rounded-lg bg-white px-3.5 py-2 text-xs sm:text-sm font-semibold text-gray-800 shadow-sm border border-gray-300 hover:bg-gray-50 transition">
        <i class="fas fa-stethoscope text-green-600"></i> Nouvelle Consultation
    </a>
    <a href="/consultations/attente" class="inline-flex items-center gap-x-2 rounded-lg bg-amber-500 hover:bg-amber-600 px-3.5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm transition">
        <i class="fas fa-hourglass-half"></i> Salle d'Attente
    </a>
    <% } %>

    <% if (['admin', 'comptable'].includes(dashRole)) { %>
    <a href="/factures/create" class="inline-flex items-center gap-x-2 rounded-lg bg-blue-600 hover:bg-blue-700 px-3.5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm transition">
        <i class="fas fa-file-invoice"></i> Nouvelle Facture
    </a>
    <a href="/caisse" class="inline-flex items-center gap-x-2 rounded-lg bg-green-600 hover:bg-green-700 px-3.5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm transition">
        <i class="fas fa-cash-register"></i> Caisse du Jour
    </a>
    <% } %>

    <% if (['admin', 'pharmacien'].includes(dashRole)) { %>
    <a href="/pharmacie/create" class="inline-flex items-center gap-x-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3.5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm transition">
        <i class="fas fa-pills"></i> Nouveau Produit
    </a>
    <% } %>
</div>

<!-- Stats Grid -->
<dl class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5 mb-8">
    <!-- Stat 1 -->
    <div class="relative overflow-hidden rounded-lg bg-white px-4 pb-12 pt-5 shadow sm:px-6 sm:pt-6 border-t-4 border-blue-500">
        <dt>
            <div class="absolute rounded-md bg-blue-50 p-3">
                <i class="fas fa-users text-blue-500 text-xl w-6 text-center"></i>
            </div>
            <p class="ml-16 truncate text-sm font-medium text-gray-500">Total Patients</p>
        </dt>
        <dd class="ml-16 flex items-baseline pb-6 sm:pb-7">
            <p class="text-2xl font-semibold text-gray-900">
                <%= typeof stats !== 'undefined' ? stats.totalPatients : '1 245' %>
            </p>
            <div class="absolute inset-x-0 bottom-0 bg-gray-50 px-4 py-4 sm:px-6">
                <div class="text-sm">
                    <a href="/patients" class="font-medium text-primary hover:text-primary-light">Voir tous<span class="sr-only"> les patients</span></a>
                </div>
            </div>
        </dd>
    </div>

    <!-- Stat 2 -->
    <div class="relative overflow-hidden rounded-lg bg-white px-4 pb-12 pt-5 shadow sm:px-6 sm:pt-6 border-t-4 border-green-500">
        <dt>
            <div class="absolute rounded-md bg-green-50 p-3">
                <i class="fas fa-stethoscope text-green-500 text-xl w-6 text-center"></i>
            </div>
            <p class="ml-16 truncate text-sm font-medium text-gray-500">Consultations Aujourd'hui</p>
        </dt>
        <dd class="ml-16 flex items-baseline pb-6 sm:pb-7">
            <p class="text-2xl font-semibold text-gray-900">
                <%= typeof stats !== 'undefined' ? stats.consultationsToday : '12' %>
            </p>
            <div class="absolute inset-x-0 bottom-0 bg-gray-50 px-4 py-4 sm:px-6">
                <div class="text-sm">
                    <a href="/consultations" class="font-medium text-primary hover:text-primary-light">Gérer l'agenda</a>
                </div>
            </div>
        </dd>
    </div>

    <!-- Stat 3 -->
    <div class="relative overflow-hidden rounded-lg bg-white px-4 pb-12 pt-5 shadow sm:px-6 sm:pt-6 border-t-4 border-red-500">
        <dt>
            <div class="absolute rounded-md bg-red-50 p-3">
                <i class="fas fa-file-invoice-dollar text-red-500 text-xl w-6 text-center"></i>
            </div>
            <p class="ml-16 truncate text-sm font-medium text-gray-500">Factures Impayées / En Attente</p>
        </dt>
        <dd class="ml-16 pb-6 sm:pb-7">
            <div class="flex items-baseline gap-2">
                <p class="text-2xl font-semibold text-gray-900">
                    <%= typeof stats !== 'undefined' ? stats.facturesImpayees : 0 %>
                </p>
                <% if (typeof stats !== 'undefined' && stats.totalMontantImpaye > 0) { %>
                    <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800">
                        <%= new Intl.NumberFormat('fr-FR').format(stats.totalMontantImpaye) %> FCFA dûs
                    </span>
                <% } %>
            </div>
            <div class="absolute inset-x-0 bottom-0 bg-gray-50 px-4 py-4 sm:px-6">
                <div class="text-sm">
                    <a href="/factures?statut=validee" class="font-medium text-red-600 hover:text-red-700 flex items-center gap-1">
                        <i class="fas fa-arrow-right text-xs"></i> Relancer les factures en attente
                    </a>
                </div>
            </div>
        </dd>
    </div>

    <!-- Stat 4 -->
    <div class="relative overflow-hidden rounded-lg bg-white px-4 pb-12 pt-5 shadow sm:px-6 sm:pt-6 border-t-4 border-yellow-500">
        <dt>
            <div class="absolute rounded-md bg-yellow-50 p-3">
                <i class="fas fa-coins text-yellow-500 text-xl w-6 text-center"></i>
            </div>
            <p class="ml-16 truncate text-sm font-medium text-gray-500">Revenus du Mois</p>
        </dt>
        <dd class="ml-16 flex items-baseline pb-6 sm:pb-7">
            <p class="text-2xl font-semibold text-gray-900">
                <%= typeof stats !== 'undefined' ? new Intl.NumberFormat('fr-FR').format(stats.revenusMois) : '2 450 000' %> FCFA
            </p>
            <div class="absolute inset-x-0 bottom-0 bg-gray-50 px-4 py-4 sm:px-6">
                <div class="text-sm">
                    <a href="/rapports" class="font-medium text-primary hover:text-primary-light">Voir les rapports</a>
                </div>
            </div>
        </dd>
    </div>

    <!-- Stat 5 -->
    <div class="relative overflow-hidden rounded-lg bg-white px-4 pb-12 pt-5 shadow sm:px-6 sm:pt-6 border-t-4 border-emerald-500">
        <dt>
            <div class="absolute rounded-md bg-emerald-50 p-3">
                <i class="fas fa-pills text-emerald-500 text-xl w-6 text-center"></i>
            </div>
            <p class="ml-16 truncate text-sm font-medium text-gray-500">Pharmacie & Stock</p>
        </dt>
        <dd class="ml-16 pb-6 sm:pb-7">
            <div class="flex flex-col gap-2">
                <p class="text-2xl font-semibold text-gray-900">
                    <%= typeof stats !== 'undefined' ? stats.pharmacieTotal : 0 %> produits
                </p>
                <% if (typeof stats !== 'undefined') { %>
                    <p class="text-xs text-gray-500">
                        Valeur stock : <%= new Intl.NumberFormat('fr-FR').format(stats.pharmacieValeur || 0) %> FCFA
                    </p>
                <% } %>
                <% if (typeof stats !== 'undefined' && stats.pharmacieAlerte > 0) { %>
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800 w-fit">
                        <%= stats.pharmacieAlerte %> alertes
                    </span>
                <% } %>
                <% if (typeof stats !== 'undefined' && stats.produitsPerimes > 0) { %>
                    <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-700 w-fit">
                        <%= stats.produitsPerimes %> périmés
                    </span>
                <% } %>
            </div>
            <div class="absolute inset-x-0 bottom-0 bg-gray-50 px-4 py-4 sm:px-6">
                <div class="text-sm">
                    <a href="/pharmacie" class="font-medium text-emerald-600 hover:text-emerald-700">Gérer le stock</a>
                </div>
            </div>
        </dd>
    </div>
</dl>

<!-- Alertes stock -->
<% if (typeof stockAlerts !== 'undefined' && stockAlerts.length > 0) { %>
<div class="mb-8 bg-white shadow rounded-xl border border-amber-200 p-5">
    <div class="flex items-center justify-between mb-4">
        <div>
            <h3 class="text-lg font-semibold text-gray-900">Alertes de stock</h3>
            <p class="text-sm text-gray-500">Produits sous le seuil d'alerte</p>
        </div>
        <a href="/pharmacie?stock_alert=oui" class="text-sm font-semibold text-amber-700 hover:text-amber-800">Voir tout</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-3">
        <% stockAlerts.forEach(item => { %>
            <a href="/pharmacie/<%= item.id %>" class="block rounded-lg border border-amber-200 bg-amber-50 p-3 hover:bg-amber-100 transition">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wide text-amber-700">Alerte</span>
                    <span class="text-xs font-semibold text-amber-800"><%= item.stock_disponible %> / <%= item.seuil %></span>
                </div>
                <p class="mt-2 text-sm font-semibold text-gray-900 truncate"><%= item.designation %></p>
                <p class="mt-1 text-xs text-gray-600"><%= item.categorie %></p>
            </a>
        <% }) %>
    </div>
</div>
<% } %>

<!-- Tables Grid -->
<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <!-- Recent Products -->
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Produits récents</h3>
            <a href="/pharmacie" class="text-sm text-emerald-600 hover:text-emerald-700">Voir tout</a>
        </div>
        <div class="overflow-hidden">
            <ul role="list" class="divide-y divide-gray-200">
                <% if (typeof recentProducts !== 'undefined' && recentProducts.length > 0) { %>
                    <% recentProducts.forEach(product => { %>
                        <li>
                            <a href="/pharmacie/<%= product.id %>" class="block hover:bg-gray-50">
                                <div class="px-4 py-4 sm:px-6">
                                    <div class="flex items-center justify-between">
                                        <p class="text-sm font-medium text-emerald-700 truncate"><%= product.designation %></p>
                                        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800">
                                            <%= product.stock_actuel %> <%= product.unite || 'unités' %>
                                        </span>
                                    </div>
                                    <div class="mt-2 flex items-center justify-between text-sm text-gray-500">
                                        <span><%= product.categorie || 'Produit' %></span>
                                        <span><%= product.code || 'Sans code' %></span>
                                    </div>
                                </div>
                            </a>
                        </li>
                    <% }) %>
                <% } else { %>
                    <li class="px-4 py-6 text-sm text-gray-500">Aucun produit récent enregistré.</li>
                <% } %>
            </ul>
        </div>
    </div>
    <!-- Recent Patients -->
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Patients Récents</h3>
            <a href="/patients" class="text-sm text-primary hover:text-primary-light">Tout voir</a>
        </div>
        <div class="overflow-hidden">
            <ul role="list" class="divide-y divide-gray-200">
                <% if (typeof recentPatients !== 'undefined' && recentPatients.length > 0) { %>
                    <% recentPatients.forEach(patient => { %>
                        <li>
                            <a href="/patients/<%= patient.id %>" class="block hover:bg-gray-50">
                                <div class="px-4 py-4 sm:px-6">
                                    <div class="flex items-center justify-between">
                                        <p class="text-sm font-medium text-primary truncate"><%= patient.nom %> <%= patient.prenom %></p>
                                        <div class="ml-2 flex-shrink-0 flex">
                                            <p class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                                N° <%= patient.numero_dossier || '-' %>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="mt-2 sm:flex sm:justify-between">
                                        <div class="sm:flex">
                                            <p class="flex items-center text-sm text-gray-500">
                                                <i class="fas fa-phone mr-1.5 text-gray-400"></i>
                                                <%= patient.telephone %>
                                            </p>
                                        </div>
                                        <div class="mt-2 flex items-center text-sm text-gray-500 sm:mt-0">
                                            <i class="fas fa-calendar mr-1.5 text-gray-400"></i>
                                            <p>Ajouté le <time datetime="<%= patient.created_at %>"><%= new Date(patient.created_at).toLocaleDateString('fr-FR') %></time></p>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </li>
                    <% }) %>
                <% } else { %>
                    <li class="px-4 py-8 text-center text-gray-500 text-sm">
                        Aucun patient récent
                    </li>
                <% } %>
            </ul>
        </div>
    </div>

    <!-- Recent Factures -->
    <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Dernières Factures</h3>
            <a href="/factures" class="text-sm text-primary hover:text-primary-light">Tout voir</a>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">N° Facture</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Montant</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% if (typeof recentFactures !== 'undefined' && recentFactures.length > 0) { %>
                        <% recentFactures.forEach(facture => { %>
                            <tr class="hover:bg-gray-50 cursor-pointer" onclick="window.location.href='/factures/<%= facture.id %>'">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= facture.numero_facture || '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= facture.patient_nom %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-medium">
                                    <%= new Intl.NumberFormat('fr-FR').format(facture.total_net || 0) %> FCFA
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (facture.statut === 'payee') { %>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Payée</span>
                                    <% } else if (facture.statut === 'validee') { %>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Validée</span>
                                    <% } else if (facture.statut === 'partiellement_payee') { %>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Partielle</span>
                                    <% } else if (facture.statut === 'brouillon') { %>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">Brouillon</span>
                                    <% } else { %>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Annulée</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="4" class="px-6 py-8 text-center text-gray-500 text-sm">
                                Aucune facture récente
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
