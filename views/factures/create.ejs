<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8" x-data="invoiceForm()">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">Nouvelle Facture</h1>
        <a href="/factures" class="text-gray-600 hover:text-gray-900 font-medium text-sm">← Retour</a>
    </div>

    <form action="/factures" method="POST" class="bg-white shadow rounded-lg p-4 sm:p-6 space-y-6 sm:space-y-8">

        <!-- Informations Générales -->
        <section>
            <h2 class="text-xl font-semibold border-b pb-2 mb-4">Informations Générales</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Patient *</label>
                    <select name="patient_id" required class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Sélectionner un patient...</option>
                        <% if (typeof patients !== 'undefined') { %>
                            <% patients.forEach(p => { %>
                                <option value="<%= p.id %>" <%= selectedConsultation && selectedConsultation.patient_id == p.id ? 'selected' : '' %>><%= p.numero_dossier %> — <%= p.nom %> <%= p.prenom %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Consultation liée</label>
                    <select name="consultation_id" class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Aucune (Optionnel)</option>
                        <% if (typeof consultations !== 'undefined') { %>
                            <% consultations.forEach(c => { %>
                                <option value="<%= c.id %>" <%= selectedConsultation && selectedConsultation.id == c.id ? 'selected' : '' %>>
                                    <%= new Date(c.date_entree).toLocaleDateString('fr-FR') %> — <%= c.patients ? c.patients.nom + ' ' + c.patients.prenom : '?' %> (<%= c.motif || 'sans motif' %>)
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Remise (FCFA)</label>
                    <input type="number" name="remise" x-model.number="remise" min="0" value="0"
                        class="w-full border rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500"
                        @input="calculateTotals()">
                </div>
            </div>
        </section>

        <!-- Lignes de facturation -->
        <section>
            <div class="flex justify-between items-center border-b pb-2 mb-4">
                <h2 class="text-xl font-semibold">Détails des prestations</h2>
                <button type="button" @click="addRow" class="text-sm bg-green-50 text-green-600 border border-green-200 px-3 py-1 rounded hover:bg-green-100">+ Ajouter une ligne</button>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Libellé</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase w-32">Nom praticien</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase w-28">P.U. (FCFA)</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase w-16">Qté</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase w-16">%</th>
                            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase w-28">Montant</th>
                            <th class="px-2 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <template x-for="(row, index) in rows" :key="index">
                            <tr>
                                <td class="px-2 py-2">
                                    <input type="text" x-model="row.libelle" :name="`libelle`" required class="w-full border rounded px-2 py-1 text-sm" placeholder="Ex: Consultation générale">
                                </td>
                                <td class="px-2 py-2">
                                    <input type="text" x-model="row.nom_praticien" :name="`nom_praticien`" class="w-full border rounded px-2 py-1 text-sm">
                                </td>
                                <td class="px-2 py-2">
                                    <input type="number" x-model.number="row.prix_unitaire" :name="`prix_unitaire`" min="0" required class="w-full border rounded px-2 py-1 text-sm text-right" @input="calculateTotals()">
                                </td>
                                <td class="px-2 py-2">
                                    <input type="number" x-model.number="row.quantite" :name="`quantite`" min="1" required class="w-full border rounded px-2 py-1 text-sm text-right" @input="calculateTotals()">
                                </td>
                                <td class="px-2 py-2">
                                    <input type="number" x-model.number="row.pourcentage" :name="`pourcentage`" min="0" max="100" class="w-full border rounded px-2 py-1 text-sm text-right" @input="calculateTotals()">
                                </td>
                                <td class="px-2 py-2 text-right text-sm font-medium bg-gray-50" x-text="rowMontant(row).toLocaleString('fr-FR') + ' FCFA'"></td>
                                <td class="px-2 py-2 text-center">
                                    <button type="button" @click="removeRow(index)" class="text-red-500 hover:text-red-700" x-show="rows.length > 1">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Lignes d'ordonnance / Médicaments -->
        <section>
            <div class="flex justify-between items-center border-b pb-2 mb-4">
                <div class="flex items-center gap-2">
                    <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 text-xs font-bold">
                        <i class="fas fa-pills"></i>
                    </span>
                    <h2 class="text-xl font-semibold text-gray-800">Ordonnance & Médicaments</h2>
                </div>
                <button type="button" @click="addOrdonnanceRow" 
                    class="text-sm bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1 rounded hover:bg-emerald-100 font-medium transition inline-flex items-center gap-1">
                    <i class="fas fa-plus text-xs"></i> Ajouter une ligne
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-3 py-3 text-center text-xs font-bold text-gray-500 uppercase w-12">N°</th>
                            <th class="px-4 py-3 text-left text-xs font-bold text-gray-500 uppercase">Dénomination</th>
                            <th class="px-4 py-3 text-center text-xs font-bold text-gray-500 uppercase w-24">Quantité</th>
                            <th class="px-4 py-3 text-right text-xs font-bold text-gray-500 uppercase w-36">Coût unitaire (FCFA)</th>
                            <th class="px-4 py-3 text-right text-xs font-bold text-gray-500 uppercase w-36">Coût Total</th>
                            <th class="px-2 py-3 w-12"></th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <template x-for="(row, index) in ordonnanceRows" :key="'ord-' + index">
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-3 py-2 text-center text-sm font-bold text-gray-500" x-text="index + 1"></td>
                                <td class="px-2 py-2">
                                    <input type="text" x-model="row.denomination" name="ord_denomination" list="produits-pharmacie-list"
                                        @change="onProductSelect(row)" @input="calculateTotals()"
                                        class="w-full border rounded px-3 py-1.5 text-sm focus:ring-2 focus:ring-emerald-500" 
                                        placeholder="Ex: Paracétamol 500mg, Amoxicilline 1g...">
                                </td>
                                <td class="px-2 py-2">
                                    <input type="number" x-model.number="row.quantite" name="ord_quantite" min="1"
                                        class="w-full border rounded px-2 py-1.5 text-sm text-center focus:ring-2 focus:ring-emerald-500" 
                                        @input="calculateTotals()">
                                </td>
                                <td class="px-2 py-2">
                                    <input type="number" x-model.number="row.cout_unitaire" name="ord_cout_unitaire" min="0" step="1"
                                        class="w-full border rounded px-2 py-1.5 text-sm text-right focus:ring-2 focus:ring-emerald-500" 
                                        @input="calculateTotals()">
                                </td>
                                <td class="px-4 py-2 text-right text-sm font-bold text-emerald-800 bg-emerald-50/30" 
                                    x-text="((Number(row.quantite) || 0) * (Number(row.cout_unitaire) || 0)).toLocaleString('fr-FR') + ' FCFA'">
                                </td>
                                <td class="px-2 py-2 text-center">
                                    <button type="button" @click="removeOrdonnanceRow(index)" 
                                        class="text-red-500 hover:text-red-700 p-1 rounded hover:bg-red-50 transition" 
                                        title="Supprimer cette ligne">
                                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        </template>
                        <tr x-show="ordonnanceRows.length === 0">
                            <td colspan="6" class="px-4 py-4 text-center text-xs text-gray-400 bg-gray-50/50 italic">
                                Aucun médicament ajouté. Cliquez sur "+ Ajouter une ligne" pour prescrire/facturer des médicaments.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Datalist pour autocomplétion des médicaments -->
            <datalist id="produits-pharmacie-list">
                <% if (typeof produits !== 'undefined' && produits.length > 0) { %>
                    <% produits.forEach(prod => { %>
                        <option value="<%= prod.designation %>" label="<%= prod.prix_vente ? prod.prix_vente + ' FCFA' : '' %> <%= prod.stock_actuel !== undefined ? '(En stock : ' + prod.stock_actuel + ')' : '' %>"></option>
                    <% }); %>
                <% } %>
            </datalist>
        </section>

        <!-- Totaux -->
        <section class="flex justify-end">
            <div class="w-full md:w-5/12 lg:w-4/12 bg-gray-50 p-4 rounded-xl border border-gray-200 space-y-3">
                <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-600 font-medium">Prestations médicales :</span>
                    <span class="text-gray-900 font-semibold" x-text="total_prestations.toLocaleString('fr-FR') + ' FCFA'"></span>
                </div>
                <div class="flex justify-between items-center text-sm" x-show="total_ordonnance > 0">
                    <span class="text-gray-600 font-medium">Ordonnance & Médicaments :</span>
                    <span class="text-emerald-700 font-semibold" x-text="total_ordonnance.toLocaleString('fr-FR') + ' FCFA'"></span>
                </div>
                <div class="flex justify-between items-center text-sm border-t border-gray-200 pt-2">
                    <span class="text-gray-700 font-bold">Total brut :</span>
                    <span class="text-gray-900 font-bold" x-text="total_brut.toLocaleString('fr-FR') + ' FCFA'"></span>
                </div>
                <div class="flex justify-between items-center text-sm">
                    <span class="text-gray-600 font-medium">Remise (FCFA) :</span>
                    <span class="text-amber-700 font-semibold" x-text="(remise || 0).toLocaleString('fr-FR') + ' FCFA'"></span>
                </div>
                <div class="flex justify-between items-center text-lg font-black border-t-2 border-gray-300 pt-2 text-blue-700">
                    <span>Total Net à payer :</span>
                    <span x-text="total_net.toLocaleString('fr-FR') + ' FCFA'"></span>
                </div>
            </div>
        </section>

        <!-- Boutons -->
        <div class="flex justify-end gap-4 border-t pt-4">
            <a href="/factures" class="px-4 py-2 border rounded-md text-gray-700 hover:bg-gray-50">Annuler</a>
            <button type="submit" name="action" value="brouillon" class="px-4 py-2 border border-blue-300 rounded-md text-blue-700 hover:bg-blue-50">Enregistrer comme brouillon</button>
            <button type="submit" name="action" value="valider" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 font-bold">Valider la facture</button>
        </div>
    </form>
</div>

<script>
    function invoiceForm() {
        const catalogProduits = <%- JSON.stringify(typeof produits !== 'undefined' ? produits : []) %>;

        return {
            rows: [
                { libelle: '', nom_praticien: '', prix_unitaire: 0, quantite: 1, pourcentage: 100 }
            ],
            ordonnanceRows: [
                { denomination: '', quantite: 1, cout_unitaire: 0 }
            ],
            remise: 0,
            total_prestations: 0,
            total_ordonnance: 0,
            total_brut: 0,
            total_net: 0,

            addRow() {
                this.rows.push({ libelle: '', nom_praticien: '', prix_unitaire: 0, quantite: 1, pourcentage: 100 });
                this.calculateTotals();
            },

            removeRow(index) {
                this.rows.splice(index, 1);
                this.calculateTotals();
            },

            addOrdonnanceRow() {
                this.ordonnanceRows.push({ denomination: '', quantite: 1, cout_unitaire: 0 });
                this.calculateTotals();
            },

            removeOrdonnanceRow(index) {
                this.ordonnanceRows.splice(index, 1);
                this.calculateTotals();
            },

            onProductSelect(row) {
                if (!row.denomination) return;
                const searchStr = row.denomination.trim().toLowerCase();
                const found = catalogProduits.find(p => p.designation && p.designation.toLowerCase() === searchStr);
                if (found && (!row.cout_unitaire || row.cout_unitaire === 0)) {
                    row.cout_unitaire = Number(found.prix_vente || 0);
                }
                this.calculateTotals();
            },

            rowMontant(row) {
                return Math.round((Number(row.prix_unitaire) || 0) * (Number(row.quantite) || 1) * ((row.pourcentage !== undefined ? Number(row.pourcentage) : 100) / 100));
            },

            calculateTotals() {
                let prestTotal = 0;
                this.rows.forEach(r => {
                    prestTotal += (Number(r.prix_unitaire) || 0) * (Number(r.quantite) || 1) * ((r.pourcentage !== undefined ? Number(r.pourcentage) : 100) / 100);
                });
                this.total_prestations = Math.round(prestTotal);

                let ordTotal = 0;
                this.ordonnanceRows.forEach(o => {
                    if (o.denomination && o.denomination.trim() !== '') {
                        ordTotal += (Number(o.cout_unitaire) || 0) * (Number(o.quantite) || 1);
                    }
                });
                this.total_ordonnance = Math.round(ordTotal);

                this.total_brut = this.total_prestations + this.total_ordonnance;
                this.total_net = Math.max(0, this.total_brut - (Number(this.remise) || 0));
            }
        };
    }
</script>
