<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">Facture N°<%= facture.numero_facture %></h1>
        <div class="flex flex-wrap gap-2 w-full sm:w-auto">
            <% if (facture.statut === 'brouillon') { %>
                <form action="/factures/<%= facture.id %>/valider?_method=PUT" method="POST" class="inline flex-1 sm:flex-none">
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm">
                        <i class="fas fa-check-circle mr-1"></i> Valider
                    </button>
                </form>
            <% } %>

            <% if (facture.statut !== 'brouillon' && facture.statut !== 'annulee' && (facture.reste_a_payer || 0) > 0) { %>
                <button type="button" class="flex-1 sm:flex-none bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm" onclick="document.getElementById('payment-modal').classList.remove('hidden')">
                    <i class="fas fa-money-bill-wave mr-1"></i> Encaisser
                </button>
            <% } %>

            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                <!-- Boutons d'administration avancée -->
                <% if (facture.statut === 'validee' || facture.statut === 'partiellement_payee') { %>
                    <button type="button" class="flex-1 sm:flex-none bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm" onclick="document.getElementById('modal-marquer-payee').classList.remove('hidden')" title="Marquer directement comme payée (Admin)">
                        <i class="fas fa-badge-check mr-1"></i> Marquer Payée (Admin)
                    </button>
                <% } %>

                <% if (facture.statut === 'validee' && (!facture.montant_paye || Number(facture.montant_paye) === 0)) { %>
                    <form action="/factures/<%= facture.id %>/brouillon?_method=PUT" method="POST" class="inline flex-1 sm:flex-none" onsubmit="return confirm('Confirmez-vous le retour au statut brouillon pour modification ?');">
                        <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm" title="Repasser en brouillon pour modifier (Admin)">
                            <i class="fas fa-undo mr-1"></i> Repasser Brouillon
                        </button>
                    </form>
                <% } %>

                <% if (facture.statut !== 'annulee') { %>
                    <form action="/factures/<%= facture.id %>/annuler" method="POST" class="inline flex-1 sm:flex-none" onsubmit="return confirm('Êtes-vous sûr de vouloir ANNULER cette facture ? Cette action est irréversible.');">
                        <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm" title="Annuler la facture (Admin)">
                            <i class="fas fa-ban mr-1"></i> Annuler Facture
                        </button>
                    </form>
                <% } %>
            <% } %>

            <a href="/factures/<%= facture.id %>/print" target="_blank" class="flex-1 sm:flex-none text-center bg-gray-800 hover:bg-gray-900 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm">
                <i class="fas fa-print mr-1"></i> Imprimer
            </a>
            <a href="/factures" class="flex-1 sm:flex-none text-center bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm">
                Retour
            </a>
        </div>
    </div>

    <!-- Statut alert -->
    <% 
        let alertClass = 'bg-gray-50 border-gray-200 text-gray-800';
        let statutMsg = 'Brouillon';
        if (facture.statut === 'validee') { alertClass = 'bg-blue-50 border-blue-200 text-blue-800'; statutMsg = 'Validée (En attente de paiement)'; }
        if (facture.statut === 'payee') { alertClass = 'bg-green-50 border-green-200 text-green-800'; statutMsg = 'Payée intégralement'; }
        if (facture.statut === 'partiellement_payee') { alertClass = 'bg-yellow-50 border-yellow-200 text-yellow-800'; statutMsg = 'Partiellement payée (Reste: ' + (facture.reste_a_payer || 0).toLocaleString('fr-FR') + ' FCFA)'; }
        if (facture.statut === 'annulee') { alertClass = 'bg-red-50 border-red-200 text-red-800'; statutMsg = 'Annulée'; }
    %>
    <div class="border rounded-md p-3 sm:p-4 mb-6 <%= alertClass %> flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <div>
            <span class="font-bold">Statut :</span> <%= statutMsg %>
        </div>
        <div class="font-bold text-lg">
            Total : <%= (facture.total_net || 0).toLocaleString('fr-FR') %> FCFA
        </div>
    </div>

    <!-- Infos patient, praticien et consultation -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white shadow rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-3">Patient</h2>
            <% if (facture.patients) { %>
                <p class="text-gray-900 font-medium text-base"><%= facture.patients.nom %> <%= facture.patients.prenom %></p>
                <p class="text-gray-500 text-sm">N° Dossier : <%= facture.patients.numero_dossier %></p>
                <% if (facture.patients.telephone) { %><p class="text-gray-500 text-sm">Tél : <%= facture.patients.telephone %></p><% } %>
            <% } else { %>
                <p class="text-gray-400">—</p>
            <% } %>
        </div>
        <div class="bg-white shadow rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-3">Praticien</h2>
            <% 
                const praticienShow = (facture.consultations && facture.consultations.praticiens) ? facture.consultations.praticiens : null;
            %>
            <% if (praticienShow) { %>
                <p class="text-gray-900 font-medium text-base"><%= praticienShow.nom %> <%= praticienShow.prenom %></p>
                <p class="text-gray-600 text-sm">Matricule : <strong class="text-gray-900"><%= praticienShow.matricule || 'Non renseigné' %></strong></p>
                <% if (praticienShow.specialite) { %><p class="text-gray-500 text-sm">Spécialité : <%= praticienShow.specialite %></p><% } %>
            <% } else { %>
                <p class="text-gray-500 text-sm">Médecin traitant non assigné</p>
            <% } %>
        </div>
        <div class="bg-white shadow rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-3">Consultation & Suivi</h2>
            <% if (facture.consultations) { %>
                <p class="text-gray-500 text-sm">Date entrée : <strong class="text-gray-700"><%= new Date(facture.consultations.date_entree).toLocaleDateString('fr-FR') %></strong></p>
                <p class="text-gray-500 text-sm">Date sortie : <strong class="text-gray-700"><%= facture.consultations.date_sortie ? new Date(facture.consultations.date_sortie).toLocaleDateString('fr-FR') : 'Non renseignée' %></strong></p>
                <% if (facture.consultations.motif) { %><p class="text-gray-500 text-sm mt-1">Motif : <%= facture.consultations.motif %></p><% } %>
            <% } else { %>
                <p class="text-gray-400">Aucune consultation liée</p>
            <% } %>
            <div class="mt-2 pt-2 border-t border-gray-100 text-xs text-gray-500">
                Éditeur : <strong class="text-gray-700"><%= (typeof editeur !== 'undefined' && editeur) ? (editeur.nom + ' ' + editeur.prenom) : 'Système' %></strong>
            </div>
        </div>
    </div>

    <!-- Détails des Prestations -->
    <% 
        const prestations = (lignes || []).filter(l => l.type_ligne !== 'ordonnance');
        const ordonnances = (lignes || []).filter(l => l.type_ligne === 'ordonnance');
    %>

    <% if (prestations.length > 0) { %>
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
        <div class="px-6 py-4 border-b bg-blue-50/50 flex items-center gap-2">
            <i class="fas fa-file-medical text-blue-600"></i>
            <h2 class="text-lg font-semibold text-gray-700">Détails des Prestations</h2>
            <span class="ml-auto text-xs font-bold text-blue-600 bg-blue-100 px-2 py-0.5 rounded-full"><%= prestations.length %> ligne(s)</span>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Désignation</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Praticien</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Qté</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">P.U. (FCFA)</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">%</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Montant (FCFA)</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% prestations.forEach((l, idx) => { %>
                    <tr class="<%= idx % 2 === 0 ? '' : 'bg-gray-50/50' %> hover:bg-blue-50/30 transition">
                        <td class="px-6 py-3 text-sm font-medium text-gray-900"><%= l.libelle %></td>
                        <td class="px-4 py-3 text-sm text-gray-600"><%= l.nom_praticien || '—' %></td>
                        <td class="px-4 py-3 text-sm text-center text-gray-700 font-semibold"><%= l.quantite %></td>
                        <td class="px-4 py-3 text-sm text-right text-gray-700"><%= (l.prix_unitaire || 0).toLocaleString('fr-FR') %></td>
                        <td class="px-4 py-3 text-sm text-center text-gray-600"><%= l.pourcentage || 100 %>%</td>
                        <td class="px-4 py-3 text-sm text-right font-bold text-gray-900"><%= (l.montant || 0).toLocaleString('fr-FR') %></td>
                    </tr>
                <% }); %>
                <tr class="bg-blue-50 font-bold">
                    <td colspan="5" class="px-6 py-3 text-sm text-right text-blue-800">Sous-total Prestations</td>
                    <td class="px-4 py-3 text-sm text-right text-blue-900"><%= prestations.reduce((a, l) => a + (parseFloat(l.montant) || 0), 0).toLocaleString('fr-FR') %> FCFA</td>
                </tr>
            </tbody>
        </table>
    </div>
    <% } %>

    <% if (ordonnances.length > 0) { %>
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
        <div class="px-6 py-4 border-b bg-emerald-50/50 flex items-center gap-2">
            <i class="fas fa-pills text-emerald-600"></i>
            <h2 class="text-lg font-semibold text-gray-700">Médicaments Délivrés (Ordonnance)</h2>
            <span class="ml-auto text-xs font-bold text-emerald-600 bg-emerald-100 px-2 py-0.5 rounded-full"><%= ordonnances.length %> ligne(s)</span>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Dénomination</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">Quantité</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Coût Unitaire (FCFA)</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Montant (FCFA)</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% ordonnances.forEach((l, idx) => { %>
                    <tr class="<%= idx % 2 === 0 ? '' : 'bg-gray-50/50' %> hover:bg-emerald-50/30 transition">
                        <td class="px-6 py-3 text-sm font-medium text-gray-900"><i class="fas fa-capsules text-emerald-400 mr-1.5"></i><%= l.libelle %></td>
                        <td class="px-4 py-3 text-sm text-center text-gray-700 font-semibold"><%= l.quantite %></td>
                        <td class="px-4 py-3 text-sm text-right text-gray-700"><%= (l.prix_unitaire || 0).toLocaleString('fr-FR') %></td>
                        <td class="px-4 py-3 text-sm text-right font-bold text-gray-900"><%= (l.montant || 0).toLocaleString('fr-FR') %></td>
                    </tr>
                <% }); %>
                <tr class="bg-emerald-50 font-bold">
                    <td colspan="3" class="px-6 py-3 text-sm text-right text-emerald-800">Sous-total Ordonnance</td>
                    <td class="px-4 py-3 text-sm text-right text-emerald-900"><%= ordonnances.reduce((a, l) => a + (parseFloat(l.montant) || 0), 0).toLocaleString('fr-FR') %> FCFA</td>
                </tr>
            </tbody>
        </table>
    </div>
    <% } %>

    <!-- Récapitulatif financier -->
    <% if ((lignes || []).length > 0) { %>
    <div class="bg-white shadow rounded-lg p-6 mb-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="space-y-1 text-sm">
                <div class="flex gap-8">
                    <span class="text-gray-500">Total brut :</span>
                    <span class="font-bold text-gray-900"><%= (facture.total || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <% if (facture.remise > 0) { %>
                <div class="flex gap-8">
                    <span class="text-gray-500">Remise :</span>
                    <span class="font-bold text-amber-700">- <%= (facture.remise || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <% } %>
            </div>
            <div class="text-right">
                <p class="text-xs text-gray-500 uppercase font-bold">Net à payer</p>
                <p class="text-2xl font-black text-blue-700"><%= (facture.total_net || 0).toLocaleString('fr-FR') %> FCFA</p>
                <% if (facture.total_euro) { %>
                    <p class="text-xs text-gray-400">≈ <%= parseFloat(facture.total_euro || 0).toFixed(2) %> €</p>
                <% } %>
                <% if ((facture.montant_paye || 0) > 0) { %>
                    <p class="text-xs mt-1"><span class="text-emerald-600 font-bold">Payé : <%= (facture.montant_paye || 0).toLocaleString('fr-FR') %> FCFA</span> — <span class="text-red-600 font-bold">Reste : <%= (facture.reste_a_payer || 0).toLocaleString('fr-FR') %> FCFA</span></p>
                <% } %>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Paiements -->
    <% if (paiements && paiements.length > 0) { %>
    <div class="bg-white shadow rounded-lg overflow-hidden mb-6">
        <h2 class="text-lg font-semibold text-gray-700 px-6 py-4 border-b">Paiements enregistrés</h2>
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mode</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Référence</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Montant</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Reçu</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% paiements.forEach(p => { %>
                    <tr>
                        <td class="px-6 py-4 text-sm text-gray-600"><%= new Date(p.date_paiement).toLocaleDateString('fr-FR') %></td>
                        <td class="px-6 py-4 text-sm text-gray-600 capitalize"><%= p.mode_paiement %></td>
                        <td class="px-6 py-4 text-sm text-gray-500 font-mono"><%= p.reference || '—' %></td>
                        <td class="px-6 py-4 text-sm font-bold text-emerald-700"><%= (p.montant || 0).toLocaleString('fr-FR') %> FCFA</td>
                        <td class="px-6 py-4 text-sm text-center">
                            <a href="/paiements/<%= p.id %>/print" target="_blank" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded text-xs font-semibold shadow-sm transition" title="Imprimer le reçu client">
                                <i class="fas fa-print text-gray-600"></i>
                                <span>Reçu</span>
                            </a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } %>



    <!-- Modal paiement -->
    <div id="payment-modal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50 px-4">
        <div class="relative top-10 sm:top-20 mx-auto p-4 sm:p-5 border w-full max-w-md shadow-lg rounded-md bg-white">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Nouveau Paiement</h3>
            <form action="/paiements" method="POST" class="space-y-4">
                <input type="hidden" name="facture_id" value="<%= facture.id %>">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Montant (FCFA)</label>
                    <input type="number" name="montant" value="<%= facture.reste_a_payer || 0 %>" max="<%= facture.reste_a_payer || 0 %>" class="mt-1 block w-full border border-gray-300 rounded-md py-2 px-3 text-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Mode de paiement</label>
                    <select name="mode_paiement" class="mt-1 block w-full border border-gray-300 rounded-md py-2 px-3 text-sm">
                        <option value="especes">Espèces</option>
                        <option value="mobile_money">Mobile Money (Wave / Orange / MTN)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Référence (Optionnel)</label>
                    <input type="text" name="reference" class="mt-1 block w-full border border-gray-300 rounded-md py-2 px-3 text-sm">
                </div>
                <div class="flex gap-3 mt-5">
                    <button type="submit" class="flex-1 bg-blue-600 text-white font-medium py-2 px-4 rounded hover:bg-blue-700">Enregistrer</button>
                    <button type="button" onclick="document.getElementById('payment-modal').classList.add('hidden')" class="flex-1 bg-white border border-gray-300 text-gray-700 font-medium py-2 px-4 rounded hover:bg-gray-50">Annuler</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal marquer payée (ADMIN) -->
    <div id="modal-marquer-payee" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50 px-4">
        <div class="relative top-10 sm:top-20 mx-auto p-4 sm:p-5 border w-full max-w-md shadow-lg rounded-md bg-white">
            <div class="flex items-center gap-3 mb-4 text-emerald-700">
                <i class="fas fa-check-double text-2xl"></i>
                <h3 class="text-lg font-bold">Marquer la facture comme Payée (Admin)</h3>
            </div>
            <p class="text-xs text-gray-600 mb-4 bg-emerald-50 p-3 rounded border border-emerald-200">
                Cette action soldera intégralement le montant restant dû de 
                <strong class="text-emerald-800"><%= (facture.reste_a_payer || 0).toLocaleString('fr-FR') %> FCFA</strong>
                et passera le statut de la facture à <strong>PAYÉE</strong>.
            </p>
            <form action="/factures/<%= facture.id %>/marquer-payee?_method=PUT" method="POST" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Mode de paiement appliqué</label>
                    <select name="mode_paiement" class="mt-1 block w-full border border-gray-300 rounded-md py-2 px-3 text-sm">
                        <option value="especes">Espèces</option>
                        <option value="mobile_money">Mobile Money (Wave / Orange / MTN)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Référence / Note justificative</label>
                    <input type="text" name="reference" placeholder="Ex: Régularisation comptable, Reçu N°..." value="Régularisation Direction" class="mt-1 block w-full border border-gray-300 rounded-md py-2 px-3 text-sm">
                </div>
                <div class="flex gap-3 mt-5">
                    <button type="submit" class="flex-1 bg-emerald-700 text-white font-bold py-2 px-4 rounded hover:bg-emerald-800">
                        Confirmer le règlement
                    </button>
                    <button type="button" onclick="document.getElementById('modal-marquer-payee').classList.add('hidden')" class="flex-1 bg-white border border-gray-300 text-gray-700 font-medium py-2 px-4 rounded hover:bg-gray-50">
                        Annuler
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
