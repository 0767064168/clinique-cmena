<div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-gray-800">Factures</h1>
        <a href="/factures/create" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            Nouvelle Facture
        </a>
    </div>

    <!-- Filters -->
    <div class="bg-white p-4 rounded-lg shadow mb-6">
        <form action="/factures" method="GET" class="flex flex-wrap gap-4 items-end">
            <div class="flex-grow max-w-sm">
                <label class="block text-sm text-gray-600 mb-1">Rechercher</label>
                <input type="text" name="search" placeholder="Patient..." class="w-full border rounded-md px-3 py-2" value="<%= filters && filters.search ? filters.search : '' %>">
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">Du</label>
                <input type="date" name="date_from" class="border rounded-md px-3 py-2" value="<%= filters && filters.date_from ? filters.date_from : '' %>">
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">Au</label>
                <input type="date" name="date_to" class="border rounded-md px-3 py-2" value="<%= filters && filters.date_to ? filters.date_to : '' %>">
            </div>
            <div>
                <label class="block text-sm text-gray-600 mb-1">Statut</label>
                <select name="statut" class="border rounded-md px-3 py-2 min-w-[150px]">
                    <option value="">Tous</option>
                    <option value="brouillon" <%= filters && filters.statut === 'brouillon' ? 'selected' : '' %>>Brouillon</option>
                    <option value="validee" <%= filters && filters.statut === 'validee' ? 'selected' : '' %>>Validée</option>
                    <option value="payee" <%= filters && filters.statut === 'payee' ? 'selected' : '' %>>Payée</option>
                    <option value="partiellement_payee" <%= filters && filters.statut === 'partiellement_payee' ? 'selected' : '' %>>Partiellement payée</option>
                    <option value="annulee" <%= filters && filters.statut === 'annulee' ? 'selected' : '' %>>Annulée</option>
                </select>
            </div>
            <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">Filtrer</button>
            <a href="/factures" class="text-sm text-gray-500 hover:underline px-2 py-2">Réinitialiser</a>
        </form>
    </div>

    <!-- Table -->
    <div class="bg-white shadow rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">N° Facture</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total TTC</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% if (typeof factures !== 'undefined' && factures.length > 0) { %>
                    <% factures.forEach(facture => { %>
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= facture.numero_facture || '-' %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(facture.date_facture).toLocaleDateString('fr-FR') %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= facture.patients ? facture.patients.nom + ' ' + facture.patients.prenom : '-' %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-semibold"><%= (facture.total_net || 0).toLocaleString('fr-FR') %> FCFA</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <% 
                                    let badgeClass = '';
                                    let statutText = facture.statut;
                                    switch(facture.statut) {
                                        case 'brouillon': badgeClass = 'bg-gray-100 text-gray-800'; statutText = 'Brouillon'; break;
                                        case 'validee': badgeClass = 'bg-blue-100 text-blue-800'; statutText = 'Validée'; break;
                                        case 'payee': badgeClass = 'bg-green-100 text-green-800'; statutText = 'Payée'; break;
                                        case 'partiellement_payee': badgeClass = 'bg-yellow-100 text-yellow-800'; statutText = 'Part. Payée'; break;
                                        case 'annulee': badgeClass = 'bg-red-100 text-red-800'; statutText = 'Annulée'; break;
                                    }
                                %>
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= badgeClass %>">
                                    <%= statutText %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex gap-2">
                                <a href="/factures/<%= facture.id %>" class="text-blue-600 hover:text-blue-900">Ouvrir</a>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="6" class="px-6 py-4 text-center text-gray-500">Aucune facture trouvée</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
