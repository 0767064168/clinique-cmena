<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">Factures</h1>
        <div class="flex flex-wrap gap-2 w-full sm:w-auto">
            <a id="btnExportPdf" href="/factures/export/pdf" target="_blank" rel="noopener" aria-label="Exporter les factures en PDF (nouvel onglet)"
               class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm">
                <i class="fas fa-file-pdf"></i> Exporter PDF
            </a>
            <a href="/factures/create" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-3 sm:px-4 rounded text-xs sm:text-sm shadow-sm">
                <i class="fas fa-plus"></i> Nouvelle Facture
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white p-3 sm:p-4 rounded-lg shadow mb-6">
        <form action="/factures" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4 items-end">
            <div class="sm:col-span-2 lg:col-span-1">
                <label for="factures-search" class="block text-sm text-gray-600 mb-1">Rechercher</label>
                <input id="factures-search" type="text" name="search" placeholder="Patient..." class="w-full border rounded-md px-3 py-2 text-sm" value="<%= filters && filters.search ? filters.search : '' %>">
            </div>
            <div>
                <label for="factures-date-from" class="block text-sm text-gray-600 mb-1">Du</label>
                <input id="factures-date-from" type="date" name="date_from" class="w-full border rounded-md px-3 py-2 text-sm" value="<%= filters && filters.date_from ? filters.date_from : '' %>">
            </div>
            <div>
                <label for="factures-date-to" class="block text-sm text-gray-600 mb-1">Au</label>
                <input id="factures-date-to" type="date" name="date_to" class="w-full border rounded-md px-3 py-2 text-sm" value="<%= filters && filters.date_to ? filters.date_to : '' %>">
            </div>
            <div>
                <label for="factures-statut" class="block text-sm text-gray-600 mb-1">Statut</label>
                <select id="factures-statut" name="statut" class="w-full border rounded-md px-3 py-2 text-sm">
                    <option value="">Tous</option>
                    <option value="brouillon" <%= filters && filters.statut === 'brouillon' ? 'selected' : '' %>>Brouillon</option>
                    <option value="validee" <%= filters && filters.statut === 'validee' ? 'selected' : '' %>>Validée</option>
                    <option value="payee" <%= filters && filters.statut === 'payee' ? 'selected' : '' %>>Payée</option>
                    <option value="partiellement_payee" <%= filters && filters.statut === 'partiellement_payee' ? 'selected' : '' %>>Partiellement payée</option>
                    <option value="annulee" <%= filters && filters.statut === 'annulee' ? 'selected' : '' %>>Annulée</option>
                </select>
            </div>
            <div class="flex gap-2 items-center sm:col-span-2 lg:col-span-1">
                <button type="submit" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded text-sm">Filtrer</button>
                <a href="/factures" class="text-sm text-gray-500 hover:underline px-2 py-2">Réinitialiser</a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="bg-white shadow rounded-lg overflow-x-auto" role="region" aria-label="Liste des factures" tabindex="0">
        <p class="md:hidden px-4 py-2 text-xs text-gray-500" aria-hidden="true">Faites défiler horizontalement pour voir toutes les colonnes.</p>
        <table class="min-w-full divide-y divide-gray-200">
            <caption class="sr-only">Liste des factures</caption>
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">N° Facture</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Patient</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total TTC</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Statut</th>
                    <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% if (typeof factures !== 'undefined' && factures.length > 0) { %>
                    <% factures.forEach(facture => { %>
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= facture.numero_facture || '-' %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(facture.date_facture).toLocaleDateString('fr-FR') %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= facture.patients ? facture.patients.nom + ' ' + facture.patients.prenom : '-' %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-semibold"><%= (facture.total_net || 0).toLocaleString('fr-FR') %> FCFA</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <% 
                                    let badgeClass = '';
                                    let statutText = facture.statut;
                                    switch(facture.statut) {
                                        case 'brouillon': badgeClass = 'bg-gray-100 text-gray-800'; statutText = 'Brouillon'; break;
                                        case 'validee': badgeClass = 'bg-blue-100 text-blue-800'; statutText = 'Validée'; break;
                                        case 'payee': badgeClass = 'bg-green-100 text-green-800'; statutText = 'Payée'; break;
                                        case 'partiellement_payee': badgeClass = 'bg-yellow-100 text-yellow-800'; statutText = 'Part. Payée'; break;
                                        case 'annulee': badgeClass = 'bg-red-100 text-red-800'; statutText = 'Annulée'; break;
                                    }
                                %>
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= badgeClass %>">
                                    <%= statutText %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <a href="/factures/<%= facture.id %>" class="text-blue-600 hover:text-blue-900 mr-3 inline-flex min-h-[44px] items-center gap-1 font-semibold">
                                    <i class="fas fa-eye text-xs"></i> Voir
                                </a>
                                <% if (facture.statut === 'brouillon') { %>
                                    <a href="/factures/<%= facture.id %>/edit" class="text-indigo-600 hover:text-indigo-900 mr-3 inline-flex min-h-[44px] items-center gap-1 font-semibold">
                                        <i class="fas fa-edit text-xs"></i> Modifier
                                    </a>
                                <% } %>
                                <% if (facture.statut !== 'annulee') { %>
                                    <form action="/factures/<%= facture.id %>?_method=DELETE" method="POST" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette facture ? Elle sera annulée.');">
                                        <button type="submit" class="text-red-600 hover:text-red-900 inline-flex min-h-[44px] items-center gap-1 font-semibold">
                                            <i class="fas fa-trash-alt text-xs"></i> Supprimer
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr><td colspan="6" class="px-6 py-4 text-center text-gray-500">Aucune facture trouvée</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
// Met à jour le lien d'export PDF avec les filtres actifs du formulaire
(function() {
    const btn = document.getElementById('btnExportPdf');
    if (!btn) return;
    // Récupérer les filtres actuels depuis l'URL courante
    const params = new URLSearchParams(window.location.search);
    if (params.toString()) {
        btn.href = '/factures/export/pdf?' + params.toString();
    }
    // Mettre à jour en temps réel lors d'une soumission du formulaire de filtre
    const form = document.querySelector('form[action="/factures"]');
    if (form) {
        form.addEventListener('submit', function() {
            const fd = new FormData(form);
            const p = new URLSearchParams();
            for (const [k, v] of fd.entries()) { if (v) p.set(k, v); }
            btn.href = '/factures/export/pdf?' + p.toString();
        });
    }
})();
</script>
