<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSA 3e COMPAGNIE GSPM BOUAKE - Facture N°<%= facture.numero_facture %></title>
    <link rel="stylesheet" href="/css/tailwind.min.css">
    <style>
        body { font-family: 'Arial', sans-serif; font-size: 12px; }
        .invoice-box { max-width: 820px; margin: auto; padding: 25px 35px; background: white; }
        .table-borders th, .table-borders td { border: 1px solid #000; padding: 4px 8px; }
        .devise-text { font-family: 'Times New Roman', serif; letter-spacing: 0.15em; font-style: italic; }
        @media print {
            body { background: white; padding: 0; }
            .invoice-box { padding: 15px 20px; box-shadow: none; max-width: 100%; width: 100%; }
            .no-print { display: none !important; }
            .table-borders th { background-color: #f3f4f6 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .flag-band div { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        }
    </style>
</head>
<body class="bg-gray-100 py-6">
    
    <div class="text-center mb-4 no-print">
        <button onclick="window.print()" class="bg-red-600 hover:bg-red-700 text-white px-5 py-2.5 rounded shadow font-bold text-sm inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Imprimer la facture
        </button>
    </div>

    <div class="invoice-box shadow-lg">
        <!-- En-tête Officiel GSPM / Ministère de la Défense -->
        <div class="mb-3">
            <div class="flex justify-between items-start">
                <!-- Colonne Gauche : GSPM -->
                <div class="text-center w-5/12">
                    <p class="font-bold text-[11px] uppercase tracking-tight text-gray-900 leading-snug">
                        GROUPEMENT DE SAPEURS POMPIERS MILITAIRES
                    </p>
                    <div class="my-1.5 flex justify-center">
                        <img src="/images/logo_gspm.jpg" alt="Logo GSPM" class="h-16 w-auto object-contain">
                    </div>
                    <p class="font-bold text-[11px] uppercase tracking-tight text-gray-900 leading-snug">
                        CSA 3<sup>e</sup> COMPAGNIE GSPM BOUAKE
                    </p>
                </div>

                <!-- Colonne Droite : République de Côte d'Ivoire / Ministère de la Défense -->
                <div class="text-center w-5/12">
                    <p class="font-bold text-[11px] uppercase tracking-tight text-gray-900 leading-snug">
                        REPUBLIQUE DE COTE D'IVOIRE
                    </p>
                    <div class="my-1.5 flex justify-center">
                        <img src="/images/logo_defense.jpg" alt="Ministère de la Défense" class="h-16 w-auto object-contain">
                    </div>
                    <p class="font-bold text-[11px] uppercase tracking-tight text-gray-900 leading-snug">
                        MINISTERE DE LA DEFENSE
                    </p>
                </div>
            </div>

            <!-- Bandeau tricolore (Drapeau Côte d'Ivoire: Orange, Blanc, Vert) -->
            <div class="mt-3 mb-2" style="border-top: 1.5px solid #000; border-bottom: 1.5px solid #000; padding: 1.5px 0;">
                <div class="flag-band" style="display: flex; height: 5px; width: 100%;">
                    <div style="flex: 1; background-color: #f77f00;"></div>
                    <div style="flex: 1; background-color: #ffffff;"></div>
                    <div style="flex: 1; background-color: #009e49;"></div>
                </div>
            </div>

            <div class="flex justify-between items-center text-[10px] text-gray-500 mb-1">
                <span>Bouaké, Côte d'Ivoire</span>
                <span>
                    Édité le : <%= new Date(facture.date_facture || new Date()).toLocaleDateString('fr-FR') %> à <%= new Date(facture.date_facture || new Date()).toLocaleTimeString('fr-FR', {hour: '2-digit', minute:'2-digit'}) %>
                    <% if (typeof editeur !== 'undefined' && editeur) { %>
                        — Par : <strong class="text-gray-700"><%= editeur.nom %> <%= editeur.prenom %></strong>
                    <% } else if (typeof user !== 'undefined' && user) { %>
                        — Par : <strong class="text-gray-700"><%= user.nom || '' %> <%= user.prenom || '' %></strong>
                    <% } %>
                </span>
            </div>
        </div>

        <div class="text-center font-bold text-lg uppercase mb-5 underline tracking-wide">
            Facture client
        </div>

        <!-- Informations Patient et Praticien traitant -->
        <div class="mb-4 text-xs grid grid-cols-2 gap-3">
            <div class="bg-gray-50 p-2.5 rounded border border-gray-300 font-medium space-y-1">
                <p class="text-[11px] font-bold text-gray-700 uppercase tracking-wider border-b border-gray-200 pb-1 mb-1">Patient</p>
                <p><span class="text-gray-500">Nom & Prénom :</span> <strong class="text-gray-900 text-sm"><%= facture.patients ? facture.patients.nom + ' ' + facture.patients.prenom : '-' %></strong></p>
                <p><span class="text-gray-500">N° Dossier :</span> <strong class="text-gray-900"><%= facture.patients ? facture.patients.numero_dossier : '-' %></strong></p>
                <p><span class="text-gray-500">Téléphone :</span> <strong class="text-gray-900"><%= facture.patients ? (facture.patients.telephone || '-') : '-' %></strong></p>
            </div>
            <div class="bg-gray-50 p-2.5 rounded border border-gray-300 font-medium space-y-1">
                <p class="text-[11px] font-bold text-gray-700 uppercase tracking-wider border-b border-gray-200 pb-1 mb-1">Praticien traitant</p>
                <% 
                    const praticienObj = (facture.consultations && facture.consultations.praticiens) ? facture.consultations.praticiens : null;
                    const nomPrat = praticienObj ? (praticienObj.nom + ' ' + praticienObj.prenom) : (facture.praticien || (facture.consultations ? '-' : '-'));
                    const matriculePrat = praticienObj ? (praticienObj.matricule || '-') : '-';
                    const specialitePrat = praticienObj ? (praticienObj.specialite || '') : '';
                %>
                <p><span class="text-gray-500">Médecin / Praticien :</span> <strong class="text-gray-900 text-sm"><%= nomPrat %></strong></p>
                <p><span class="text-gray-500">Matricule :</span> <strong class="text-gray-900"><%= matriculePrat %></strong></p>
                <% if (specialitePrat) { %>
                    <p><span class="text-gray-500">Spécialité :</span> <span class="text-gray-800"><%= specialitePrat %></span></p>
                <% } %>
            </div>
        </div>

        <!-- Meta Box -->
        <div class="border border-black flex mb-4 text-xs">
            <div class="w-1/3 border-r border-black p-2 space-y-1">
                <p><span class="font-bold">Assurance :</span> <%= facture.type_assurance || 'PARTICULIER' %></p>
                <p><span class="font-bold">Assureur :</span> <%= facture.assureur || '-' %></p>
                <p><span class="font-bold">Souscripteur :</span> <%= facture.souscripteur || '-' %></p>
            </div>
            <div class="w-1/3 border-r border-black p-2 space-y-1 text-center">
                <p><span class="font-bold">N° facture :</span> <%= facture.numero_facture %></p>
                <p><span class="font-bold">Statut :</span> <span class="uppercase font-semibold"><%= facture.statut %></span></p>
                <p><span class="font-bold">Date accueil :</span> <%= new Date(facture.date_facture).toLocaleDateString('fr-FR') %></p>
                <p><span class="font-bold">Éditeur :</span> <%= (typeof editeur !== 'undefined' && editeur) ? (editeur.nom + ' ' + editeur.prenom) : ((typeof user !== 'undefined' && user) ? (user.nom || user.email) : 'Système') %></p>
            </div>
            <div class="w-1/3 p-2 space-y-1 text-right">
                <p><span class="font-bold">Date entrée :</span> <%= (facture.consultations && facture.consultations.date_entree) ? new Date(facture.consultations.date_entree).toLocaleDateString('fr-FR') : (facture.date_entree ? new Date(facture.date_entree).toLocaleDateString('fr-FR') : '-') %></p>
                <p><span class="font-bold">Date sortie :</span> <%= (facture.consultations && facture.consultations.date_sortie) ? new Date(facture.consultations.date_sortie).toLocaleDateString('fr-FR') : (facture.date_sortie ? new Date(facture.date_sortie).toLocaleDateString('fr-FR') : '-') %></p>
                <p><span class="font-bold">Motif :</span> <%= (facture.consultations && facture.consultations.motif) ? facture.consultations.motif : (facture.motif || '-') %></p>
            </div>
        </div>

        <!-- Table des prestations -->
        <table class="w-full text-xs table-borders mb-2" style="border-collapse: collapse;">
            <thead class="bg-gray-100 font-bold">
                <tr>
                    <th class="text-left">Libellé</th>
                    <th class="text-left">Praticien</th>
                    <th class="text-right">PU (FCFA)</th>
                    <th class="text-right">Qté</th>
                    <th class="text-right">%</th>
                    <th class="text-right">Montant</th>
                    <th class="text-right">Part Assureur</th>
                    <th class="text-right">Part Assuré</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof lignes !== 'undefined' && lignes.length > 0) { %>
                    <% lignes.forEach(ligne => { %>
                        <tr>
                            <td><%= ligne.libelle %></td>
                            <td><%= ligne.nom_praticien || '-' %></td>
                            <td class="text-right"><%= (ligne.prix_unitaire || 0).toLocaleString('fr-FR') %></td>
                            <td class="text-right"><%= ligne.quantite %></td>
                            <td class="text-right"><%= ligne.pourcentage %>%</td>
                            <td class="text-right"><%= (ligne.montant || 0).toLocaleString('fr-FR') %></td>
                            <td class="text-right"><%= (ligne.part_assureur || 0).toLocaleString('fr-FR') %></td>
                            <td class="text-right"><%= (ligne.part_assure || 0).toLocaleString('fr-FR') %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="8" class="text-center py-2 text-gray-500">Aucune prestation détaillée enregistrée</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        
        <div class="text-xs mb-4 text-gray-600">
            Nombre de prestation(s) : <%= typeof lignes !== 'undefined' ? lignes.length : 0 %>
        </div>

        <!-- Totaux -->
        <div class="flex justify-end mb-6 text-sm">
            <div class="w-1/2">
                <div class="flex justify-between font-bold">
                    <span>Total brut :</span>
                    <span><%= (facture.total || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <div class="flex justify-between text-gray-700">
                    <span>Remise accordée :</span>
                    <span><%= (facture.remise || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
                <div class="flex justify-between font-bold border-t border-black pt-1 mt-1 text-base">
                    <span>Total Net :</span>
                    <span><%= (facture.total_net || 0).toLocaleString('fr-FR') %> FCFA</span>
                </div>
            </div>
        </div>

        <div class="text-xs space-y-1.5 mb-6 font-semibold bg-gray-50 p-3 rounded border border-gray-200">
            <p class="flex justify-between">
                <span>Règlement effectué par le patient :</span>
                <span class="text-green-700"><%= ((facture.total_net || 0) - (facture.reste_a_payer || 0)).toLocaleString('fr-FR') %> FCFA</span>
            </p>
            <p class="flex justify-between">
                <span>Reste à régler par le patient :</span>
                <span class="<%= (facture.reste_a_payer || 0) > 0 ? 'text-red-700' : 'text-gray-700' %>"><%= (facture.reste_a_payer || 0).toLocaleString('fr-FR') %> FCFA</span>
            </p>
        </div>

        <div class="text-xs font-bold text-center mb-8 uppercase italic border-y border-gray-300 py-2">
            <% const montantEnLettres = typeof numberToFrenchWords === 'function' ? numberToFrenchWords(facture.total_net || 0) : '' %>
            Arrêté la présente facture à la somme de : <%= montantEnLettres ? (montantEnLettres + ' FRANCS CFA (' + (facture.total_net || 0).toLocaleString('fr-FR') + ' FCFA)') : ((facture.total_net || 0).toLocaleString('fr-FR') + ' FRANCS CFA') %>
        </div>

        <!-- Signatures -->
        <div class="flex justify-between text-xs font-bold px-8 mb-8">
            <div class="text-center">
                <p class="underline mb-12">Visa Client / Patient</p>
            </div>
            <div class="text-center">
                <p class="underline mb-12">Le Responsable CSA / Facturation</p>
            </div>
        </div>

        <!-- Devise officielle GSPM en bas de page -->
        <div class="text-center devise-text text-xs text-gray-700 border-t border-gray-200 pt-3">
            SAUVER OU PERIR
        </div>
    </div>

    <script>
        window.onload = function() {
            // Prêt pour impression directe
        }
    </script>
</body>
</html>
