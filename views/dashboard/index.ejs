<div class="space-y-6">
  <!-- Titre et sous-titre -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-slate-200">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Tableau de Bord</h1>
      <p class="text-sm text-slate-500">Bienvenue sur le portail de gestion de la Clinique Médico-Chirurgicale NANAN</p>
    </div>
    <div class="mt-4 sm:mt-0 flex space-x-3">
      <a href="/patients/nouveau" class="inline-flex items-center px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 transition">
        <i class="fa-solid fa-user-plus mr-2"></i> Nouveau Patient
      </a>
      <a href="/consultations/nouveau" class="inline-flex items-center px-4 py-2 border border-slate-300 rounded-lg shadow-sm text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition">
        <i class="fa-solid fa-stethoscope mr-2 text-emerald-600"></i> Consultation
      </a>
    </div>
  </div>

  <!-- Cartes statistiques -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Stat 1: Total Patients -->
    <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-100 p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-emerald-100 rounded-lg p-3 text-emerald-600">
          <i class="fa-solid fa-users text-xl"></i>
        </div>
        <div class="ml-4 w-0 flex-1">
          <dl>
            <dt class="text-xs font-medium text-slate-500 uppercase tracking-wider">Patients Enregistrés</dt>
            <dd class="text-2xl font-bold text-slate-800"><%= stats.patientsTotal %></dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Stat 2: Consultations du jour -->
    <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-100 p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3 text-blue-600">
          <i class="fa-solid fa-calendar-check text-xl"></i>
        </div>
        <div class="ml-4 w-0 flex-1">
          <dl>
            <dt class="text-xs font-medium text-slate-500 uppercase tracking-wider">Consultations Aujourd'hui</dt>
            <dd class="text-2xl font-bold text-slate-800"><%= stats.consultationsJour %></dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Stat 3: Factures en attente -->
    <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-100 p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-amber-100 rounded-lg p-3 text-amber-600">
          <i class="fa-solid fa-file-invoice text-xl"></i>
        </div>
        <div class="ml-4 w-0 flex-1">
          <dl>
            <dt class="text-xs font-medium text-slate-500 uppercase tracking-wider">Factures en Attente</dt>
            <dd class="text-2xl font-bold text-slate-800"><%= stats.facturesAttente %></dd>
          </dl>
        </div>
      </div>
    </div>

    <!-- Stat 4: Recettes du jour -->
    <div class="bg-white overflow-hidden shadow-sm rounded-xl border border-slate-100 p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-violet-100 rounded-lg p-3 text-violet-600">
          <i class="fa-solid fa-coins text-xl"></i>
        </div>
        <div class="ml-4 w-0 flex-1">
          <dl>
            <dt class="text-xs font-medium text-slate-500 uppercase tracking-wider">Recettes du Jour</dt>
            <dd class="text-2xl font-bold text-slate-800"><%= formatMoney(stats.recettesJour) %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>
