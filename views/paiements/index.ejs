<div class="container mx-auto px-2 sm:px-4 py-4 sm:py-8">
    <!-- En-tête -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-gray-900 tracking-tight">Historique des Paiements</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-800">
                    <%= typeof totalCount !== 'undefined' ? totalCount : 0 %>
                </span>
            </div>
            <p class="text-xs sm:text-sm text-gray-500 mt-0.5">Journal des règlements et encaissements enregistrés</p>
        </div>
        <a href="/factures" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 px-4 rounded-lg text-sm transition">
            <i class="fas fa-file-invoice text-xs"></i>
            <span>Consulter les Factures</span>
        </a>
    </div>

    <!-- Barre de recherche et filtre rapide -->
    <form action="/paiements" method="GET" class="bg-white p-3 sm:p-4 rounded-xl shadow-sm mb-6 border border-gray-100">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-6 gap-3">
            <div class="relative flex-grow">
                <label for="searchPaiements" class="block text-sm text-gray-600 mb-1">Référence</label>
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                    <i class="fas fa-search text-xs" aria-hidden="true"></i>
                </span>
                <input 
                    type="text" 
                    id="searchPaiements" 
                    name="reference"
                    value="<%= filters.reference || '' %>"
                    placeholder="Référence de transaction..."
                    class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500">
            </div>
            <div>
                <label for="filterMode" class="block text-sm text-gray-600 mb-1">Mode de paiement</label>
                <select 
                    id="filterMode" 
                    name="mode"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500">
                    <option value="">Tous les modes</option>
                    <option value="especes" <%= filters.mode === 'especes' ? 'selected' : '' %>>Espèces</option>
                    <option value="mobile_money" <%= filters.mode === 'mobile_money' ? 'selected' : '' %>>Mobile Money</option>
                    <option value="carte" <%= filters.mode === 'carte' ? 'selected' : '' %>>Carte Bancaire</option>
                    <option value="virement" <%= filters.mode === 'virement' ? 'selected' : '' %>>Virement</option>
                    <option value="cheque" <%= filters.mode === 'cheque' ? 'selected' : '' %>>Chèque</option>
                </select>
            </div>
            <div>
                <label for="paiements-patient" class="block text-sm text-gray-600 mb-1">Patient</label>
                <input id="paiements-patient" type="search" name="patient" value="<%= filters.patient || '' %>"
                    placeholder="Nom ou prénom..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div>
                <label for="paiements-invoice-number" class="block text-sm text-gray-600 mb-1">N° facture</label>
                <input id="paiements-invoice-number" type="number" min="1" name="invoice_number" value="<%= filters.invoice_number || '' %>"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div>
                <label for="paiements-date-from" class="block text-sm text-gray-600 mb-1">Du</label>
                <input id="paiements-date-from" type="date" name="date_from" value="<%= filters.date_from || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div>
                <label for="paiements-date-to" class="block text-sm text-gray-600 mb-1">Au</label>
                <input id="paiements-date-to" type="date" name="date_to" value="<%= filters.date_to || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            </div>
            <div class="flex items-end gap-2 sm:col-span-2 xl:col-span-6">
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg text-sm">Filtrer</button>
                <a href="/paiements" class="text-sm text-gray-500 hover:underline px-2 py-2">Réinitialiser</a>
            </div>
        </div>
    </form>

    <% 
    const getModeBadge = (mode) => {
        const m = String(mode || '').toLowerCase();
        if (m.includes('espece')) return 'bg-emerald-100 text-emerald-800 border-emerald-200';
        if (m.includes('mobile')) return 'bg-blue-100 text-blue-800 border-blue-200';
        if (m.includes('carte')) return 'bg-indigo-100 text-indigo-800 border-indigo-200';
        if (m.includes('virement')) return 'bg-purple-100 text-purple-800 border-purple-200';
        if (m.includes('cheque')) return 'bg-amber-100 text-amber-800 border-amber-200';
        return 'bg-gray-100 text-gray-700 border-gray-200';
    };
    %>

    <!-- Vue Mobile (Cartes adaptées smartphones) -->
    <div class="block md:hidden space-y-3" id="paiementsMobileList">
        <% if (typeof paiements !== 'undefined' && paiements.length > 0) { %>
            <% paiements.forEach(paiement => { %>
                <div class="paiement-card bg-white rounded-xl p-4 shadow-sm border border-gray-100 space-y-2.5">
                    
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <span class="text-xs text-gray-500 font-medium block">
                                <i class="far fa-clock mr-1 text-gray-400"></i>
                                <%= new Date(paiement.created_at || paiement.date_paiement).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </span>
                            <h3 class="text-base font-bold text-gray-900 mt-0.5"><%= paiement.patient_nom %></h3>
                        </div>
                        <span class="inline-block text-[11px] font-semibold px-2 py-0.5 rounded border capitalize <%= getModeBadge(paiement.mode_paiement) %>">
                            <%= paiement.mode_paiement %>
                        </span>
                    </div>

                    <div class="flex items-center justify-between text-xs text-gray-600 bg-gray-50 px-3 py-2 rounded-lg">
                        <div>
                            <span class="text-gray-400 block text-[10px] uppercase font-bold">Facture liée</span>
                            <a href="/factures/<%= paiement.facture_id %>" class="font-bold text-blue-600 hover:underline">
                                N° <%= paiement.facture_numero %>
                            </a>
                        </div>
                        <% if (paiement.reference) { %>
                            <div class="text-right">
                                <span class="text-gray-400 block text-[10px] uppercase font-bold">Réf. transaction</span>
                                <span class="font-mono text-gray-700"><%= paiement.reference %></span>
                            </div>
                        <% } %>
                    </div>

                    <div class="flex items-center justify-between pt-1 border-t border-gray-100">
                        <div>
                            <span class="text-[10px] text-gray-400 block uppercase font-bold">Montant encaissé</span>
                            <span class="text-base font-extrabold text-green-700">
                                <%= Number(paiement.montant || 0).toLocaleString('fr-FR') %> <span class="text-xs font-semibold text-gray-500">FCFA</span>
                            </span>
                        </div>
                        <a href="/paiements/<%= paiement.id %>/print" target="_blank" rel="noopener" aria-label="Imprimer le reçu de <%= paiement.patient_nom %> (nouvel onglet)" class="inline-flex min-h-[44px] items-center gap-1.5 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg text-xs font-bold shadow-sm transition">
                            <i class="fas fa-print text-gray-600"></i>
                            <span>Reçu</span>
                        </a>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="bg-white p-6 rounded-xl text-center text-gray-500 shadow-sm border border-gray-100">
                <i class="fas fa-receipt text-2xl text-gray-300 mb-2 block"></i>
                Aucun paiement enregistré
            </div>
        <% } %>
    </div>

    <!-- Vue Desktop / Tablette (Tableau avec overflow horizontal) -->
    <div class="hidden md:block bg-white shadow-sm rounded-xl border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto" role="region" aria-label="Historique des paiements" tabindex="0">
            <table class="min-w-full divide-y divide-gray-200" id="paiementsTable">
                <caption class="sr-only">Historique des paiements enregistrés</caption>
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Date</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">N° Facture</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Patient</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Mode</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Référence</th>
                        <th scope="col" class="px-6 py-3.5 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Montant</th>
                        <th scope="col" class="px-6 py-3.5 text-center text-xs font-bold text-gray-500 uppercase tracking-wider">Action</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <% if (typeof paiements !== 'undefined' && paiements.length > 0) { %>
                        <% paiements.forEach(paiement => { %>
                            <tr class="paiement-row hover:bg-slate-50 transition">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= new Date(paiement.created_at || paiement.date_paiement).toLocaleString('fr-FR') %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-blue-600">
                                    <a href="/factures/<%= paiement.facture_id %>" class="hover:underline">
                                        N° <%= paiement.facture_numero %>
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    <%= paiement.patient_nom %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold border capitalize <%= getModeBadge(paiement.mode_paiement) %>">
                                        <%= paiement.mode_paiement %>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">
                                    <%= paiement.reference || '-' %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-green-700 text-right">
                                    <%= Number(paiement.montant || 0).toLocaleString('fr-FR') %> FCFA
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                    <a href="/paiements/<%= paiement.id %>/print" target="_blank" rel="noopener" aria-label="Imprimer le reçu de <%= paiement.patient_nom %> (nouvel onglet)" class="inline-flex min-h-[44px] items-center gap-1.5 px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded text-xs font-semibold shadow-sm transition" title="Imprimer le Reçu Patient">
                                        <i class="fas fa-print text-gray-600" aria-hidden="true"></i>
                                        <span>Reçu</span>
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                                <i class="fas fa-receipt text-3xl text-gray-300 mb-2 block"></i>
                                Aucun paiement trouvé
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <%- include('../partials/pagination', { currentPage, totalPages, totalCount, pageSize, baseUrl, paginationFilters }) %>
</div>
