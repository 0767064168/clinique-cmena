{
  "name": "clinique-cmena",
  "version": "1.0.0",
  "description": "Application de gestion pour la Clinique Médico-Chirurgicale NANAN (CMENA)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.min.css --watch"
  },
  "keywords": [
    "clinique",
    "gestion-medicale",
    "sante",
    "côte-d-ivoire",
    "cmena"
  ],
  "author": "Clinique CMENA",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
